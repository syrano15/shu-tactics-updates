.spirit-presentation{--spirit-color:#ff9a66;position:absolute;z-index:70;left:50%;top:14px;transform:translateX(-50%);display:flex;gap:12px;align-items:center;width:min(470px,calc(100% - 20px));padding:11px 16px;box-sizing:border-box;background:linear-gradient(105deg,#0c1b20f7,#152a32f2);border:2px solid var(--spirit-color);border-radius:8px;box-shadow:0 0 22px color-mix(in srgb,var(--spirit-color) 65%,transparent);color:#fff;pointer-events:none;animation:spirit-presentation-enter .25s ease-out both}
.spirit-presentation.is-strategy,.spirit-presentation-ring.is-strategy{--spirit-color:#cfb0ff}.spirit-presentation.is-guard,.spirit-presentation-ring.is-guard{--spirit-color:#9fceff}.spirit-presentation.is-support,.spirit-presentation-ring.is-support{--spirit-color:#85efd0}.spirit-presentation.is-pressure,.spirit-presentation-ring.is-pressure{--spirit-color:#ff7380}
.spirit-presentation-content{display:flex;flex-direction:column;min-width:0;gap:2px}.spirit-presentation-caster{font-size:12px;color:#e2e5dc}.spirit-presentation-name{color:var(--spirit-color);font-size:32px;font-weight:950;line-height:1.12;text-shadow:0 0 12px color-mix(in srgb,var(--spirit-color) 50%,transparent)}.spirit-presentation-sp{font-size:14px;font-weight:800;font-variant-numeric:tabular-nums;color:#ffdf91}.spirit-presentation-detail{font-size:12px;line-height:1.45;color:#e4ece8}.spirit-presentation-targets{font-size:11px;color:#c5dacd;line-height:1.35}
.spirit-presentation-portrait{position:relative;display:block;flex:0 0 88px;width:88px;height:104px;overflow:hidden;border-bottom:1px solid var(--spirit-color);background:radial-gradient(ellipse,#ffffff17,transparent 65%)}.spirit-presentation-portrait img{position:absolute;width:100%;height:100%;object-fit:contain;left:0;top:0}
.spirit-presentation-ring{--spirit-color:#ff9a66;position:absolute;z-index:65;pointer-events:none;box-sizing:border-box;border:3px solid var(--spirit-color);border-radius:50%;box-shadow:0 0 16px var(--spirit-color),inset 0 0 12px var(--spirit-color);transform:translate(-50%,-50%);animation:spirit-target-pulse .6s ease-out both}.spirit-target-detail{position:absolute;bottom:-24px;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:12px;font-weight:800;color:var(--spirit-color);text-shadow:0 1px 2px #000,0 0 5px #000;background:#071911dd;padding:2px 6px;border-radius:4px;max-width:220px;overflow:hidden;text-overflow:ellipsis}
@keyframes spirit-presentation-enter{from{opacity:0;transform:translate(-50%,8px) scale(.95)}to{opacity:1;transform:translate(-50%,0) scale(1)}}
@keyframes spirit-target-pulse{0%{opacity:0;transform:translate(-50%,-50%) scale(.6)}25%,65%{opacity:1;transform:translate(-50%,-50%) scale(1.08)}100%{opacity:.65;transform:translate(-50%,-50%) scale(1)}}
.spirit-presentation.is-reduced-motion,.spirit-presentation-ring.is-reduced-motion{animation:none}
@media(max-width:640px){.spirit-presentation{top:6px;padding:8px;gap:7px}.spirit-presentation-portrait{flex-basis:62px;width:62px;height:87px}.spirit-presentation-name{font-size:26px}.spirit-presentation-detail{font-size:11px}.spirit-presentation-sp{font-size:12px}.spirit-target-detail{font-size:11px;max-width:150px}}
@media(prefers-reduced-motion:reduce){.spirit-presentation,.spirit-presentation-ring{animation:none}}
.spirit-presentation.is-mobile-presentation{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:min(420px,calc(100vw - 24px));max-height:calc(100dvh - 24px);overflow:hidden;z-index:1000;animation:none}
