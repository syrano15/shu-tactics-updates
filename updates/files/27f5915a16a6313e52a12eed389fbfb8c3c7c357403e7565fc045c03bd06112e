.story-cg{display:block;position:relative;width:100%;height:auto;aspect-ratio:16/9;object-fit:contain;object-position:center top;z-index:0}.has-story-cg .portrait-stage{display:none}.dialogue-box,.scene-top,.story-event .event-text,.story-event .event-speaker,.story-event .dialog-actions{position:relative;z-index:2}.story-cutin{position:relative;isolation:isolate;width:100%;height:clamp(130px,22vh,190px);margin:0 auto 14px;background-size:contain;background-position:center;background-repeat:no-repeat;pointer-events:none;z-index:1;animation:cutin-appear .35s ease-out}.story-cutin-strip{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;z-index:0}.story-cutin-portrait{position:absolute;inset:0 auto 0 8%;width:auto;max-width:84%;height:100%;object-fit:contain;object-position:center top;z-index:1}.enemy-cutin .story-cutin-portrait{left:auto;right:8%}.story-fx{position:absolute;inset:5%;width:90%;height:80%;object-fit:contain;pointer-events:none;z-index:3;animation:cutin-appear .35s ease-out}.story-event{position:fixed;overflow:hidden}.chapter-card{text-align:center;max-width:min(640px,90vw);padding:36px;background:#13251f;color:#f2e8d1;border:1px solid #b2935c}.chapter-card h2{font-size:clamp(25px,5vw,40px)}.chapter-map{max-height:260px;max-width:100%;object-fit:contain}.catalog-dialog{max-width:min(740px,92vw);max-height:85vh;overflow:auto;background:#14271f;color:#eadfc9;padding:25px}.catalog-dialog article{border-bottom:1px solid #6f6249;padding:10px 0}.critical-note,.critical-label{color:#ffe09b;font-weight:700}.critical-combat{border-color:#edc76e;box-shadow:0 0 35px #caa03555}.enemy-critical .critical-label{color:#ff9a85}.critical-label{display:block;text-align:center;font-size:28px}.critical-shake{animation:critical-shake .2s linear}.promotion-card,.sales-panel,.reward-card{background:#12271f;border:1px solid #5c6044;padding:18px;margin:16px 0;border-radius:10px}.sales-panel button{margin:5px}.loot-note{font-size:12px;color:#dcca99}.comparison-info{margin:20px auto;font-size:13px;line-height:1.7;text-align:center}.comparison-info a{color:#e4c57c}.promotion-stars{color:#ebc56b;font-size:10px}.locked-spirit{opacity:.7}@keyframes critical-shake{25%,75%{transform:translateX(-3px)}50%{transform:translateX(3px)}}@keyframes cutin-appear{from{opacity:0;transform:translateX(-20px)}to{opacity:1;transform:translateX(0)}}@media(prefers-reduced-motion:reduce){.story-cutin,.critical-shake{animation:none}}

.enemy-cutin{animation-name:enemy-cutin-appear;transform-origin:right center}@keyframes enemy-cutin-appear{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}


@media(max-width:620px){.story-cg{object-fit:contain;object-position:center top}.story-event{padding:18px;max-height:90dvh;overflow:auto}.story-cutin{height:140px}.character-portrait img{object-fit:contain;object-position:center top}}


.dialogue-scene,.story-event{background-size:cover;background-position:center;background-repeat:no-repeat}

.dialogue-scene .story-cg{height:clamp(180px,34dvh,400px);aspect-ratio:auto;background:#0a1713cc}.story-event .story-cg{max-height:36dvh} @media(max-width:620px){.dialogue-scene .story-cg{height:auto;aspect-ratio:16/9;max-height:36dvh}}

.native-map-fx{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:6}.native-map-fx span{position:absolute;display:block}.fx_ship_fire{background:radial-gradient(ellipse at bottom,#ffa63d77,transparent 70%);animation:act3-flash .9s ease-out}.fx_ship_fire span{left:calc(var(--i)*8%);bottom:-10%;width:13%;height:55%;background:linear-gradient(0deg,#ff4839,#ffdf77 60%,transparent);border-radius:70% 50% 0 0;transform-origin:bottom;animation:act3-flame .9s ease-out both;animation-delay:calc(var(--i)*-35ms)}.fx_gate_open span{top:15%;bottom:15%;width:40%;background:linear-gradient(90deg,#312918,#99783c);border:3px solid #e5c77e;box-shadow:0 0 25px #f5d78388}.fx_gate_open span:first-child{left:10%;animation:act3-gate-left .9s ease-out both}.fx_gate_open span:last-child{right:10%;animation:act3-gate-right .9s ease-out both}.fx_arrow_rain span{left:calc(var(--i)*7%);top:-25%;height:35%;width:3px;background:linear-gradient(#d8bb7a,#fff1c8);transform:rotate(-25deg);animation:act3-arrow .8s linear both;animation-delay:calc(var(--i)*12ms)}@keyframes act3-flash{0%{opacity:0}20%{opacity:1}100%{opacity:0}}@keyframes act3-flame{0%{transform:scaleY(.3);opacity:0}25%{opacity:1}100%{transform:translateY(-70%) scaleY(1.5);opacity:0}}@keyframes act3-gate-left{100%{transform:translateX(-100%);opacity:0}}@keyframes act3-gate-right{100%{transform:translateX(100%);opacity:0}}@keyframes act3-arrow{100%{top:110%;opacity:0}}@media(prefers-reduced-motion:reduce){.native-map-fx,.native-map-fx span{animation:none;opacity:.75}}

/* Each enemy tile catches the fire front; this replaces flat flame pills. */
.fx_ship_fire .ship-fire-front{bottom:auto;background:url('art/terrain/chibi-burning-v0384.webp') center / 100% 100% no-repeat;border:0;border-radius:0;transform-origin:50% 75%;animation:chibi-fire-spread 1.35s ease-out both;animation-delay:0s;filter:drop-shadow(0 0 9px #ff892ec0)}
@keyframes chibi-fire-spread{0%{opacity:0;transform:scale(.7)}18%{opacity:1;transform:scale(1.05)}65%{opacity:1;transform:scale(1.12)}100%{opacity:0;transform:scale(1.25) translateY(-8%)}}
@media(prefers-reduced-motion:reduce){.fx_ship_fire .ship-fire-front{animation:none;opacity:.85}}
