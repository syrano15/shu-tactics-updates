export const esc = value => String(value ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
export const rankName = unit => specializationName(unit)||promotionName(unit.cls, unit.promotion ?? 0);
export const rankStars = unit => '★'.repeat(unit.promotion ?? 0);
let cardOpen=false, effectCount=0, seenCard=null;
export const presentationBusy=()=>cardOpen||effectCount>0;
const presentationVersions=new WeakMap();
const image=(src,kind,id,alt)=>{
 const img=document.createElement('img');img.alt=alt;
 img.onerror=()=>{if(!markAssetURLUnavailable(kind,src))markAssetUnavailable(kind,id);img.remove();};
 img.src=src;return img;
};
const removeArt=el=>el.remove();
export function speakerUnit(chapter,speaker){
 const matches=unit=>unit.id===speaker||[unit.templateId,unit.campaignTemplateId].some(id=>id?.replace(/^(?:act[1234]_extra_|act[1234]_)/,'')===speaker)||(chapter.act===6&&unit.storySpeaker===speaker);
 return {enemy:chapter.enemies?.find(matches)??null,ally:chapter.extraAllies?.find(matches)??null};
}
// Retry a failed expression through the resolver: normal, old JPG, then an identified silhouette.
const loadPortrait=(img,hero,face,chapterId,options,{current,loaded,missing})=>{
 const tried=new Set();
 const load=()=>{
  const src=portraitURL(hero,face,chapterId,options);
  if(!src||tried.has(src)){missing();return false;}
  tried.add(src);
  img.onload=()=>{if(current())loaded();};
  img.onerror=()=>{if(!current())return;markAssetURLUnavailable('portrait',src);load();};
  img.src=src;return true;
 };
 return load();
};
const presentationState=new WeakMap();
const warmedScenes=new WeakSet();
function warmPresentation(lines,chapter,phase){
 if(warmedScenes.has(lines))return;
 warmedScenes.add(lines);
 const sources=new Set();
 for(let index=0;index<lines.length;index++){
  const line=lines[index],fields=presentationAt(lines,index,{bg:chapter.bg?.[phase]??chapter.bg?.pre??null});
  for(const kind of ['bg','cg'])if(fields[kind]){const src=assetURL(kind,fields[kind]);if(src)sources.add(src);}
  if(line.speaker!=='narrator'){
   const units=speakerUnit(chapter,line.speaker),options={faction:units.enemy?.faction??units.ally?.faction};
   const asset=portraitAsset(line.speaker,fields.face,chapter.id,options);if(asset)sources.add(asset.url);
  }
 }
 sources.forEach(src=>prepareArtwork(src));
}
export function clearPresentation(container) {
 presentationVersions.set(container,Symbol());
 container.querySelectorAll('.story-cg,.story-cutin,.story-fx').forEach(removeArt);
 container.classList.remove('has-story-cg','has-story-emphasis');
 container.setAttribute('data-event-speaker-side','');
 container.style.backgroundImage='';
 presentationState.delete(container);
}
function portraitFrame(img,asset){
 let viewport=img.parentElement;
 if(!viewport?.classList?.contains('portrait-viewport')){
  viewport=document.createElement('span');viewport.className='portrait-viewport';
  img.before(viewport);viewport.append(img);
 }
 viewport.classList.toggle('framed-portrait',!!asset.framed);
 const [x,y,w,h]=asset.crop??[0,0,1,1];
 viewport.classList.toggle('sheet-portrait',!!asset.crop);
 viewport.style.setProperty('--portrait-x',String(-x/w*100)+'%');
 viewport.style.setProperty('--portrait-y',String(-y/h*100)+'%');
 viewport.style.setProperty('--portrait-w',String(100/w)+'%');
 viewport.style.setProperty('--portrait-h',String(100/h)+'%');
 img.style.objectPosition='center top';
}
export function paintPresentation(container,lines,index,chapter,{event=false,phase='pre'}={}) {
 const fields=presentationAt(lines,index,{bg:chapter.bg?.[phase]??(phase==='defeat'?chapter.bg?.pre:null)??null}),line=lines[index];
 if(!line)return;
 warmPresentation(lines,chapter,phase);
 const visual=container.querySelector(event?'.event-visual':'.portrait-stage')??container;
 const version=Symbol();presentationVersions.set(container,version);
 const current=()=>presentationVersions.get(container)===version;
 const previous=presentationState.get(container)??{};
 const next={...previous};presentationState.set(container,next);
 container.querySelectorAll('.story-cutin,.story-fx').forEach(removeArt);
 const units=speakerUnit(chapter,line.speaker),options={faction:units.enemy?.faction??units.ally?.faction};
 // Important story lines emphasize the dialogue immediately. A second portrait/strip
 // used to load later, move enemy speakers across the scene, then disappear on a timer.
 container.classList.toggle('has-story-emphasis',fields.cutin&&line.speaker!=='narrator');
 container.setAttribute('data-event-speaker-side',event&&line.speaker!=='narrator'?(units.enemy?'right':'left'):'');
 const background=fields.bg&&assetURL('bg',fields.bg);
 next.background=background;
 if(!background)container.style.backgroundImage='';
 else prepareArtwork(background,{ready:()=>{if(current()){const value=`linear-gradient(#1118,#111b),url("${background}")`;if(container.style.backgroundImage!==value)container.style.backgroundImage=value;}},failed:()=>{markAssetURLUnavailable('bg',background);if(current())container.style.backgroundImage='';}});
 const portrait=!event&&container.querySelector('#portrait-left');
 const rightPortrait=!event&&container.querySelector('#portrait-right');
 const paired=!!(portrait&&rightPortrait);
 const pair=paired?dialogueSlotsAt(lines,index,{bg:chapter.bg?.[phase]??null,sides:chapter.rosterMode==='story'?{}:Object.fromEntries(Object.entries(CHARACTERS).map(([id,c])=>[id,c.side]))}):null;
 if(paired){container.classList.add('paired-dialogue');container.dataset.speakingSide=pair.speaking??'';}
 const cg=fields.cg&&assetURL('cg',fields.cg);
 const revealPortrait=()=>{
  if(paired){for(const [side,node] of [['left',portrait],['right',rightPortrait]])node.hidden=pair.narrator||!next.portraits?.[side]?.ready||!!next.cg;}
  else if(portrait)portrait.hidden=line.speaker==='narrator'||!next.portraitReady||!!next.cg;
  const small=event&&container.querySelector('.event-portrait');
  if(small)small.hidden=line.speaker==='narrator'||!next.eventPortraitReady||!!next.cg;
 };
 if(!cg){
  next.cg=null;container.querySelectorAll('.story-cg').forEach(removeArt);container.classList.remove('has-story-cg');
 } else {
  next.cg=cg;
  prepareArtwork(cg,{ready:()=>{
   if(!current())return;
   let node=container.querySelector('.story-cg');
   if(node?.getAttribute('src')!==cg){
    const replacement=image(cg,'cg',fields.cg,'이야기 장면');replacement.className='story-cg';
    if(node)node.replaceWith(replacement);else visual.append(replacement);
   }
   container.classList.add('has-story-cg');revealPortrait();
  },failed:()=>{markAssetURLUnavailable('cg',cg);if(current()){next.cg=null;container.querySelectorAll('.story-cg').forEach(removeArt);container.classList.remove('has-story-cg');revealPortrait();}}});
 }
 if(paired){
  next.portraits={};next.hero=line.speaker==='narrator'?null:line.speaker;
  for(const [side,node] of [['left',portrait],['right',rightPortrait]]){
   const entry=pair[side],before=previous.portraits?.[side]??{},state={hero:entry?.hero??null,ready:entry?.hero===before.hero&&!!before.ready};next.portraits[side]=state;
   node.classList.toggle('speaking',!pair.narrator&&pair.speaking===side);node.dataset.speaker=entry?.hero??'';
   if(!entry){node.hidden=true;continue;}
   const img=node.querySelector('img'),name=chapter.speakers?.[entry.hero]??CHARACTERS[entry.hero]?.name??entry.hero;
   if(entry.hero!==before.hero)node.hidden=true;
   img.alt=name;node.querySelector('figcaption').textContent=name;node.setAttribute('aria-label',name+(pair.speaking===side?' · 말하는 장수':' · 대화 상대'));
   const targetUnit=speakerUnit(chapter,entry.hero),opts={faction:targetUnit.enemy?.faction??targetUnit.ally?.faction},tried=new Set();
   const load=()=>{
    const asset=portraitAsset(entry.hero,entry.face,chapter.id,opts);
    if(!asset||tried.has(asset.url)){state.ready=false;revealPortrait();return;}
    tried.add(asset.url);
    prepareArtwork(asset.url,{ready:()=>{if(!current())return;portraitFrame(img,asset);if(img.getAttribute('src')!==asset.url)img.src=asset.url;state.ready=true;revealPortrait();},failed:()=>{markAssetURLUnavailable('portrait',asset.url);if(current())load();}});
   };load();
  }
  revealPortrait();
 } else if(portrait){
  if(line.speaker==='narrator'){next.hero=null;next.portraitReady=false;portrait.hidden=true;}
  else {
   const img=portrait.querySelector('img'),name=chapter.speakers?.[line.speaker]??line.speaker;
   const changedSpeaker=previous.hero!==line.speaker;
   next.hero=line.speaker;
   if(changedSpeaker){next.portraitReady=false;portrait.hidden=true;}
   img.alt=name;portrait.querySelector('figcaption').textContent=name;
   const tried=new Set();
   const load=()=>{
    const asset=portraitAsset(line.speaker,fields.face,chapter.id,options);
    if(!asset||tried.has(asset.url)){next.portraitReady=false;revealPortrait();return;}
    tried.add(asset.url);
    prepareArtwork(asset.url,{ready:()=>{if(!current())return;portraitFrame(img,asset);if(img.getAttribute('src')!==asset.url)img.src=asset.url;next.portraitReady=true;revealPortrait();},
     failed:()=>{markAssetURLUnavailable('portrait',asset.url);if(current())load();}});
   };load();revealPortrait();
  }
 }
 if(event&&line.speaker!=='narrator'){
  let small=container.querySelector('.event-portrait');
  if(!small){small=document.createElement('figure');small.className='event-portrait';small.hidden=true;small.append(document.createElement('img'));visual.append(small);}
  small.classList.toggle('is-enemy',!!units.enemy);
  if(previous.hero!==line.speaker){small.hidden=true;next.eventPortraitReady=false;}
  next.hero=line.speaker;
  const tried=new Set();
  const load=()=>{
   const asset=portraitAsset(line.speaker,fields.face,chapter.id,options);
   if(!asset||tried.has(asset.url)){next.eventPortraitReady=false;small.hidden=true;return;}
   tried.add(asset.url);
   prepareArtwork(asset.url,{ready:()=>{if(current()){const img=small.querySelector('img');img.alt=chapter.speakers?.[line.speaker]??line.speaker;portraitFrame(img,asset);if(img.getAttribute('src')!==asset.url)img.src=asset.url;next.eventPortraitReady=true;revealPortrait();}},failed:()=>{markAssetURLUnavailable('portrait',asset.url);if(current())load();}});
  };load();
 } else {container.querySelectorAll('.event-portrait').forEach(node=>node.remove());if(event){next.hero=null;next.eventPortraitReady=false;}}

}


export function initializeTitleArtwork(title=document.getElementById('title-scene')){
 if(!title)return {background:null,frame:null};
 const background=assetURL('bg','bg_field'),frameSource=assetURL('ui','ui_title_frame');
 const result={background:null,frame:null};
 if(background){
  const probe=image(background,'bg','bg_field','');result.background=probe;
  probe.onload=()=>{title.style.setProperty('--title-art',`url("${background}")`);title.classList.add('title-art-ready');};
  probe.addEventListener('error',()=>{title.style.removeProperty('--title-art');title.classList.remove('title-art-ready');});
 }
 const name=title.querySelector('#title-name');
 if(frameSource&&name){
  name.querySelectorAll('.title-frame-art').forEach(el=>el.remove());
  const frame=image(frameSource,'ui','ui_title_frame','');result.frame=frame;frame.className='title-frame-art';frame.setAttribute('aria-hidden','true');frame.hidden=true;
  frame.onload=()=>{frame.hidden=false;};name.append(frame);
 }
 return result;
}
export function mapEffect(effect,state,at='before'){
 if(!effect||(effect.at??'before')!==at)return;
 if((state.act6GrowthVersion===1||CHAPTERS[state.chapter]?.act===6)&&Object.hasOwn(ACT6_NATIVE_FX,effect.id)){nativeMapEffect(effect,state);return;}
 if(['fx_ship_fire','fx_gate_open','fx_arrow_rain'].includes(effect.id)){nativeMapEffect(effect,state);return;}
 const source=assetURL('fx',effect.id);if(!source)return;
 const unit=effect.unit&&state.units.find(u=>u.id===effect.unit),tile=effect.tile??(unit?[unit.x,unit.y]:null);
 const board=document.getElementById('board-stage'),cell=tile&&document.querySelector(`#board [data-x="${tile[0]}"][data-y="${tile[1]}"]`);
 const img=image(source,'fx',effect.id,'전장 효과');img.className='map-fx';
 if(cell){const r=cell.getBoundingClientRect(),b=board.getBoundingClientRect();img.style.cssText=`position:absolute;left:${r.left-b.left}px;top:${r.top-b.top}px;width:${r.width}px;height:${r.height}px;pointer-events:none;z-index:6`;}
 else img.style.cssText='position:absolute;inset:0;width:100%;height:100%;object-fit:contain;pointer-events:none;z-index:6';
 board.append(img);effectCount++;setTimeout(()=>{img.remove();effectCount--;},600);
}
function nativeMapEffect(effect,state){
 const board=document.getElementById('board-stage');if(!board)return;
 const unit=effect.unit&&state.units.find(u=>u.id===effect.unit),tile=effect.tile??(unit?[unit.x,unit.y]:null),cell=tile&&document.querySelector(`#board [data-x="${tile[0]}"][data-y="${tile[1]}"]`);
 const layer=document.createElement('div'),names={fx_ship_fire:'적벽 화공',fx_gate_open:'성문 개방',fx_arrow_rain:'화살 세례',...ACT6_NATIVE_FX};layer.className='map-fx native-map-fx '+effect.id;layer.setAttribute('role','img');layer.setAttribute('aria-label',names[effect.id]);
 const count=effect.id==='fx_arrow_rain'?15:effect.id==='fx_ship_fire'?12:2;
 const burning=effect.id==='fx_ship_fire'?state.units.filter(u=>u.team==='enemy'&&u.hp>0):[];
 const forestFire=effect.id==='fx_forest_fire'?(state.shipFire?.cells??[]).map(([x,y])=>({x,y})):[];
 if(burning.length||forestFire.length){for(const enemy of [...burning,...forestFire]){const at=document.querySelector(`#board [data-x="${enemy.x}"][data-y="${enemy.y}"]`);if(!at)continue;const r=at.getBoundingClientRect(),b=board.getBoundingClientRect(),particle=document.createElement('span');particle.className='ship-fire-front';particle.style.cssText=`left:${r.left-b.left-r.width*.1}px;top:${r.top-b.top-r.height*.2}px;width:${r.width*1.2}px;height:${r.height*1.3}px`;layer.append(particle);}}
 else for(let i=0;i<count;i++){const particle=document.createElement('span');particle.style.setProperty('--i',i);layer.append(particle);}
 if(cell){const r=cell.getBoundingClientRect(),b=board.getBoundingClientRect();layer.style.cssText=`left:${r.left-b.left-r.width}px;top:${r.top-b.top-r.height}px;width:${r.width*3}px;height:${r.height*3}px`;}
 board.append(layer);effectCount++;setTimeout(()=>{layer.remove();effectCount--;},effect.id==='fx_ship_fire'?1350:900);
}
export function chapterCard(chapter,fast=false){
 if(chapter.rosterMode!=='story'||seenCard===chapter.id)return;
 seenCard=chapter.id;cardOpen=true;
 const box=document.createElement('dialog');box.className='chapter-card';box.setAttribute('aria-label','장 시작');
 const map=assetURL('map',chapter.actMap??'act1');
 box.innerHTML=`<span class="eyebrow gold">${esc(chapter.episodeTitle??'1막 의용')}</span><h2>${esc(chapterTitle(chapter))}</h2><p>${esc(chapterSubtitle(chapter)||chapter.subtitle)}</p>${chapter.fate?`<p class="fate-text">${esc(chapter.fate.front)}</p>`:''}<button class="primary">이야기 시작</button>`;
 if(map){const img=image(map,'map',chapter.actMap??'act1','이야기 지도');img.className='chapter-map';box.prepend(img);}
 let timer;const close=()=>{clearTimeout(timer);cardOpen=false;box.close();box.remove();};box.querySelector('button').onclick=close;box.addEventListener('cancel',e=>{e.preventDefault();close();});
 document.body.append(box);box.showModal();box.querySelector('button').focus();
 if(!chapter.fate)timer=setTimeout(close,fast?1200:2400);
 return box;
}
export function fateVictory(chapter){
 if(!chapter.fate)return;
 cardOpen=true;const box=document.createElement('dialog');box.className='chapter-card';box.setAttribute('aria-label','운명 기록');
 box.innerHTML=`<h3>${esc(chapter.fate.front)}</h3><p>${esc(chapter.fate.back)}</p><button class="primary">결과 확인</button>`;
 const close=()=>{cardOpen=false;box.close();box.remove();};box.querySelector('button').onclick=close;box.addEventListener('cancel',e=>{e.preventDefault();close();});document.body.append(box);box.showModal();
}
export function resetCards(){seenCard=null;}
export function criticalPreview(p,enabled=false){
 if(!enabled&&!p.criticalChance&&!p.returnCriticalChance)return '';
 return `<p class="critical-note">치명타 ${Math.round(p.criticalChance*100)}% · 명중·치명 시 피해 ${p.criticalHit.toLocaleString()}${p.counter?`<br>반격 치명타 ${Math.round(p.returnCriticalChance*100)}% · 피해 ${p.returnCriticalHit.toLocaleString()}`:''}${p.counterIfMiss&&p.chance<1?`<br>공격 회피 후 반격 치명타 ${Math.round(p.returnCriticalChanceIfMiss*100)}% · 피해 ${p.returnCriticalHitIfMiss.toLocaleString()}`:''}</p>`;
}
export async function criticalEffect(actor,amount,critical,fast){
 const box=document.getElementById('combat');box.classList.toggle('critical-combat',!!critical);box.classList.toggle('enemy-critical',actor.team==='enemy');
 if(!critical)return;
 const label=document.createElement('strong');label.className='critical-label';label.textContent='치명타!';box.append(label);
 if(amount>=10&&!matchMedia('(prefers-reduced-motion: reduce)').matches){
  await new Promise(resolve=>setTimeout(resolve,fast?40:80));
  const board=document.getElementById('board-stage');board.classList.add('critical-shake');setTimeout(()=>board.classList.remove('critical-shake'),fast?100:200);
 }
}
