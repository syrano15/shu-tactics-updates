@import url('./skill-presentation.css');
@import url('./act2-relief-ui.css');
.act2-brief{padding:10px 14px;margin:8px 0 12px;background:linear-gradient(110deg,#18382be8,#10251fe8);border:1px solid #bb96596b;border-left:3px solid #b9a171;color:#e9e0c6;border-radius:3px}.act2-brief .eyebrow{display:block;font-size:10px;margin-bottom:3px}.act2-brief b{font-size:15px}.act2-brief p{margin:4px 0 0;font-size:12px;line-height:1.6}.act2-shop-banner{position:relative;overflow:hidden;min-height:170px;padding:25px 25px 18px;margin-bottom:18px;background:linear-gradient(90deg,#091e19ed,#091e1999,transparent),url('art/act2/intermission-v028.webp') center 57%/cover;border:1px solid #b89b68;border-radius:5px;color:#fff0c9}.act2-shop-banner h3{margin:6px 0;font:700 25px 'Noto Serif KR',serif}.act2-shop-banner p{max-width:470px;line-height:1.6;margin:0;text-shadow:0 1px 4px #000}.act2-growth-goals{margin:12px 0;padding:15px 18px;background:#173328;border:1px solid #7f947d60;border-radius:4px}.act2-growth-goals h4{margin:0 0 8px;color:#dcc181}.act2-growth-goals>.growth-goal-badges{display:flex;flex-wrap:wrap;gap:8px}.act2-growth-goals .growth-goal-badges span{padding:5px 10px;background:#10251d;border:1px solid #89947750;border-radius:3px;font-size:12px}.act2-growth-goals p{font-size:12px;color:#bdc5ad;line-height:1.6;margin-bottom:0}.unit-ui .skill-command{border-color:#cbae65;color:#fae2a0;background:#393f25}.unit-ui .skill-command:disabled{color:#c9c4ae;opacity:.62}.skill-reason,.boss-counter-warning{color:#ffbd92!important}.boss-counter-warning{padding:7px 9px;background:#58261f90;border-left:3px solid #d58b62}.skill-cost{color:#d7c395!important}.skill-target.cell{box-shadow:inset 0 0 0 3px #e7c470!important;background-color:#8f743055}.skill-target.support-target{box-shadow:inset 0 0 0 3px #79d6af!important;background-color:#39826650}.tier-badge{display:inline-block;margin-left:3px;padding:1px 4px;background:#3f281cdd;color:#f0cf95;border:1px solid #b89454;font-size:8px;border-radius:2px}.tier-badge.tier-boss{background:#641e1bdd;border-color:#d46c4c;color:#fff0c9}.special-ready-mark{position:absolute;top:0;right:1px;color:#ffdf80;text-shadow:0 0 6px #e79b24;font-size:12px}.battle-result-mark.is-support{color:#9bebbb;border-color:#64ba95;background:#123228ed}.special-cutin{position:fixed;left:0;right:0;top:34%;min-height:210px;z-index:1000;display:flex;justify-content:center;align-items:center;gap:28px;padding:18px 24px;background:linear-gradient(90deg,#061511f8,#324226f5,#061511f8);border-block:2px solid #d5b56f;box-shadow:0 10px 60px #000a;pointer-events:none;animation:special-enter .16s ease-out}.special-cutin-portrait{width:160px;height:175px;overflow:hidden;border:1px solid #b99d60;background:#1c3228;mask-image:linear-gradient(#000 82%,transparent)}.special-cutin img{width:100%;height:100%;object-fit:cover;object-position:center 24%}.special-cutin strong{display:block;font:700 38px 'Noto Serif KR',serif;color:#ffe3a0;text-shadow:0 2px 8px #000;letter-spacing:.08em}.special-cutin small{font-size:13px;color:#f4ead5}.special-cutin p{margin:9px 0 0;font-size:17px;color:#fff4dc}@keyframes special-enter{from{opacity:0;transform:translateX(-25px)}to{opacity:1;transform:translateX(0)}}@media(max-width:620px){.act2-shop-banner{min-height:130px;padding:16px}.act2-shop-banner h3{font-size:21px}.act2-brief p,.act2-growth-goals p{font-size:11px}.special-cutin{gap:13px;padding:14px;min-height:165px}.special-cutin-portrait{width:105px;height:135px}.special-cutin strong{font-size:23px;letter-spacing:.03em}.special-cutin p{font-size:12px}.special-cutin small{font-size:11px}}@media(prefers-reduced-motion:reduce){.special-cutin{animation:none}}

.skill-prediction{max-height:240px;overflow-y:auto;overscroll-behavior:contain}.skill-assumption{font-size:10px!important;color:#c3c3ac!important}
