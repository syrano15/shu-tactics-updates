import {historicalCampaignEnemyCapacity} from './campaign-enemy-balance.js';

export const ACT3_REINFORCEMENT_VERSION=1;
const fail=message=>{throw new Error('3막 증원 제한 기록 오류: '+message);};
const ensure=(ok,message)=>{if(!ok)fail(message);};
const unique=ids=>Array.isArray(ids)&&new Set(ids).size===ids.length;
const same=(a,b)=>a===b||a&&b&&typeof a==='object'&&typeof b==='object'&&Array.isArray(a)===Array.isArray(b)&&Object.keys(a).length===Object.keys(b).length&&Object.keys(a).every(k=>Object.hasOwn(b,k)&&same(a[k],b[k]));
const enemyWave=wave=>wave.team!=='ally';
export const act3ReinforcementApplies=chapter=>chapter?.act===3&&chapter.rosterMode==='story'&&chapter.campaignLayoutVersion===1&&chapter.battleEventsVersion===1;
const rawWaves=chapter=>act3ReinforcementApplies(chapter)?(chapter.reinforcements??[]).filter(enemyWave):[];
const reserveIds=chapter=>rawWaves(chapter).flatMap(w=>w.unitIds);
export const act3ReinforcementReserveIds=reserveIds;
function historyShape(value,chapter){
 ensure(value&&typeof value==='object'&&!Array.isArray(value)&&Object.keys(value).length===2&&Object.hasOwn(value,'spawned')&&Object.hasOwn(value,'units'),'원천 기록 형식');
 const waves=rawWaves(chapter);ensure(unique(value.spawned)&&value.spawned.every(id=>waves.some(w=>w.id===id))&&Array.isArray(value.units)&&value.units.length<=reserveIds(chapter).length&&unique(value.units.map(u=>u?.id)),'원천 도착/부대');
}
export function act3DefaultRemovedIds(chapter,legacySpawned=[]){
 if(!act3ReinforcementApplies(chapter))return [];
 const waves=rawWaves(chapter),pending=waves.filter(w=>!legacySpawned.includes(w.id)),priority=[...pending.filter(w=>!w.id.startsWith('layout_')),...pending.filter(w=>w.id.startsWith('layout_'))];
 const keep=new Set(priority.slice(0,Math.max(0,2-legacySpawned.length)).map(w=>w.id));
