// Local recovery originals are independent of game records and cloud accounts.
// There is deliberately no memory fallback, overwrite, merge or delete API.
export const SAVE_RECOVERY_DATABASE='shu-tactics-save-recovery-v1',SAVE_RECOVERY_VERSION=1,SAVE_RECOVERY_STORE='originals';
