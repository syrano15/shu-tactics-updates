  verifyBackup,
  async list(){
   requireOpen();const records=await transaction('readonly',(store,set,stop)=>{const rows=[];set(rows);const request=store.openCursor();request.onsuccess=()=>{const cursor=request.result;if(cursor){rows.push({id:cursor.key,record:cursor.value});cursor.continue();}};request.onerror=()=>stop();},readTimeoutMs),checked=[];
