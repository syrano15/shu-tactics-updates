const ordinary=key=>key==='auto'||/^manual(?:-([2-9]|[1-4][0-9]|5[0-6]))?$/.test(key);
// Historical checkpoints never compete with the explicitly selected journey.
export function ordinaryResumeSummary(rows,currentSlot=null){
