.growth-inline{font-size:12px;color:#dec98e;line-height:1.5;margin:7px 0}
.growth-progress{margin:12px 0;padding:12px 14px;background:#10251d;border:1px solid #60775b;border-radius:4px}.growth-progress p{margin:0;display:grid;gap:5px;font-size:13px;line-height:1.6}.growth-progress b{color:#e5c77d}.growth-progress span{color:#bdc5ad}.growth-exp-track{height:6px;margin-top:10px;background:#07180f;border-radius:3px;overflow:hidden}.growth-exp-track i{display:block;height:100%;background:#b6c788}.growth-progress.is-complete{border-color:#c7ad65}.growth-milestones{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:12px 0}.growth-milestones p{margin:0;padding:10px;background:#10251d;border:1px solid #425b42;border-radius:3px;line-height:1.6}.growth-milestones b,.growth-milestones span{display:block;font-size:12px}.growth-milestones b{color:#d9ca9d}.growth-milestones span{margin-top:3px;color:#b7c1ac}.growth-milestones .is-reached{border-color:#98a471}.growth-help{font-size:13px;line-height:1.7}.unit-spirit-details+.act2-growth-goals .growth-milestones{grid-template-columns:1fr}.unit-spirit-details+.act2-growth-goals .growth-progress{padding:10px}
@media(max-width:760px){.growth-milestones{grid-template-columns:1fr}.growth-progress p{font-size:12px}}
.growth-card{margin:22px 0;padding:20px;border:1px solid #465942;background:#15241c;text-align:left}
.growth-card h4{margin:0 0 12px;color:#e5c77d;font-size:19px}.growth-card p{font-size:13px;line-height:1.7;color:#b3c0ac}
.growth-table-wrap{overflow:auto}.growth-card table{width:100%;border-collapse:collapse;white-space:nowrap;font-size:13px}.growth-card td,.growth-card th{padding:9px;border-bottom:1px solid #344a37;text-align:right}.growth-card th:first-child{text-align:left}
.growth-result-list{display:grid;gap:8px}.growth-result-list>div{display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;padding:10px;background:#0e1c15}.growth-result-list small{color:#aab7a1}
#growth-toast{position:fixed;left:50%;top:100px;transform:translateX(-50%);z-index:90;padding:18px 25px;border:1px solid #e2c16b;background:#17271df5;color:#ffe3a1;box-shadow:0 10px 40px #0008;pointer-events:auto;max-width:90vw;font-weight:bold;animation:growth-pop .25s ease-out}
@keyframes growth-pop{from{opacity:0;top:115px}to{opacity:1;top:100px}}
@media(max-width:600px){.growth-card{padding:12px}.growth-card td,.growth-card th{padding:6px;font-size:11px}#growth-toast{top:20px;font-size:14px;width:85vw}.growth-result-list>div{font-size:13px}}

#growth-toast{padding:0;cursor:pointer}#growth-toast button{padding:16px 22px;color:inherit;border:0;background:transparent;font:inherit;line-height:1.55;text-align:left;max-width:100%}#growth-toast button:focus-visible{outline:2px solid #ffe3a1;outline-offset:3px}
