import {combatSpriteLayout,sanitizeCombatVisibleBounds} from './combat-scale.js';

// All coordinates describe already chosen artwork; this module never reads battle state or RNG.
const finite=(value,fallback)=>Number.isFinite(value)?value:fallback;
const clamp=(value,min,max)=>Math.max(min,Math.min(max,value));
const round=value=>Math.round(value*1000)/1000;
const ranged=new Set(['arrow','bolts','fire','confusion','deception']);
const mounted=new Set(['charge','mounted-slash','mounted-thrust','halberd','glaive']);
export function combatPoseBounds(record,pose,spriteSize=240){
 const size=Math.max(1,finite(spriteSize,240));
 const frame=record?.frames?.[pose]??record?.frames?.idle??record?.frames?.ready;
 const bounds=sanitizeCombatVisibleBounds(frame?.visibleBounds);
 if(!bounds||!frame?.rect)return {left:-size*.36,right:size*.36,top:-size*.82,bottom:0,width:size*.72,height:size*.82};
 const layout=combatSpriteLayout(record,pose),[x,y,w,h]=frame.rect;
 const xAt=value=>size*layout.cropWidth*(layout.imageLeft+(x+w*value)*layout.imageWidth)/100-size*layout.cropWidth/2;
 const yAt=value=>size*layout.cropHeight*(layout.imageTop+(y+h*value)*layout.imageHeight)/100-size*.92;
 const left=xAt(bounds[0]),right=xAt(bounds[2]),top=yAt(bounds[1]),bottom=yAt(bounds[3]);
 const tip=frame.weaponTip;
 const weaponTip=Array.isArray(tip)&&tip.length===2&&tip.every(value=>Number.isFinite(value)&&value>=0&&value<=1)?{weaponTipX:xAt(tip[0]),weaponTipY:yAt(tip[1])}:{};
 return {left,right,top,bottom,width:right-left,height:bottom-top,...weaponTip};
}
export function combatImpactDelay(style){
 return ({arrow:500,bolts:610,fire:420,confusion:380,deception:380,charge:340,'mounted-slash':340,'mounted-thrust':340,glaive:340,halberd:340})[style]??300;
}

/** Resolve a contact in scene pixels from visible silhouettes, including responsive width. */
export function resolveCombatContact(options={}){
 const width=Math.max(120,finite(options.fieldWidth,860)),height=Math.max(110,finite(options.fieldHeight,342));
 const size=Math.max(1,finite(options.spriteSize,width<=620?160:240)),direction=options.direction===-1?-1:1;
 const sourceCenter=finite(options.sourceCenter,width*(direction===1?.27:.73));
 const targetCenter=finite(options.targetCenter,width*(direction===1?.73:.27));
 const sourceFoot=finite(options.sourceFoot,height-46-size*.08),targetFoot=finite(options.targetFoot,height-46-size*.08);
 const style=options.style??'slash',source=combatPoseBounds(options.sourceRecord,'attack',size),target=combatPoseBounds(options.targetRecord,'ready',size);
 // Calibrated spear tips mirror with the art, including a counter from the right.
 const hasTip=['thrust','slash'].includes(style)&&Number.isFinite(source.weaponTipX),hasRangedTip=style==='arrow'&&Number.isFinite(source.weaponTipX);
 const sourceFront=hasTip||hasRangedTip?source.weaponTipX*(options.sourceRecord.facing==='left'?-1:1):direction===1?source.right:-source.left;
 const targetNear=Math.min(target.width*.22,target.height*.19);
 const impactX=clamp(targetCenter-direction*targetNear,12,width-12);
 const impactY=clamp(hasTip?sourceFoot+source.weaponTipY:targetFoot-target.height*.58,58,height-24);
 const padding=6,contactInset=4;
 const desired=Math.max(0,direction*(impactX-sourceCenter)-sourceFront+contactInset);
 const room=direction===1?width-padding-sourceCenter-source.right:sourceCenter+source.left-padding;
 // Silhouette contact may overlap a weapon, while the two main bodies keep their separation.
 const bodySeparation=(source.height*(mounted.has(style)?.30:.20)+target.height*.20)*.8;
 const beforeSeparation=direction*(targetCenter-sourceCenter);
 const travel=ranged.has(style)?0:Math.min(desired,Math.max(0,room),Math.max(0,beforeSeparation-bodySeparation));
 const projectileX=clamp(sourceCenter+direction*sourceFront,12,width-12);
 const sourceY=clamp(hasRangedTip?sourceFoot+source.weaponTipY:sourceFoot-source.height*.58,58,height-24);
 const wantedDodge=size<=130?36:width<=620?44:64;
 const dodgeRoom=direction===1?width-padding-targetCenter-target.right:targetCenter+target.left-padding;
 const dodgeDistance=Math.min(wantedDodge,Math.max(6,dodgeRoom));
 const cueWidth=Math.min(width*.48,220);
 const cueX=clamp(targetCenter,cueWidth/2+8,width-cueWidth/2-8);
 const cueY=clamp(targetFoot+target.top-28,66,height-78);
 return {
  direction,travel:round(travel),impactX:round(impactX),impactY:round(impactY),
  projectileX:round(projectileX),projectileY:round(sourceY),cueX:round(cueX),cueY:round(cueY),
  dodgeDistance:round(dodgeDistance),dodgeLift:dodgeRoom<wantedDodge*.65?18:8,
  collision:combatImpactDelay(style),
  sourceTipX:round(sourceCenter+direction*(travel+sourceFront)),targetBodyX:round(impactX),
  sourceBounds:source,targetBounds:target,
 };
}
