 const right=bounds.right-inset-anchor.right-gap,left=anchor.left-bounds.left-inset-gap;
 const side=right>=width||right>=left?'right':'left',center=(anchor.top+anchor.bottom)/2,centerX=(anchor.left+anchor.right)/2;
 const place=(side,x,y)=>({left:clamp(x,bounds.left+inset,bounds.right-inset-width),top:clamp(y,bounds.top+inset,bounds.bottom-inset-height),side});
 const sides={right:place('right',anchor.right+gap,center-height/2),left:place('left',anchor.left-gap-width,center-height/2)};
 let position=sides[side];
 if(avoid.length){
  const choices=[position,sides[side==='right'?'left':'right'],place('above',centerX-width/2,anchor.top-gap-height),place('below',centerX-width/2,anchor.bottom+gap),place('above',bounds.left+inset,bounds.top+inset),place('above',bounds.right-inset-width,bounds.top+inset),place('below',bounds.left+inset,bounds.bottom-inset-height),place('below',bounds.right-inset-width,bounds.bottom-inset-height)];
  const covered=p=>avoid.reduce((sum,rect)=>sum+Math.max(0,Math.min(p.left+width,rect.right)-Math.max(p.left,rect.left))*Math.max(0,Math.min(p.top+height,rect.bottom)-Math.max(p.top,rect.top)),0);
  let score=covered(position);for(const choice of choices){const next=covered(choice);if(next<score){position=choice;score=next;}if(score===0)break;}
 }
 return {...position,pointerY:clamp(center-position.top,18,height-18),pointerX:clamp(centerX-position.left,18,width-18),maxHeight:Math.max(1,bounds.bottom-bounds.top-2*inset)};
}
