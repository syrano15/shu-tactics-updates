export function normalizeBattleUISettings(value){
 return {commandPlacement:['popup','right','bottom'].includes(value?.commandPlacement)?value.commandPlacement:'popup'};
}
export function readBattleUISettings(storage){
 try{const value=JSON.parse((storage??globalThis.localStorage)?.getItem(BATTLE_UI_SETTINGS_KEY)??'null');
  // The old right-hand dock was the former default, not an explicit request to
  // remove the unit's speech-bubble menu. Preserve future deliberate choices.
  if(value?.commandPlacement==='right'&&value?.layoutVersion!==2)return normalizeBattleUISettings(null);
  return normalizeBattleUISettings(value);
 }catch{return normalizeBattleUISettings(null);}
}
export function writeBattleUISettings(value,storage){
 const settings=normalizeBattleUISettings(value);
 try{(storage??globalThis.localStorage)?.setItem(BATTLE_UI_SETTINGS_KEY,JSON.stringify({...settings,layoutVersion:2}));}catch{}
 return settings;
}
export function popupMenuGeometry({anchor,bounds,width,height,avoid=[],gap=12,inset=8}){
 const clamp=(value,min,max)=>Math.max(min,Math.min(Math.max(min,max),value)),available=bounds.right-bounds.left-2*inset;
