  const spec=mapPresentationSpec(chapter);if(chapter.campaignLayoutVersion!==1||spec.preserve)continue;
  const art={...spec,src:rockMapSource(chapter,spec)??'art/maps/'+(chapter.id==='s07_xiapi'&&chapter.xiapiRoutesVersion===1?'v0398':'v0395')+'/'+chapter.id+'.webp'};register(art);results.push(art);
