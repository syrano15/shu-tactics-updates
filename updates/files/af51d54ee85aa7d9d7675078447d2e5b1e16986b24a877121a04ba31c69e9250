.loot-feedback{position:fixed;z-index:180;top:clamp(72px,12vh,108px);left:50%;transform:translateX(-50%);width:min(420px,calc(100vw - 24px));box-sizing:border-box;padding:14px 18px;border:1px solid #ead09a;border-radius:12px;background:linear-gradient(135deg,#352719f5,#1f1912fa);color:#fff4d3;box-shadow:0 8px 32px #0009;text-align:center;pointer-events:auto;cursor:pointer;touch-action:manipulation;animation:loot-feedback-arrive .18s ease-out both;}
.loot-feedback-title{display:block;font-size:20px;line-height:1.3;color:#ffdc7b;letter-spacing:.03em;}
.loot-feedback p{margin:5px 0 0;line-height:1.45;overflow-wrap:anywhere;}
.loot-feedback-rewards{font-size:17px;font-weight:700;}
.loot-feedback-source{font-size:12px;color:#dbcaac;}
.loot-feedback-caption{font-size:12px;color:#ede1c8;}
.loot-feedback-dismiss{margin-top:8px;padding:3px 10px;border:1px solid #b39c65;border-radius:6px;background:#ffffff0a;color:#f5dda0;font:inherit;font-size:11px;cursor:pointer;touch-action:manipulation;}
.loot-feedback-dismiss:hover{background:#ffffff18;}.loot-feedback-dismiss:focus-visible{outline:2px solid #ffdc7b;outline-offset:3px;}
@keyframes loot-feedback-arrive{from{opacity:0;transform:translate(-50%,-8px)}to{opacity:1;transform:translate(-50%,0)}}
@media(max-width:420px){.loot-feedback{padding:12px 12px;}.loot-feedback-title{font-size:19px;}.loot-feedback-rewards{font-size:16px;}}
@media(prefers-reduced-motion:reduce){.loot-feedback{animation:none;}}
