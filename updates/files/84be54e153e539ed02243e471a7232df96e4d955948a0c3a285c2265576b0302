export const HERO_MASTERY_PASSIVES=Object.freeze(Object.fromEntries(Object.entries(records).map(([id,[name,description,bonuses]])=>[id,Object.freeze({id:'max_'+id,name,description,bonuses:Object.freeze(bonuses)})])));
const fail=message=>{throw new Error('최대 강화 특성 기록 오류: '+message);};
export function masteryLevels(hero){const m=hero?.modifications??{};return {weapon:(hero?.level??0)*2+(m.weapon??0),troops:Math.ceil((hero?.troopLevel??0)*2.5)+(m.troops??0),defense:m.defense??0};}
export function heroMasteryStatus(army,id){const h=army?.heroes?.[id],definition=HERO_MASTERY_PASSIVES[id],levels=masteryLevels(h),eligible=!!h&&!!definition&&!HERO_DATA[id]?.guest,achieved=eligible&&Object.values(levels).every(n=>n>=15);return {id,eligible,achieved,levels,definition};}
export function heroMasteryBonuses(army,id,version=1){return version===1&&heroMasteryStatus(army,id).achieved?HERO_MASTERY_PASSIVES[id].bonuses:{};}
export function captureHeroMastery(unit,army,id=unit.id,version=1){if(version===1&&unit.team==='ally'&&!unit.extra&&heroMasteryStatus(army,id).achieved)unit.masteryPassive=HERO_MASTERY_PASSIVES[id].id;return unit;}
export function validateHeroMasteryState(value){
 const state=value.state,version=state.heroMasteryVersion;
 if(version!==undefined&&version!==1)fail('지원하지 않는 버전');
 if(state.allyHpVersion!==undefined&&state.allyHpVersion!==1)fail('아군 병력 버전');
 const active=['preDialogue','deployment','battle'].includes(value.campaign.stage);
 for(const unit of state.units){
  if(unit.allyHpVersion!==undefined&&(unit.allyHpVersion!==1||state.allyHpVersion!==1||unit.team!=='ally'||unit.extra))fail('아군 병력 표식');
  if(state.allyHpVersion===1&&unit.team==='ally'&&!unit.extra&&unit.allyHpVersion!==1)fail('출전 병력 표식 누락');
  if(unit.masteryPassive!==undefined&&(version!==1||unit.team!=='ally'||unit.extra||HERO_DATA[unit.id]?.guest||unit.masteryPassive!==HERO_MASTERY_PASSIVES[unit.id]?.id))fail('장수 고유 특성');
  if(version===1&&active&&unit.team==='ally'&&!unit.extra){const expected=heroMasteryStatus(value.army,unit.id).achieved?HERO_MASTERY_PASSIVES[unit.id].id:undefined;if(unit.masteryPassive!==expected)fail('강화 기록과 고유 특성 불일치');}
 }
}
// Apply after validating the original snapshot. References supply the actual
// class/gear-adjusted delta; capped troops never create an extra heal.
export function upgradeValidatedHeroMastery(value,oldRefs,newRefs){
 const state=value.state;if(state.heroMasteryVersion===1&&state.allyHpVersion===1||state.result!==null||state.rewardsSettled||!['preDialogue','deployment','battle'].includes(value.campaign.stage))return false;
 if(![undefined,1].includes(state.heroMasteryVersion)||![undefined,1].includes(state.allyHpVersion))fail('지원하지 않는 버전');
 for(const unit of state.units.filter(u=>u.team==='ally'&&!u.extra)){
  const before=oldRefs.find(u=>u.id===unit.id),after=newRefs.find(u=>u.id===unit.id);if(!before||!after)fail('이행 참조');
  const hpDelta=after.maxHp-before.maxHp;
  for(const key of ['maxHp','atk','baseAtk','def','int','move','evasionBonus','criticalBonus','moraleBonus','tacticBonus'])unit[key]+=after[key]-before[key];
  if(unit.hp>0)unit.hp=Math.min(unit.maxHp,unit.hp+hpDelta);
  if(after.classTraining)unit.classTraining=structuredClone(after.classTraining);
  if(after.masteryPassive)unit.masteryPassive=after.masteryPassive;
  if(after.allyHpVersion===1)unit.allyHpVersion=1;
  if(state.bossCleanup?.status==='pending'){const saved=state.bossCleanup.basis.units.find(u=>u.id===unit.id);if(saved){saved.maxHp+=hpDelta;if(saved.hp>0)saved.hp+=hpDelta;}}
 }
 state.heroMasteryVersion=1;state.allyHpVersion=1;return true;
}
