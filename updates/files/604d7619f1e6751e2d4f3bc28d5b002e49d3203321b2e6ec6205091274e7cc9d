export const deploymentOrderDraft=(chapter,army,order)=>orderedPreparationIds(deploymentRosterIds(chapter,army),armyPreparationOrder(army,order));
export function moveDeploymentOrderDraft(ids,id,position){
 const next=[...ids],from=next.indexOf(id);
 if(from<0||!Number.isInteger(position)||position<0||position>=next.length)return next;
 next.splice(from,1);next.splice(position,0,id);return next;
}
export function applyDeploymentOrder(ui,chapter,army,draft,storage){
