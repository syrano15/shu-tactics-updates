 // One preference write, only on Apply. Hidden officers keep their slots.
 try{(storage??globalThis.localStorage)?.setItem(PREPARATION_ORDER_KEY,JSON.stringify(next));}catch{}
 ui.rosterOrder=next;return true;
}
