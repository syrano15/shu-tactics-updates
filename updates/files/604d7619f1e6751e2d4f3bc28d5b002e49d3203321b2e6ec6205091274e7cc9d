// Re-rendered list controls retain focus without scrolling the page or map.
export function focusDeploymentOrderButton(host,id,direction){
 const selector=step=>'[data-deploy-order="'+CSS.escape(id)+'"][data-deploy-direction="'+step+'"]';
 const preferred=host.querySelector(selector(direction)),fallback=host.querySelector(selector(-direction)),button=preferred&&!preferred.disabled?preferred:fallback&&!fallback.disabled?fallback:null;
 if(!button)return;
 button.focus({preventScroll:true});
 const track=button.closest('.deployment-roster-track'),card=button.closest('.deploy-card');
 if(!track||!card)return;
 const viewport=track.getBoundingClientRect(),item=card.getBoundingClientRect();
 if(item.top<viewport.top)track.scrollTop-=viewport.top-item.top;
 else if(item.bottom>viewport.bottom)track.scrollTop+=item.bottom-viewport.bottom;
 if(item.left<viewport.left)track.scrollLeft-=viewport.left-item.left;
 else if(item.right>viewport.right)track.scrollLeft+=item.right-viewport.right;
}
// Keep the selected officer inside the list without moving the page or map.
export function revealDeploymentSelection(host,id){
 if(!id)return;
 const card=host?.querySelector('[data-deploy-card="'+CSS.escape(id)+'"]'),track=card?.closest('.deployment-roster-track');
 if(!track)return;
 const viewport=track.getBoundingClientRect(),item=card.getBoundingClientRect();
 if(item.top<viewport.top)track.scrollTop-=viewport.top-item.top;
 else if(item.bottom>viewport.bottom)track.scrollTop+=item.bottom-viewport.bottom;
}
// The large targets use the same real placement buttons as the map.
// Opening/closing this native dialog never changes a formation.
export function handleDeploymentPickerAction(host,button){
 const action=button?.dataset?.deployPicker;
 if(action!=='open'&&action!=='close')return false;
 const dialog=host?.querySelector('.deployment-slot-dialog');
 if(!dialog||button.disabled)return true;
 if(action==='close'){
  if(dialog.open)dialog.close();
  host.querySelector('[data-deploy-picker="open"]')?.focus({preventScroll:true});
 }else if(!dialog.open){
  dialog.showModal();
  dialog.querySelector('[data-deploy-slot]:not(:disabled)')?.focus({preventScroll:true});
 }
 return true;
}
