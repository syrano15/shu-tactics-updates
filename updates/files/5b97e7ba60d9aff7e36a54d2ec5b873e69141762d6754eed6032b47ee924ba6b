import {UNIT_TEMPLATES} from './roster.js';
import {getPromotionBonuses} from './promotion.js';
import {levelBonuses} from './growth.js';
import {ENEMY_HP_CAP,progressionEnemyOrder,applyEnemyProgression} from './enemy-progression.js';

export const CAMPAIGN_ENEMY_BALANCE_VERSION=1;
const ACT_PROFILES=Object.freeze({
 3:{first:14,last:21,troop:[6000,6800],elite:[8000,8800],officer:[11000,13000],boss:[14000,16000]},
 4:{first:22,last:31,troop:[7000,7800],elite:[9000,9800],officer:[13000,15000],boss:[16000,18000]},
 5:{first:32,last:37,troop:[8000,8500],elite:[10000,10500],officer:[15000,16000],boss:[18000,19000]},
 6:{first:38,last:45,troop:[8500,9000],elite:[10500,10500],officer:[16000,17000],boss:[19000,20500]},
 7:{first:46,last:56,troop:[9000,9500],elite:[10500,10500],officer:[17000,18000],boss:[20500,22000]},
});
const ATTACK_CAPS={troop:90,elite:100,officer:112,boss:115};
const DEFENSE_CAPS={troop:28,elite:32,officer:38,boss:40};
const INTELLECT_CAPS={troop:90,elite:100,officer:110,boss:120};
const specialistNames=['호표기','철갑기병','저격병','방패병','장창병'];
const BALANCED_CHAPTER_IDS=new Set([
 's14_jiangxia','s15_chibi','s17_jingnan','s18_changsha','s19_jiangling','s20_adou_river','s21_jingzhou_hold',
 's22_jiameng','s23_fucheng','s24_luofengpo','s25_luocheng','s26_machao','s27_chengdu','s28_dangqu','s29_dingjun','s30_hanshui','s31_hanzhong',
 's32_fancheng','s33_flood','s34_xuhuang','s35_white_robes','s36_maicheng','s37_jiangling_retake',
 's38_langzhong','s39_wuxia','s40_yiling','s41_ruxu','s42_alliance','s43_lushui','s44_menghuo','s45_rattan',
 's46_tianshui','s47_jieting','s48_jigu','s49_chencang','s50_yinping','s51_wheat','s52_mumen','s53_wuzhangyuan','s54_seven_lamps','s55_weishui','s56_changan',
]);
const stageNumber=chapter=>Number(/^s(\d+)_/.exec(chapter?.id??'')?.[1]);
export const campaignEnemyBalanceApplies=chapter=>{
 const profile=ACT_PROFILES[chapter?.act],number=stageNumber(chapter);
 return !!profile&&BALANCED_CHAPTER_IDS.has(chapter.id)&&number>=profile.first&&number<=profile.last;
};
const interpolate=(range,progress)=>Math.round((range[0]+(range[1]-range[0])*progress)/100)*100;
export function campaignEnemyBalanceProfile(chapter){
 const profile=ACT_PROFILES[chapter?.act];
 if(!profile||!campaignEnemyBalanceApplies(chapter))return null;
 const progress=Math.max(0,Math.min(1,(stageNumber(chapter)-profile.first)/(profile.last-profile.first)));
 if(!Number.isFinite(progress))throw new Error('적 균형 조정의 장 번호가 올바르지 않습니다.');
 return Object.fromEntries(['troop','elite','officer','boss'].map(tier=>[tier,interpolate(profile[tier],progress)]));
}
function specialistFor(unit,chapter){
 if(chapter.act<6||chapter.id==='s38_langzhong'||unit.combatTier!=='elite')return null;
 const candidates=(chapter.enemies??[]).filter(order=>order.combatTier==='elite'&&UNIT_TEMPLATES[order.templateId]?.cls!=='strategist');
 const varied=['cavalry','crossbow','infantry','spear','archer'].map(cls=>candidates.find(order=>UNIT_TEMPLATES[order.templateId]?.cls===cls)).filter(Boolean);
 const chosen=[...new Set([...varied,...candidates].map(order=>order.id))].slice(0,Math.min(4,Math.ceil(candidates.length*.6)));
 if(!chosen.includes(unit.id))return null;
 if(unit.cls==='infantry')return {name:'방패병',hp:chapter.act===7?12500:11500};
 if(unit.cls==='spear')return {name:'장창병',hp:chapter.act===7?12000:11000};
 if(['archer','crossbow'].includes(unit.cls))return {name:'저격병',hp:11000};
 if(unit.cls==='cavalry'){
  const faction=unit.faction??chapter.enemies?.find(order=>order.id===unit.id)?.faction;
  return faction==='wei'&&chapter.act===6?{name:'호표기',hp:11500}:{name:'철갑기병',hp:12000};
 }
 return null;
}
function specialistName(unit,name){
 const existing=specialistNames.find(specialist=>unit.name.endsWith(specialist));
 if(existing)return unit.name.slice(0,-existing.length)+name;
 const prefix=unit.name.replace(/(?:정예 )?(?:보병|창병|기병|활병|석궁병)$/,'').trim();
 return prefix+' '+name;
}
export function applyCampaignEnemyBalance(unit,chapter,version=CAMPAIGN_ENEMY_BALANCE_VERSION){
 if(![0,1].includes(version))throw new Error('적 균형 조정 버전이 올바르지 않습니다.');
 if(version===0||unit.team!=='enemy'||!campaignEnemyBalanceApplies(chapter))return unit;
 const tier=unit.combatTier,profile=campaignEnemyBalanceProfile(chapter);
 if(!Object.hasOwn(profile,tier))throw new Error('적 균형 조정의 부대 등급이 올바르지 않습니다.');
 const specialist=specialistFor(unit,chapter),actOffset=chapter.act-3;
 const maxHp=specialist?.hp??Math.min(unit.maxHp,profile[tier]);
 const balanced={...unit,maxHp,hp:unit.hp===0?0:Math.max(1,Math.min(maxHp,Math.round(unit.hp/unit.maxHp*maxHp))),
  atk:Math.min(unit.atk,ATTACK_CAPS[tier]+actOffset*4),baseAtk:Math.min(unit.baseAtk,ATTACK_CAPS[tier]+actOffset*4),
  def:Math.min(unit.def,DEFENSE_CAPS[tier]+actOffset*2),int:Math.min(unit.int,INTELLECT_CAPS[tier]+actOffset*2)};
 if(!specialist)return balanced;
 const alreadySpecialist=unit.name.endsWith(specialist.name);
 balanced.name=specialistName(unit,specialist.name);
 if(specialist.name==='방패병'){
  balanced.move=2;balanced.cavalryDamageReceived=1;
  balanced.atk=Math.min(balanced.atk,ATTACK_CAPS.elite+actOffset*4-8);balanced.baseAtk=Math.min(balanced.baseAtk,balanced.atk);
 }else if(specialist.name==='장창병'){
  balanced.move=2;balanced.min=1;balanced.max=3;balanced.cavalryDamageDealt=2;
 }else if(specialist.name==='저격병'){
  balanced.move=2;balanced.min=3;balanced.max=5;balanced.attackAfterMove=false;
 }else if(specialist.name==='호표기'){
  balanced.move=7;balanced.def=alreadySpecialist?Math.min(unit.def,DEFENSE_CAPS.elite+actOffset*2-4):Math.max(0,balanced.def-4);
 }else{
  balanced.move=4;balanced.def=Math.min(unit.def+(alreadySpecialist?0:6),DEFENSE_CAPS.elite+actOffset*2+6);
  balanced.atk=Math.max(0,balanced.atk-(alreadySpecialist?0:8));balanced.baseAtk=Math.max(0,Math.min(balanced.baseAtk-(alreadySpecialist?0:8),balanced.atk));
 }
 return balanced;
}
export function enemySpecialistName(unit){
 return unit?.team==='enemy'&&unit.combatTier==='elite'&&typeof unit.name==='string'?specialistNames.find(name=>unit.name.endsWith(name))??'':'';
}
export function enemySpecialistDescription(unit,state){
 if(state?.campaignEnemyBalanceVersion!==1||unit?.team!=='enemy'||unit.combatTier!=='elite')return '';
 if(unit.name.endsWith('방패병'))return '특수 정예 · 방패병 · 이동2 · 기병 돌격의 상성 피해를 1배로 낮춤 · 책략으로 방어를 우회하세요.';
 if(unit.name.endsWith('장창병'))return '특수 정예 · 장창병 · 이동2 · 사거리1~3 · 기병에게 피해2배 · 보병으로 접근하세요.';
 if(unit.name.endsWith('저격병'))return '특수 정예 · 저격병 · 사거리3~5 · 이동 후 공격 불가 · 거리1~2에서는 사격·반격 불가.';
 if(unit.name.endsWith('호표기'))return '특수 정예 · 호표기 · 이동7의 돌격 기병 · 방어가 낮음 · 창병 상성에 취약합니다.';
 if(unit.name.endsWith('철갑기병'))return '특수 정예 · 철갑기병 · 이동4 · 방어 강화와 공격 감소 · 창병 상성·화공으로 공략하세요.';
 return '';
}
export function campaignEnemyOriginalCapacity(chapter,unit,state){
 if(unit?.team!=='enemy'||!campaignEnemyBalanceApplies(chapter))return null;
 const rawOrder=chapter.enemies?.find(order=>order.id===unit.id);
 if(!rawOrder)return null;
 const version=state.enemyProgressionVersion??1;
 const order=progressionEnemyOrder(chapter,rawOrder,version,state.act2EnemyDifficultyVersion??0),template=UNIT_TEMPLATES[order.templateId];
 if(!template)return null;
 const rank=order.rank??order.promotion??0,promotion=getPromotionBonuses(template.cls,rank),growth=levelBonuses(order.level??1,'balanced');
 const originalHp=Math.min(version===3?ENEMY_HP_CAP:10000,template.baseStats.hp+(template.hpBonus??0)+growth.hp+promotion.hp);
 const reference=applyEnemyProgression({team:'enemy',cls:template.cls,combatTier:order.combatTier,rank,maxHp:originalHp,hp:originalHp,atk:0,baseAtk:0,def:0,int:0},chapter,version,state.act2EnemyHealthVersion??0,state.act2EnemyDifficultyVersion??0);
 return template.cls==='strategist'&&state.enemyStrategistHealthVersion===1&&state.enemyStrategistHealthAdjustedIds?.includes(unit.id)?Math.max(1,Math.floor(reference.maxHp*.8)):reference.maxHp;
}
export function historicalCampaignEnemyCapacity(state,chapter,unit,maxHp){
 return state?.campaignEnemyBalanceVersion===1&&state.campaignEnemyBalanceSourceVersion===0&&Number.isInteger(maxHp)&&maxHp===campaignEnemyOriginalCapacity(chapter,unit,state);
}
