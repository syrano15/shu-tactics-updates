  entry.timer=setTimeout(()=>{
   if(active.get(host)!==entry)return;
   if(!isCurrent()){finish(host,entry,false);return;}
   try{
    onImpact();
    if(active.get(host)!==entry)return;
    if(!isCurrent()){finish(host,entry,false);return;}
    layer.className=layer.className.replace(' is-preparing','')+' is-impact';layer.dataset.phase='impact';
    // Every executed recipient starts together. Re-query cells after the map HP render.
    for(const target of model.targets)addMark(target.unit,'skill-map-impact'+(!target.landed?' is-miss':'')+(model.support?' is-support':''),target.label,model.support?model.glyph:'');
    if(model.counterDamage>0)addMark(model.actor,'skill-map-counter','반격 −'+count(model.counterDamage),'');
    reposition();
    entry.timer=setTimeout(()=>finish(host,entry,isCurrent()),timing.hold);
   }catch{finish(host,entry,false);}
  },timing.windup);
 });
}
