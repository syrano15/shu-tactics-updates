  }
 }else{
  const exchanges=result.exchanges?.length?result.exchanges:[{actor:actorBefore,target:targetBefore,result}];
  for(const exchange of exchanges){
   const unit=exchange.target,strike=exchange.result;
   if(!point(unit)||!strike||strike.skipped)continue;
   const landed=strike.landed===true||strike.success===true;
   const extra=(result.buffs??[]).filter(row=>row.id===unit.id).map(row=>row.morale?'사기 '+(row.morale>0?'+':'−')+count(Math.abs(row.morale)):row.fresh?'진법 약화':row.detail==='혼란'?'혼란':'').filter(Boolean),moved=result.moves?.some(row=>row.id===unit.id);
   targets.push({unit:clone(unit),landed,damage:landed?Math.max(0,strike.hit??0):0,label:(landed?(strike.critical?'치명타 ':'')+'−'+count(strike.hit):'회피')+(extra.length?' · '+extra.join(' · '):'')+(moved?' · 위치 이동':'')});
  }
  for(const row of [...(result.heals??[]),...(result.buffs??[])]){
   const unit=source.find(value=>value.id===row.id);if(!point(unit)||targets.some(value=>value.unit.id===unit.id))continue;
