}
export function clearCombatSkillPresentation(host){const entry=host&&active.get(host);if(entry)finish(host,entry,false);}
/** Ordering is preserved even when motion is reduced or the player selects fast playback. */
export function skillPresentationTiming({fast=false,reducedMotion=false,area=false}={}){
 return fast?{windup:120,hold:330}:reducedMotion?{windup:80,hold:570}:{windup:380,hold:area?770:620};
}
/** A pointer-transparent layer, clipped to the map viewport and following its real cell positions. */
export function playCombatSkillPresentation(host,model,{isCurrent=()=>true,fast=false,reducedMotion=!!globalThis.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches,onImpact=()=>{}}={}){
 clearCombatSkillPresentation(host);
