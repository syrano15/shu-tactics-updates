.inventory-sources{margin:12px 0;padding:12px;border:1px solid rgba(194,159,96,.24);border-radius:10px;background:rgba(194,159,96,.05);color:var(--muted,#b6b3aa);font-size:12px;line-height:1.65}
.inventory-sources p{margin:0}
.inventory-sources summary{margin-top:8px;color:var(--ink,#e8e1d1);font-size:13px;font-weight:700;cursor:pointer;overflow-wrap:anywhere}
.inventory-sources details[open] summary{margin-bottom:8px}
.inventory-sources .inventory-sources-guide{font-size:11px;margin-bottom:10px}
.inventory-sources-list{display:grid;gap:9px}
.inventory-source-part{padding:10px;border:1px solid rgba(194,159,96,.17);border-radius:8px;background:rgba(0,0,0,.12);min-width:0}
.inventory-source-part header{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
.inventory-source-part h5{margin:0;color:var(--ink,#e8e1d1);font-size:13px}
.inventory-source-part header small{font-size:11px;text-align:right}
.inventory-source-part dl{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin:8px 0;padding:7px 0;border-top:1px solid rgba(194,159,96,.12);border-bottom:1px solid rgba(194,159,96,.12)}
.inventory-source-part dl div{min-width:0}
.inventory-source-part dt{font-size:10px}
.inventory-source-part dd{margin:0;font-size:13px;color:var(--ink,#e8e1d1);overflow-wrap:anywhere}
.inventory-source-part ul{list-style:none;padding:0;margin:0;display:grid;gap:3px}
.inventory-source-part li{display:flex;justify-content:space-between;gap:8px;align-items:baseline}
.inventory-source-part li span{min-width:0;overflow-wrap:anywhere}
.inventory-source-part li b{flex-shrink:0;font-weight:600;color:var(--gold,#c9a760)}
.inventory-source-part .inventory-source-warning{margin-top:7px;color:#dfbc83;font-size:11px}
