  let bytes = ready.reduce((total, entry) => total + entry.bytes, 0);
  ready.sort((a, b) => a.used - b.used);
  while (ready.length > MAX_READY || bytes > MAX_DECODED_BYTES) {
    const entry = ready.shift();
