// encoded HTTP cache; this module retains only a bounded number of decoded images.
const entries = new Map(), active = new Set();
const MAX_ACTIVE = 2, MAX_BACKGROUND = 1, MAX_READY = 24, MAX_DECODED_BYTES = 96 * 1024 * 1024;
