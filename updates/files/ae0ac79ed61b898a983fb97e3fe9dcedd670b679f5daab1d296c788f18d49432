}

// Cancel ownership, not a shared in-flight download. A stale chapter cannot keep
// queued work or callbacks alive, while its at-most-two started requests may finish.
export function cancelArtworkScope(scope) {
  if (scope === undefined) return;
  for (const entry of entries.values()) {
    if (entry.state === 'ready') continue;
    entry.requests = entry.requests.filter(request => request.scope !== scope);
    if (!entry.requests.length && entry.state === 'queued') removeQueued(entry);
