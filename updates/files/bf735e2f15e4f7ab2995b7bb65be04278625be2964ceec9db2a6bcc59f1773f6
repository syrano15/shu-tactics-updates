// Presentation-only deformation of one decoded picture. Adjacent triangles share
// their vertices: painted arms, clothes and legs stay joined to the same body.
const finite=Number.isFinite;
const clamp=(n,a,b)=>Math.max(a,Math.min(b,n));
const set=(node,key,value)=>node.style.setProperty(key,String(value));
const identity=(x,y)=>({x,y});
const url=(source,base)=>{try{const u=new URL(source,base);if(!['http:','https:','file:','shu-tactics:'].includes(u.protocol))return null;u.search='';u.hash='';return u.href;}catch{return null;}};

export function spriteMeshSourceMatches(img,sources,base=import.meta.url){
