 const damage=hits.map(row=>row.chance===0?0:row.hit),chances=hits.map(row=>row.chance??1),chance=hits.length?(meta.actionKind==='tactic'?'성공 ':'명중 ')+percent(Math.min(...chances))+(chances.some(n=>n!==chances[0])?'–'+percent(Math.max(...chances)):''):'';
