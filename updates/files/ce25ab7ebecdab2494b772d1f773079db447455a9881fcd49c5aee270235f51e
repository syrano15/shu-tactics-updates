  const result=[target];while(result.length<skill.maxTargets){const last=result.at(-1),next=alive.filter(unit=>same(unit)&&!result.includes(unit)&&dist(last,unit)<=skill.radius).sort((a,b)=>dist(last,a)-dist(last,b)||a.y-b.y||a.x-b.x||a.id.localeCompare(b.id))[0];if(!next)break;result.push(next);}return result;
 }
 if(skill.area==='triage')return [target,...alive.filter(unit=>same(unit)&&unit.id!==target.id&&dist(target,unit)<=skill.radius).sort((a,b)=>a.hp/a.maxHp-b.hp/b.maxHp||a.id.localeCompare(b.id)).slice(0,skill.maxTargets-1)];
 if(!skill.area)return [target];
