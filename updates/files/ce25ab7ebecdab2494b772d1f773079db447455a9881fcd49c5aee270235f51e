 for(const unit of state.units.filter(u=>u.team==='ally'&&u.hp>0)){
  const amount=Math.min(Math.max(0,unit.maxSp-unit.sp),Math.max(0,...activeEffects(unit,state).map(effect=>effect.phaseSP??0)));if(amount){const before=unit.sp;unit.sp+=amount;spHeals.push({id:unit.id,name:unit.name,amount,before,after:unit.sp});}
