}
const activeEffects=(unit,state)=>(unit.legendaryEffects??[]).filter(row=>!state||row.untilRound>state.round).map(row=>legendarySkillFor(row.skillId)?.persistent).filter(Boolean);
export function legendaryStatModifiers(unit,state=null){
 const result={attackMultiplier:1,defenseMultiplier:1,moveBonus:0,rangeBonus:0,counterDisabled:false,controlImmune:false};
 for(const effect of activeEffects(unit,state)){
  // Strongest benefit and strongest penalty coexist; matching buffs never multiply repeatedly.
  result.attackMultiplier=Math.min(result.attackMultiplier,effect.attackMultiplier??1);
  result.defenseMultiplier=Math.min(result.defenseMultiplier,effect.defenseMultiplier??1);
  result.moveBonus=Math.min(result.moveBonus,effect.moveBonus??0);result.rangeBonus=Math.max(result.rangeBonus,effect.rangeBonus??0);
  result.counterDisabled ||= !!effect.counterDisabled;result.controlImmune ||= !!effect.controlImmune;
 }
 const benefits=activeEffects(unit,state);result.attackMultiplier*=Math.max(1,...benefits.map(effect=>effect.attackMultiplier??1));result.defenseMultiplier*=Math.max(1,...benefits.map(effect=>effect.defenseMultiplier??1));result.moveBonus+=Math.max(0,...benefits.map(effect=>effect.moveBonus??0));
 if(!['archer','crossbow'].includes(unit.cls))result.rangeBonus=0;return result;
}
export function legendaryIncomingMultiplier(attacker,target,state,kind='physical'){
 let multiplier=1;for(const effect of activeEffects(target,state)){
  const condition=effect.guardKind;
  if(effect.guard===undefined||condition==='physical'&&kind!=='physical'||condition==='ranged'&&(kind!=='physical'||dist(attacker,target)<2)||condition==='wounded'&&target.hp>target.maxHp*.5)continue;
  multiplier=Math.min(multiplier,effect.guard);
 }return multiplier;
}
export function legendaryPhaseStart(state){
