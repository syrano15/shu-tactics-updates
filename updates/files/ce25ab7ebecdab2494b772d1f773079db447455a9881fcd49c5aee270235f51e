export function initializeLegendaryBattle(state){
 if(state.legendarySkillsVersion!==undefined)return state;
 if(state.legendaryUsed!==undefined||state.legendaryPhaseRound!==undefined||state.units.some(unit=>unit.legendaryEffects!==undefined))throw new Error('고유필살기 버전 없는 효과 기록입니다.');
