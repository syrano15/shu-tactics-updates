  const skill=legendarySkillFor(row?.skillId),unit=state.units.find(u=>u.id===row?.ownerId);
  const owner=guestHeroIdentity(unit)??row?.ownerId;
  if(!row||Object.keys(row).sort().join(',')!=='ownerId,round,skillId'||!skill||skill.owner!==owner||!HERO_DATA[owner]||HERO_DATA[owner].guest||seen.has(row.ownerId)||!integer(row.round,1,state.round)||!unit||unit.team!=='ally'||unit.extra&&!guestHeroIdentity(unit)||unit.level<LEGENDARY_LEVEL||unit.specialReadyRound<row.round+SPECIAL_REST_ROUNDS)fail('사용 장수/기술/라운드 오류');seen.add(row.ownerId);
 }
