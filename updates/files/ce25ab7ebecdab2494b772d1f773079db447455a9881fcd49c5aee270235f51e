export function legendaryAreaCells(state,actor,skill,target=null){
 const cells=new Set(),center=['cross','diamond-target','allies-target','triage','perpendicular'].includes(skill.area)?target:actor;
 if(!center)return cells;const dx=Math.sign((target?.x??actor.x)-actor.x),dy=Math.sign((target?.y??actor.y)-actor.y),horizontal=Math.abs((target?.x??actor.x)-actor.x)>=Math.abs((target?.y??actor.y)-actor.y);
 for(let y=0;y<state.terrain.length;y++)for(let x=0;x<state.terrain[0].length;x++){
  const p={x,y},d=dist(center,p),q=cheb(center,p),forward=horizontal?(x-actor.x)*dx:(y-actor.y)*dy,lateral=horizontal?Math.abs(y-actor.y):Math.abs(x-actor.x);
  const yes=skill.area==='self'?d===0:skill.area==='surround'?q===1:skill.area==='diamond-self'||skill.area==='allies'?d<=skill.radius:skill.area==='cross'?d<=1:skill.area==='diamond-target'||skill.area==='allies-target'||skill.area==='triage'?d<=skill.radius:skill.area==='formation'?x===actor.x||y===actor.y:skill.area==='line'?forward>=1&&forward<=skill.radius&&lateral===0:skill.area==='cone'?forward>=1&&forward<=skill.radius&&lateral<forward:skill.area==='perpendicular'?horizontal?x===center.x&&Math.abs(y-center.y)<=skill.radius:y===center.y&&Math.abs(x-center.x)<=skill.radius:false;
  if(yes)cells.add(x+','+y);
 }
 return cells;
}
export function legendaryAffected(state,actor,target,skill){
