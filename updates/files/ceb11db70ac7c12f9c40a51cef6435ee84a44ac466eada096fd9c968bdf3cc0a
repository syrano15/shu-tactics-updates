/* Keep placement and its primary action within the game window. */
body.ui-stage-deployment #game-main{height:calc(100dvh - 46px);display:grid;grid-template-rows:38px minmax(0,1fr);gap:10px}
body.ui-stage-deployment #game-main>.battle-heading{margin-bottom:0}
body.ui-stage-deployment #deployment-scene{height:100%;min-height:0;overflow:hidden;padding:0;border:0;background:transparent}
.deployment-compact{height:100%;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto auto;gap:12px;padding:16px;border:1px solid var(--line);background:#14221b;border-radius:8px}
.deployment-compact .deploy-top{display:flex;align-items:center;gap:20px;margin:0;flex-wrap:nowrap}
.deployment-compact .deploy-top h3{font:600 22px var(--font-heading);margin:0}
.deployment-compact .deploy-top strong{color:var(--gold);font-size:16px;white-space:nowrap}
.deployment-compact .deploy-top button{margin-left:auto;white-space:nowrap}
.deployment-board-layout{display:grid;grid-template-columns:minmax(0,1fr) 228px;gap:16px;min-height:0}
.deployment-compact .prep-placement-map{min-width:0;min-height:0;display:flex;align-items:center;justify-content:center;background:#0e1b15;border:1px solid var(--line);border-radius:5px;padding:8px}
.deployment-compact .deploy-map-scroll{height:100%;width:100%;display:flex;justify-content:center;overflow:hidden;min-height:0;padding:0}
.deployment-compact .deploy-map{height:100%;width:auto;max-width:100%;min-width:0;gap:2px;display:grid;align-self:center;margin:0}
.deployment-compact .deploy-axis{font-size:10px;color:var(--muted);line-height:1;display:grid;place-items:center;overflow:hidden}
.deployment-compact .deploy-cell{position:relative;min-width:0;min-height:0;aspect-ratio:auto;padding:0;display:flex;align-items:center;justify-content:center;flex-direction:column;font-size:10px;line-height:1;border:1px solid #586347;background:#364330;overflow:hidden;border-radius:1px}
.deployment-compact .deploy-cell.forest{background:#1c3a2a;color:#c3d4bf}
.deployment-compact .deploy-cell.river{background:#203c3c;color:#a9cccd}
.deployment-compact .deploy-cell.enemy{color:#dba382;background:#503f30}
.deployment-compact .deploy-cell.spawn{background:#3f513d;border-color:#8ca68b}
.deployment-compact .deploy-cell.occupied{background:#635733;border-color:#c1a86e;color:#fff1bd}
.deployment-compact .deploy-cell.placing{background:#d7b779;border:2px solid #fff0b9;color:#17281d}
.deployment-compact .deploy-cell b{font-size:clamp(11px,1.3vw,19px);line-height:1}
.deployment-compact .deploy-cell small{font-size:8px;line-height:1;white-space:nowrap;margin-top:1px}
.deployment-compact .deploy-lock{position:absolute;right:1px;top:0;font-size:7px;color:#ffe6a5}
.deployment-selection-panel{padding:12px 14px;border-left:2px solid #a68c54;background:#203327;min-height:0;overflow:auto}
.deployment-compact .deploy-selection{margin:10px 0 16px;padding:0;background:none;border:0;color:#f2e2b5;font-size:14px;line-height:1.75;min-height:0}
.deployment-map-key{display:grid;gap:8px;font-size:11px;color:var(--muted)}
.deployment-map-key i{display:inline-block;width:9px;height:9px;background:#879b6c;margin-right:8px}
.deployment-map-key i.enemy{background:#a86e50}
.deployment-compact .deploy-key-help{font-size:11px;line-height:1.7;color:var(--muted);margin-top:18px}
.deployment-compact .prep-placement-roster{min-width:0;min-height:0}
.deployment-roster-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;color:var(--muted);font-size:11px}
.deployment-roster-heading h4{font-size:13px;margin:0;color:var(--text)}
.deployment-roster-track{display:flex;gap:8px;overflow-x:auto;overflow-y:hidden;scrollbar-width:thin;padding:0 0 5px;scroll-snap-type:x proximity}
.deployment-compact .deploy-card{flex:0 0 156px;display:flex;flex-direction:column;margin:0;padding:0;border:1px solid var(--line);border-radius:4px;background:#223427;scroll-snap-align:start;min-width:0;min-height:0;overflow:hidden;position:relative}
.deployment-compact .deploy-card.in-sortie{border-color:#8b8758}
.deployment-compact .deploy-card.placing{background:#3c422c;border-color:var(--gold)}
.deployment-compact .deploy-card-main{width:100%;display:flex;gap:8px;align-items:center;text-align:left;padding:7px;border:0;background:transparent;border-radius:0;min-height:74px}
.deployment-compact .deploy-card-main .battle-sprite{position:static;inset:auto;transform:none;width:42px!important;height:54px!important;flex:0 0 42px;display:block;object-fit:contain}
.deployment-compact .deploy-card-main .promotion-aura{display:none}
.deployment-compact .deploy-card-main>span:last-child{min-width:0}
.deployment-compact .deploy-card-main b{font-size:14px;line-height:1.4;display:block;white-space:nowrap}
.deployment-compact .deploy-card-main small{display:block;font-size:10px;line-height:1.6;color:var(--muted);white-space:nowrap}
.deployment-compact .deploy-card-main b small{display:inline;font-size:10px;color:var(--gold)}
.deployment-compact .hero-placeholder{width:35px;flex:0 0 35px;font-size:23px;color:var(--gold);text-align:center}
.deployment-compact .deploy-remove{position:absolute;right:4px;bottom:3px;font-size:9px;line-height:1;padding:3px 5px;border-color:#627053;background:#17271d}
.deployment-compact .deploy-actions{display:flex;align-items:center;justify-content:flex-end;gap:10px;margin:0;padding-top:10px;border-top:1px solid var(--line);min-height:56px}
.deployment-compact .deploy-message{margin:0 auto 0 0;padding:0;color:var(--muted);font-size:12px;line-height:1.6;max-width:55%}
.deployment-compact .deploy-actions button{white-space:nowrap;min-height:44px}
.deployment-compact .deploy-actions .primary{min-width:218px;font-size:15px;min-height:48px}
.deployment-details-dialog{width:min(540px,calc(100vw - 24px));max-height:80dvh;overflow:auto;text-align:left}
.deployment-details-dialog .prep-panel{margin-top:14px}
@media(max-height:760px) and (min-width:900px){.deployment-compact{gap:8px;padding:10px}.deployment-compact .deploy-cell small{display:none}.deployment-compact .deploy-card-main{min-height:66px}.deployment-compact .deploy-card-main .battle-sprite{height:46px!important}.deployment-compact .deploy-actions{min-height:52px;padding-top:6px}.deployment-selection-panel{padding:9px 12px}}
@media(max-width:899px){.deployment-board-layout{grid-template-columns:minmax(0,1fr) 180px;gap:10px}.deployment-compact{padding:10px;gap:8px}.deployment-compact .deploy-top{gap:10px}.deployment-compact .deploy-top h3{font-size:18px}.deployment-compact .deploy-top strong{font-size:13px}.deployment-selection-panel{padding:8px}.deployment-compact .deploy-selection{font-size:12px}.deployment-compact .deploy-actions .primary{min-width:170px}.deployment-compact .deploy-message{font-size:10px;max-width:40%}}
@media(max-width:600px){body.ui-stage-deployment{height:auto;overflow:auto}body.ui-stage-deployment #game-main{height:auto;display:block}.deployment-compact{height:600px;min-height:560px}.deployment-board-layout{grid-template-columns:1fr}.deployment-selection-panel{display:none}.deployment-compact .deploy-top{flex-wrap:wrap}.deployment-compact .deploy-top button{font-size:11px;padding:4px 8px}.deployment-compact .deploy-actions{flex-wrap:wrap}.deployment-compact .deploy-message{max-width:100%;width:100%;margin:0}.deployment-compact .deploy-actions .primary{flex:1}.deployment-compact .deploy-actions button{font-size:12px}.deployment-compact .deploy-cell small{display:none}body.ui-stage-deployment #deployment-scene{height:auto;min-height:560px;overflow:visible}}

/* One bounded shell: only the middle content scrolls; departure is outside it.
   These scene selectors also defeat the older preparation flex/auto overrides. */
body.ui-stage-deployment{height:100dvh;min-height:0;overflow:hidden}
body.ui-stage-deployment #game-main{height:calc(100dvh - 46px);min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr)}
body.ui-stage-deployment #deployment-scene{height:100%;min-height:0;overflow:hidden}
#deployment-scene .deployment-compact,#shop-scene .deployment-compact{height:100%;min-height:0;min-width:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:12px;overflow:hidden}
#shop-scene .prep-content[data-page="deployment"] .prep-main{display:flex;min-height:0;overflow:hidden}
#deployment-scene .deployment-content-scroll,#shop-scene .deployment-content-scroll{min-height:0;min-width:0;overflow:auto;overscroll-behavior:contain;display:flex;flex-direction:column;gap:14px}
#deployment-scene .deployment-board-layout,#shop-scene .deployment-board-layout{flex:none;min-width:0}
#deployment-scene .deploy-map-scroll,#shop-scene .deploy-map-scroll{max-height:min(50dvh,600px);overflow:auto}
#deployment-scene .prep-placement-roster,#shop-scene .prep-placement-roster{flex:none;min-width:0}
#deployment-scene .deployment-roster-heading,#shop-scene .deployment-roster-heading{gap:8px;flex-wrap:wrap}
#deployment-scene .deployment-roster-heading>button,#shop-scene .deployment-roster-heading>button{min-height:44px;margin-left:auto;font-size:15px;padding:6px 12px;white-space:nowrap}
#deployment-scene .deploy-actions,#shop-scene .deploy-actions{flex-shrink:0;min-height:0;gap:8px 12px;padding-top:8px;background:var(--prep-panel,#14221b)}
#deployment-scene .deploy-actions button,#shop-scene .deploy-actions button{min-height:48px}
.deployment-order-dialog{width:min(600px,calc(100vw - 24px));height:min(740px,calc(100dvh - 24px));max-height:calc(100dvh - 24px);max-width:calc(100vw - 24px);padding:0;overflow:hidden;border:1px solid var(--prep-accent,#b49b64);border-radius:8px;background:var(--prep-panel,#202a31);color:var(--prep-ink,#efeddf)}
.deployment-order-dialog[open]{display:grid;grid-template-rows:auto auto auto minmax(0,1fr) auto}
.deployment-order-dialog::backdrop{background:#07100ddd}
.deployment-order-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;border-bottom:1px solid var(--prep-line,#46565b)}
.deployment-order-heading h3{margin:0;font-size:21px}
.deployment-order-dialog button{min-height:44px;font-size:16px;line-height:1.4;touch-action:manipulation}
.deployment-order-help,.deployment-order-status{margin:0;padding:10px 16px 0;font-size:14px;line-height:1.6;word-break:keep-all}
.deployment-order-help{color:var(--prep-muted,#bbc2b9)}
.deployment-order-status{min-height:36px;padding-bottom:8px;color:var(--gold)}
.deployment-order-list{min-height:0;margin:0;padding:4px 12px 12px;overflow:auto;overscroll-behavior:contain;list-style:none}
.deployment-order-list li+li{margin-top:6px}
.deployment-order-list button{display:grid;grid-template-columns:32px minmax(0,1fr) auto;align-items:center;gap:8px;width:100%;min-height:52px;padding:8px 12px;text-align:left;background:var(--prep-panel-raised,#29373e)}
.deployment-order-list button>span{color:var(--prep-muted,#bbc2b9);text-align:center}
.deployment-order-list button>small{color:var(--gold);font-size:13px}
.deployment-order-list button[aria-pressed="true"]{border-color:var(--gold);background:#494631}
.deployment-order-actions{display:flex;justify-content:flex-end;gap:10px;padding:12px 16px;border-top:1px solid var(--prep-line,#46565b)}
.deployment-order-actions button{min-width:96px}
@media(max-width:600px){#deployment-scene .deployment-compact,#shop-scene .deployment-compact{padding:10px;gap:8px}#deployment-scene .deploy-actions .primary{flex:1;min-width:0}.deployment-order-heading h3{font-size:18px}}
/* The legacy small-screen footer uses a wrapping column flexbox, which can
   create a second column outside the viewport. Explicit grid tracks stay local. */
@media(max-width:899px){
 #deployment-scene .deployment-compact .deploy-actions,#shop-scene .deployment-compact .deploy-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%;min-width:0;max-width:100%;align-items:stretch;justify-content:stretch}
 #deployment-scene .deployment-compact .deploy-actions>.deploy-message,#shop-scene .deployment-compact .deploy-actions>.deploy-message{grid-column:1/-1;min-width:0;width:100%;margin:0}
 #deployment-scene .deployment-compact .deploy-actions>button,#shop-scene .deployment-compact .deploy-actions>button{width:100%;min-width:0;max-width:100%;white-space:normal;word-break:keep-all;overflow-wrap:normal;padding:8px;line-height:1.4}
 #deployment-scene .deployment-compact .deploy-actions>button:only-of-type,#shop-scene .deployment-compact .deploy-actions>button:only-of-type{grid-column:1/-1}
}
