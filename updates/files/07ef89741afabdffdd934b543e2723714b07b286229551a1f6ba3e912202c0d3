export function loadStageMapArt(scenarioId,root=globalThis.document,ImageType=globalThis.Image,geometry) {
  const art=stageArt(scenarioId,geometry);
  if(!art||!root?.querySelectorAll||!ImageType)return Promise.resolve(false);
  const loadKey=art.src;let record=stageMapLoads.get(loadKey);
  if(record)record.lastUsed=++stageMapUse;
  if(!record){
    record={id:scenarioId,status:'loading',source:art.src,shared:art.sharedTextureSVG===true,lastUsed:++stageMapUse};stageMapLoads.set(loadKey,record);
    record.promise=new Promise(resolve=>{
      const finish=ready=>{
        if(record.status!=='loading')return;
        if(stageMapLoads.get(loadKey)!==record){record.release?.();resolve(false);return;}
        if(!ready)record.release?.();record.status=ready?'ready':'failed';
        // Retain a few recent paintings, rather than every expanded SVG blob
        // from a long campaign. The shared original textures have their own cap.
        if(ready&&record.shared){const recent=[...stageMapLoads.entries()].filter(([,entry])=>entry.shared&&entry.status==='ready').sort((a,b)=>a[1].lastUsed-b[1].lastUsed);while(recent.length>4){const [key,entry]=recent.shift();entry.release?.();stageMapLoads.delete(key);}}
        resolve(ready);notifyStageMap(scenarioId);
      };
      const decodeSource=source=>new Promise((done,fail)=>{try{const image=new ImageType();let decoding=false;image.onload=()=>{if(decoding)return;if(image.naturalWidth!==art.width||image.naturalHeight!==art.height){fail(new Error('전장 그림 규격 오류'));return;}decoding=true;Promise.resolve().then(()=>image.decode?.()).then(done,fail);};image.onerror=()=>{if(!retryOriginalImage(image))fail(new Error('전장 그림 읽기 실패'));};image.src=imageSource(source);}catch(error){fail(error);}});
      if(art.sharedTextureSVG===true){
        sharedMapTextureLoader.prepare(art).then(prepared=>{
          record.release=prepared.release;
          if(stageMapLoads.get(loadKey)!==record){finish(false);return;}
          record.source=prepared.source;record.layered=false;decodeSource(prepared.source).then(()=>finish(true),()=>finish(false));
        },()=>finish(false));return;
      }
      // Every layered resource is decoded before any tile is hidden. A broken
      // overlay/mask cannot expose the unsigned old raster on a changed fort.
      Promise.all([art.src,...(art.baseSrc?[art.baseSrc,art.edgeMaskSrc]:[])].map(decodeSource)).then(()=>{record.layered=!!art.baseSrc;finish(true);},()=>{
        if(!art.fallbackSrc){finish(false);return;}record.source=art.fallbackSrc;record.layered=false;decodeSource(art.fallbackSrc).then(()=>finish(true),()=>finish(false));
      });
    });
  }
  // 재렌더나 다른 장으로 이동한 뒤의 오래된 로드 완료는 같은 장의 그림층만 갱신한다.
  return record.promise.then(ready=>{
    if(stageMapLoads.get(loadKey)!==record)return false;
    applyStageMap(root,scenarioId,ready,loadKey);return ready;
  });
}

export function resetStageMapArtFailures() {
