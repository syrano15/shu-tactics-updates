function applyStageMap(root,scenarioId,ready,source) {
  for(const layer of root?.querySelectorAll?.('[data-stage-map="'+scenarioId+'"]')??[]){
    if(layer.dataset?.stageMap!==scenarioId||(layer.dataset.stageMapSource??stageArt(scenarioId)?.src)!==source)continue;
     if(!ready&&layer.dataset.terrainDeferred){
       const source=layer.dataset.terrainDeferred,doc=layer.ownerDocument??root?.ownerDocument??root;
       if(knownSources.has(source)&&!unavailableSources.has(source)&&!layer.querySelector?.('.terrain-art-image')&&doc?.createElement){
         const image=doc.createElement('img');image.className='terrain-art-image';image.dataset.terrainAsset=source;image.alt='';image.draggable=false;image.decoding='async';image.hidden=true;image.src=imageSource(source);layer.append(image);
       }
       delete layer.dataset.terrainDeferred;
     }
    layer.classList.toggle('stage-map-ready',ready);
    layer.classList.toggle('terrain-art-ready',ready||layer.querySelector?.('.terrain-art-image')?.hidden===false);
    layer.parentElement?.classList.toggle('stage-map-cell',ready);
  }
