 if(!art||!geometry||geometry.width!==art.columns||geometry.height!==art.rows||!Array.isArray(geometry.terrain)||geometry.terrain.length!==art.rows||geometry.terrain.some(row=>typeof row!=='string'||row.length!==art.columns)||geometry.terrain.join('\n')!==art.terrainKey)return null;
