  if(!art || stageMapLoads.get(art.src)?.status==='failed' || !geometry)return null;
  const {x,y,width,height,terrain}=geometry;
  if(!Number.isInteger(x)||!Number.isInteger(y)||width!==art.columns||height!==art.rows||x<0||x>=width||y<0||y>=height)return null;
   const context=renderContext(geometry);
