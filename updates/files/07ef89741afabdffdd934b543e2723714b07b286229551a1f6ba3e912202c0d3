  const visited=new Set(),anchors=new Set(),width=terrain[0].length,height=terrain.length;
  for(let y=0;y<height;y++)for(let x=0;x<width;x++){
    const code=terrain[y][x],start=x+','+y;
    if(!['F','#'].includes(code)||visited.has(start))continue;
