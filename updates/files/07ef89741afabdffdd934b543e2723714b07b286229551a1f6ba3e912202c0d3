   return '<span class="terrain-art'+(ready?' terrain-art-ready stage-map-ready':'')+'" aria-hidden="true"'+presentationAttributes+'>'+(!deferred&&art?'<img class="terrain-art-image" data-terrain-asset="'+art.src+'" src="'+imageSource(art.src)+'" alt="" draggable="false" decoding="async" hidden>':'')+'</span>';
}

export function markTerrainUnavailable(source) {
  if(!knownSources.has(source))return false;
  unavailableSources.add(source);
  return true;
}

export function resetTerrainArtFailures() {
  unavailableSources.clear();
}

export function installTerrainArtFallback(root=globalThis.document) {
  if(!root?.addEventListener || installedRoots.has(root))return false;
  installedRoots.add(root);
  const imageFrom = event => {
    const image=event.target;
    return image?.classList?.contains('terrain-art-image') &&
      knownSources.has(image.dataset?.terrainAsset) ? image : null;
  };
  root.addEventListener('load',event=>{
    const image=imageFrom(event);
    if(!image || unavailableSources.has(image.dataset.terrainAsset))return;
    const layer=image.closest('.terrain-art');
    if(!layer)return;
    image.hidden=false;
    layer.classList.add('terrain-art-ready');
  },true);
  root.addEventListener('error',event=>{
    const image=imageFrom(event);
    if(!image || !markTerrainUnavailable(image.dataset.terrainAsset))return;
    const layer=image.closest('.terrain-art');
    if(layer?.dataset?.stageMap&&stageArt(layer.dataset.stageMap)){
      image.remove();
      if(stageMapLoads.get(layer.dataset.stageMapSource??stageArt(layer.dataset.stageMap)?.src)?.status!=='ready')layer.classList.remove('terrain-art-ready');
    }else layer?.remove();
  },true);
  return true;
}

