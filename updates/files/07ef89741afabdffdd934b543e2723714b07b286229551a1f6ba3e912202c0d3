  stageMapLoads.clear();
  sharedMapTextureLoader.clearCache();
  notifyStageMap(null);
}

export function terrainArtFor(code, scenarioId='',geometry=null) {
  if(code==='#'&&geometry?.mapLayoutVersion===4){
    const kind=mapBlockedKindV07421For(scenarioId,geometry,geometry.x,geometry.y),art=kind==='wall'?wallArt:kind==='cliff'?ACT2_TERRAIN_ART.rock:kind==='water'?TERRAIN_ART.water:null;
    return art&&!unavailableSources.has(art.src)?art:null;
  }
  if(code==='#'&&mapLayoutWallLabel(geometry,{id:scenarioId},geometry?.x,geometry?.y))return unavailableSources.has(wallArt.src)?null:wallArt;
  const expanded=expandedTerrain.get(scenarioId);
  if(expanded&&code==='#'&&expanded.blockedKind==='wall')return unavailableSources.has(wallArt.src)?null:wallArt;
  if(expanded&&code==='#'&&expanded.blockedKind==='rock')return unavailableSources.has(ACT2_TERRAIN_ART.rock.src)?null:ACT2_TERRAIN_ART.rock;
  const kind = code==='.' ? (scenarioId==='s06_xuzhou_fall' ? 'city-ground' : 'ground') : code==='F' ? (ACT3_STAGE_MAP_ART[scenarioId]?.coverKind==='woodenCargo'?'cargo':'forest') :
    code==='#' ? (scenarioId==='s06_xuzhou_fall' ? 'building' : scenarioId==='s10_thousand_li' ? 'rock' : ACT3_STAGE_MAP_ART[scenarioId]?.blockedKind??'water') : null;
  const art = kind ? (TERRAIN_ART[kind]??ACT2_TERRAIN_ART[kind]??ACT3_TERRAIN_ART[kind]) : null;
  return art && !unavailableSources.has(art.src) ? art : null;
}

// 완성 전장 그림이 없을 때만 쓰는 물-둑 연결이다. 인접한 물 사이에는 테두리를 만들지 않는다.
export function waterShoreFor(code,scenarioId='',geometry=null) {
  if(terrainArtFor(code,scenarioId,geometry)?.kind!=='water'||!geometry)return null;
  const {x,y,width,height,terrain}=geometry;
  if(!Number.isInteger(x)||!Number.isInteger(y)||!Number.isInteger(width)||!Number.isInteger(height)||width<1||height<1||x<0||y<0||x>=width||y>=height)return null;
   if(!(renderContext(geometry)||validGeometry(geometry))||terrain[y][x]!==code)return null;
  // 보드 밖으로 흐르는 물은 막지 않는다.
  const water=(nx,ny)=>nx<0||ny<0||nx>=width||ny>=height||(terrain[ny][nx]==='#'&&(geometry.mapLayoutVersion!==4||mapBlockedKindV07421For(scenarioId,geometry,nx,ny)==='water'));
  const north=water(x,y-1)?0:12,east=water(x+1,y)?0:12,south=water(x,y+1)?0:12,west=water(x-1,y)?0:12;
  return {north,east,south,west,northWest:north&&west?18:0,northEast:north&&east?18:0,southEast:south&&east?18:0,southWest:south&&west?18:0};
}

export function terrainHTML(code, scenarioId='',geometry=null) {
  const art=terrainArtFor(code,scenarioId,geometry);
  const crop=stageMapCropFor(code,scenarioId,geometry);
  if(!art&&!crop)return '';
  const ready=crop&&stageMapLoads.get(crop.sourceKey)?.status==='ready';
  const shore=waterShoreFor(code,scenarioId,geometry);
  const mapAttributes=crop?' data-stage-map="'+scenarioId+'" data-stage-map-source="'+crop.sourceKey+'" data-map-label="'+(crop.labelAnchor?'anchor':'secondary')+'"':'';
  // Legacy isolated consumers retain raster crops. The game uses shared:true,
  // leaving the persistent board background in charge of every full-map image.
  // No tile path generates or paints the full-map river SVG.
  const shared=!!crop&&geometry?.shared===true;
   const deferred=shared&&art;
  const images=crop&&!shared?(crop.overlaySrc?'url(\''+crop.overlaySrc+'\'),':'')+'url(\''+crop.src+'\')'+(crop.baseSrc?',url(\''+crop.baseSrc+'\')':''):'';
