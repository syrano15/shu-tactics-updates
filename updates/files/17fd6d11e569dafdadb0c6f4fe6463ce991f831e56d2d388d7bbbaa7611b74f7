   const spAmount=supportSPAmount(a,unit,id);
   results.push({spAmount,spBefore:unit.sp,spAfter:(unit.sp??0)+spAmount,id:unit.id,name:unit.name,amount:Math.min(amount,unit.maxHp-unit.hp),before:unit.hp,after:Math.min(unit.maxHp,unit.hp+amount),targetHp:Math.min(unit.maxHp,unit.hp+amount),hp:unit.hp,maxHp:unit.maxHp,kind:'support',...(id==='liubei-oath'?{buff:'공격 +15% · 사기 +10'}:id==='jianyong-relief'?{buff:'혼란·위보 해제 · 사기 +10'}:{})});continue;
