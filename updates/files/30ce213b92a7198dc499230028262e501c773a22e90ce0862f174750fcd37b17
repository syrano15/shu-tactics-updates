function battleEvents(stage,chapter,ids){
 const events=structuredClone(chapter.events),t=stage.act7Tactics;
 if(t!==undefined){
  assert(object(t)&&Object.keys(t).length===1,'서사 전술 목록');
  if(t.fireProhibited)assert(stage.id==='s51_wheat'&&t.fireProhibited===true,'보리밭 화공 금지');
  else if(t.stationary)assert(stage.id==='s54_seven_lamps'&&Object.keys(t.stationary).length===2&&t.stationary.unit==='zhugeliang'&&JSON.stringify(t.stationary.tile)==='[12,10]','칠성등 기도 자리');
  else if(t.commanderGate)assert(stage.id==='s56_changan'&&Object.keys(t.commanderGate).length===2&&t.commanderGate.unit==='e_boss'&&JSON.stringify(t.commanderGate.requiredDefeated)==='["e_west_gate","e_east_gate"]','장안 성문 개방');
  else assert(false,'알 수 없는 서사 전술');
