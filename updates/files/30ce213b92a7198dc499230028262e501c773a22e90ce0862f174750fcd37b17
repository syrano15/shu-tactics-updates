  const expectedId=ACT7_CHAPTER_IDS[index],d=story.chapters[index];
  assert(stage.id===expectedId&&!installedIds.has(stage.id)&&stage.no===index+46&&stage.act===7&&stage.combatProfile==='act2'&&stage.campaignLayoutVersion===1,'장 ID/순서/전투 프로필');
  const size=mapSize(stage.terrain,1);
  assert(Array.isArray(stage.size)&&stage.size[0]===size.width&&stage.size[1]===size.height&&size.width>=24&&size.width<=26&&size.height>=18&&size.height<=20,'맵 크기');
  const formation=stage.sortie;
  assert(object(formation)&&formation.fixed===false&&Array.isArray(formation.required)&&formation.required.length>=1&&formation.required.length<=formation.maxSortie&&unique(formation.required)&&Array.isArray(formation.unavailable)&&unique(formation.unavailable)&&formation.maxSortie===ACT7_SORTIE_CAPS[index]&&formation.regularSortie===formation.maxSortie&&!(formation.fixedGuests?.length),'정규/필수 편성');
  const prior=new Set([...CHAPTERS.map(ch=>ch.id),...ACT7_CHAPTER_IDS.slice(0,index)]);
  const owned=Object.values(HERO_DATA).filter(hero=>!hero.guest&&(hero.joinAfterChapter==='start'||prior.has(hero.joinAfterChapter))&&!prior.has(hero.leaveAfterChapter)).map(hero=>hero.id);
  assert(formation.required.every(id=>owned.includes(id)&&UNIT_TEMPLATES[id]?.playable&&!formation.unavailable.includes(id))&&formation.unavailable.every(id=>Object.hasOwn(HERO_DATA,id))&&owned.filter(id=>!formation.unavailable.includes(id)).length>=formation.maxSortie,'합류/출전 가능 장수');
  assert(Array.isArray(stage.allySlots)&&stage.allySlots.length===formation.maxSortie&&Array.isArray(stage.enemies)&&stage.enemies.length>=1&&Array.isArray(stage.extraAllies)&&stage.extraAllies.length<=4&&stage.allySlots.length+stage.enemies.length+stage.extraAllies.length<=80,'부대 수/정규 출발칸');
  const positions=stage.allySlots.map(tile=>[...tile]),ids=[...owned];
  const enemies=stage.enemies.map(enemy=>{
   const templateId='act7_'+enemy.template,base=templates[templateId];
   assert(base&&enemy.combatTier===base.combatTier&&(Object.hasOwn(FACTION_NAMES,enemy.faction)||enemy.faction==='nanman'),'적 원본/진영/등급');
