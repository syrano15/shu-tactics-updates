  for(const wave of reinforcements)assert(/^[a-z][a-z0-9_]*$/.test(wave.id)&&Array.isArray(wave.unitIds)&&wave.unitIds.length>=1&&wave.unitIds.length<=4&&wave.unitIds.every(id=>enemies.some(e=>e.id===id))&&wave.trigger?.type==='roundStart'&&integer(wave.trigger.round,1,99),'유한 증원 정의');
  const events=battleEvents(stage,d,ids);
  validateStoryEvents(events,ids,reinforcements.map(wave=>wave.id),stage.terrain);
  assert(stage.weatherStart===undefined||['clear','rain'].includes(stage.weatherStart),'초기 날씨');
  assert(integer(stage.act7EnemyGoldTotal,0,100000000)&&enemies.reduce((sum,enemy)=>sum+enemy.gold,0)===stage.act7EnemyGoldTotal,'전리금 합계');
  return {id:stage.id,contentVersion:1,aliases:[],title:d.title,location:d.location,subtitle:'7막 북벌 · '+d.title,act:7,combatProfile:'act2',rosterMode:'story',campaignLayoutVersion:1,lockRequired:true,positionLocked:stage.id==='s47_jieting'?['masu','wangping']:stage.id==='s54_seven_lamps'?['zhugeliang']:formation.required.filter(id=>id==='liubei'),...structuredClone(formation),act7SuggestedSortie:[...stage.act7SuggestedSortie],terrain:[...stage.terrain],allyPositions:structuredClone(stage.allySlots),enemies,extraAllies,...equipmentDropMetadata(stage,enemies,extraAllies),battleEventsVersion:1,...(reinforcements.length?{reinforcements}:{}),...(stage.weatherStart?{weatherStart:stage.weatherStart}:{}),...(stage.act7Tactics?{act7Tactics:structuredClone(stage.act7Tactics)}:{}),objective,defeat,brief:stage.brief,intermissionHint:stage.intermissionHint,blockedLabel:stage.blockedLabel,blockedKind:stage.blockedKind,bridgeCells:structuredClone(bridges),reward:structuredClone(stage.reward),art:structuredClone(stage.art),act7Objectives:structuredClone(stage.act7Objectives),act7OptionalObjective:structuredClone(stage.act7OptionalObjective),act7EnemyGoldTotal:stage.act7EnemyGoldTotal,era:d.era,actMap:d.actMap??'map_act7',fate:structuredClone(stage.fate??d.fate),bg:structuredClone(d.bg),bgm:structuredClone(d.bgm),victoryFx:structuredClone(d.victoryFx),episodeTitle:dialogue.episodeTitle,events,pre:structuredClone(d.pre),post:structuredClone(d.post),defeatDialogue:structuredClone(d.defeat),speakers:structuredClone(story.speakers),enemyLabel:'위군',campaignLayout:{version:1,width:size.width,height:size.height,enemyTotal:enemies.length,fronts:index===8?'막사 세 진입로·일곱 등불':index===9?'다리·상류 여울·하류 여울':index===10?'서문·중앙 성문·동문':'북벌 전열·후방 군수·우회 길목',renderer:'terrainTiles'}};
