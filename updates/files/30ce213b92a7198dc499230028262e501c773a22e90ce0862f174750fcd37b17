 return {name:value.name,han:value.name[0],cls:value.class,hpBonus:0,atkBonus:0,playable:false,generic:['troop','elite'].includes(value.combatTier),combatTier:value.combatTier,baseStats:{hp:value.troops,atk:value.attack,def:value.defense,int:value.intellect,move:value.move}};
}

