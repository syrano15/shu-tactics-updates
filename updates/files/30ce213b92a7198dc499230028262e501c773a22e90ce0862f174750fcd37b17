  const defeat=validateDefeat(stage.defeat,[...owned,...extraAllies.map(u=>u.id)].map(id=>({id,team:'ally'})));
  assert(defeat.every(rule=>formation.required.includes(rule.unit)||extraAllies.some(u=>u.id===rule.unit&&templates[u.templateId].nonCombat)),'보호 장수 필수 출전');
  assert(text(stage.brief)&&text(stage.intermissionHint)&&text(stage.blockedLabel)&&['rock','water','wall'].includes(stage.blockedKind),'전투/정비/지형 설명');
