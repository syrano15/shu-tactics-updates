  assert(/^[a-z][a-z0-9_]*$/.test(id),'적 원본 ID');
  templates['act7_'+id]=enemyTemplate(value);
 }
 assert(object(stages.extraAllyTemplates),'동행 원본 목록');
 for(const [id,value]of Object.entries(stages.extraAllyTemplates)){assert(/^[a-z][a-z0-9_]*$/.test(id),'동행 원본 ID');templates['act7_extra_'+id]=extraTemplate(value);}
 // Build and validate every new chapter before registering any new templates.
