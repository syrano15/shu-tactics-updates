 if(value.identity!==undefined)assert(HERO_DATA[value.identity]?.name===value.name&&HERO_DATA[value.identity]?.class===value.class&&value.calibration?.source==='createUnit'&&value.calibration.level===42&&value.calibration.promotion===2&&value.calibration.modifications===0&&value.calibration.gear===0,'첫 등장 동행 원형');
 return {name:value.name,han:value.name[0],cls:value.class,hpBonus:0,atkBonus:0,playable:false,extra:true,faction:'shu',...(value.nonCombat===true?{nonCombat:true}:{}),...(value.identity?{portraitIdentity:value.identity}:{}),baseStats:{hp:value.troops,atk:value.attack,def:value.defense,int:value.intellect,move:value.move}};
