  let done=false,manifestReady=false,deadline=null,poll=null;
  const requests=new Map();
  const clear=timer=>{if(timer!==null){clearTimeout(timer);state.timers.delete(timer);}};
  const finish=ready=>{
   if(done)return;done=true;clear(deadline);clear(poll);state.waiters.delete(finish);
   resolve(ready&&state.current());
  };
  state.waiters.add(finish);
  const current=()=>{
   if(done)return false;
   if(!state.current()){state.finish('stale');finish(false);return false;}
   return true;
  };
  const check=()=>{
   if(!current())return;
   for(const image of images){
    const src=image.src;
    if(!src||image.hidden||typeof image.decode!=='function'||requests.get(image)?.src===src)continue;
    const request={src,ready:false};requests.set(image,request);
    Promise.resolve().then(()=>{if(!done&&state.current())return image.decode();}).then(()=>{
     if(!current())return;
     if(image.src===src&&requests.get(image)===request){request.ready=true;settled();}
    },()=>{/* Existing per-image error handlers select the approved fallback. */});
   }
   settled();
  };
  const settled=()=>{
   if(!current()||!manifestReady)return;
   if(images.every(image=>!image.src||image.hidden||typeof image.decode!=='function'||requests.get(image)?.src===image.src&&requests.get(image).ready))finish(true);
  };
  const nextPoll=()=>{
   if(!current())return;check();if(done)return;
   poll=setTimeout(()=>{state.timers.delete(poll);poll=null;nextPoll();},50);state.timers.add(poll);
  };
  deadline=setTimeout(()=>{
   state.timers.delete(deadline);deadline=null;if(!current())return;
   const pending=images.filter(image=>image.src&&!image.hidden&&typeof image.decode==='function'&&!(requests.get(image)?.src===image.src&&requests.get(image).ready));
   timeoutFallback(pending,manifestReady);finish(true);
  },600);state.timers.add(deadline);
