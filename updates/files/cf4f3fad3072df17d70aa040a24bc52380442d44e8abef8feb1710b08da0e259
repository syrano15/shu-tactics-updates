export function setCombatPoseManifest(raw){
 const next={schemaVersion:1,units:{},classes:{}};
 if(!object(raw)||raw.schemaVersion!==1)return next;
 for(const group of ['units','classes'])for(const [key,record] of Object.entries(object(raw[group])?raw[group]:{})){
  if(!/^[a-z][a-z0-9_]*$/.test(key)||!object(record)||!localPath(record.src))continue;
  const {columns,rows,frames}=record;
  if(!Number.isInteger(columns)||columns<1||columns>8||!Number.isInteger(rows)||rows<1||rows>8||!object(frames))continue;
  const clean={};
  for(const pose of ['ready','attack','recover','hit','idle','retreat']){
   const frame=frames[pose];
   if(Number.isInteger(frame)&&frame>=0&&frame<columns*rows)clean[pose]=frame;
   else if(object(frame)&&validRect(frame.rect)&&(frame.offset===undefined||validOffset(frame.offset))){
    const bounds=sanitizeCombatVisibleBounds(frame.visibleBounds);
    const weaponTip=Array.isArray(frame.weaponTip)&&frame.weaponTip.length===2&&frame.weaponTip.every(value=>Number.isFinite(value)&&value>=0&&value<=1)?[...frame.weaponTip]:null;
    clean[pose]={rect:[...frame.rect],...(frame.offset?{offset:[...frame.offset]}:{}),...(bounds?{visibleBounds:bounds}:{}),...(weaponTip?{weaponTip}:{})};
   }
  }
  if(!Object.hasOwn(clean,'idle')&&!Object.hasOwn(clean,'ready'))continue;
  const displayHeight=sanitizeCombatDisplayHeight(record.displayHeight);
  next[group][key]={src:record.src,columns,rows,frames:clean,facing:record.facing==='left'?'left':'right',...(displayHeight===null?{}:{displayHeight}),...(Number.isFinite(record.bodyTop)&&record.bodyTop>=0&&record.bodyTop<.9?{bodyTop:record.bodyTop}:{})};
 }
 poseManifest=next;failedAtlases.clear();return next;
}

/** Optional art. Failed/missing manifests never delay an attack or change its outcome. */
export function loadCombatPoseManifest({fetcher=globalThis.fetch,url=new URL('./art/combat-v024/manifest.json',import.meta.url)}={}){
 if(manifestRequest)return manifestRequest;
 manifestRequest=(async()=>{
  if(typeof fetcher!=='function')return poseManifest;
  let timer,controller;
  try{
   controller=typeof AbortController==='function'?new AbortController():null;
   if(controller)timer=setTimeout(()=>controller.abort(),2500);
   const response=await fetcher(url,controller?{signal:controller.signal}:{});
   if(response.ok)return setCombatPoseManifest(await response.json());
  }catch{/* The approved existing art is the fallback. */}
  finally{clearTimeout(timer);}
  return poseManifest;
 })();
 return manifestRequest;
}

