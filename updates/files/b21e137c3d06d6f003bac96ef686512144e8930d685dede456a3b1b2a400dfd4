import {sortieInfo,positionLockedIndices} from './campaign.js';
import {deploymentSlots,validateDeploymentSlots} from './deployment.js';
import {deploymentRosterIds} from './preparation-roster.js';
const esc=value=>String(value??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
export const deploymentCoordinate=([x,y])=>String.fromCharCode(65+x)+(y+1);
export function deploymentHTML({chapter:ch,army,ids,formationSlots=null,units,selectedId,message='',spriteHTML,rankName,traitLabel,guestIds=[],blockedLabel='강',preparing=false}){
 const info=sortieInfo(ch,ids),slots=formationSlots?validateDeploymentSlots(ch,army,formationSlots):deploymentSlots(ch,army,ids),byId=Object.fromEntries(units.map(u=>[u.id,u])),name=id=>byId[id]?.name??id;
 const eligible=deploymentRosterIds(ch,army),visibleUnits=units.filter(unit=>eligible.includes(unit.id));
 if(selectedId&&!eligible.includes(selectedId))selectedId=visibleUnits.find(unit=>slots.includes(unit.id))?.id??visibleUnits[0]?.id??null;
 const selectedIndex=selectedId?slots.indexOf(selectedId):-1,fixed=index=>index>=0&&(index>=info.regularMax||positionLockedIndices(ch).includes(index));
 const chosen=selectedIndex>=0?(fixed(selectedIndex)?name(selectedId)+' · '+deploymentCoordinate(ch.allyPositions[selectedIndex])+' 위치 고정':name(selectedId)+' 선택됨 · 원하는 출발 칸을 누르면 이동하거나 위치를 교환합니다.'):'장수를 고르고 원하는 출발 칸을 선택하세요.';
 const cards=visibleUnits.map(unit=>{
  const id=unit.id,index=slots.indexOf(id),inSortie=index>=0,guest=info.fixedGuests.includes(id),required=ch.required.includes(id)||guest,blocked=ch.unavailable.includes(id)||army.heroes[id].departed,full=!inSortie&&info.regularCount>=info.regularMax,status=guest?'고정 동행':required?'필수':inSortie?'출전':'대기';
  return '<article class="deploy-card '+(inSortie?'in-sortie ':'')+(selectedId===id?'placing':'')+'"><button class="deploy-card-main" '+(inSortie?'data-deploy-select="'+esc(id)+'" aria-pressed="'+(selectedId===id)+'"':'data-deploy-unit="'+esc(id)+'"')+' '+(blocked||full?'disabled':'')+' aria-label="'+esc(unit.name)+' '+(inSortie?'배치 선택':'출전 추가')+'">'+(spriteHTML(unit)||'<span class="hero-placeholder">'+esc(unit.name.slice(0,1))+'</span>')+'<span><b>'+esc(unit.name)+' <small>Lv'+unit.level+'</small></b><small>'+esc(rankName(unit))+'</small><small>'+status+(fixed(index)?' · 고정':'')+(inSortie?' · '+deploymentCoordinate(ch.allyPositions[index]):'')+'</small></span></button>'+(inSortie&&!required?'<button class="deploy-remove" data-deploy-unit="'+esc(id)+'" aria-label="'+esc(unit.name)+' 출전 해제">대기</button>':'')+'</article>';
 }).join('');
 const cols=ch.terrain[0].length,rows=ch.terrain.length,map='<span class="deploy-axis"></span>'+Array.from({length:cols},(_,x)=>'<span class="deploy-axis">'+String.fromCharCode(65+x)+'</span>').join('')+ch.terrain.map((row,y)=>'<span class="deploy-axis">'+(y+1)+'</span>'+[...row].map((t,x)=>{
  const at=ch.allyPositions.findIndex(([sx,sy])=>sx===x&&sy===y),id=at>=0?slots[at]:null,e=ch.enemies.find(e=>e.position[0]===x&&e.position[1]===y),coordinate=deploymentCoordinate([x,y]),classes='deploy-cell '+(t==='F'?'forest':t==='#'?'river':'')+(at>=0?' spawn':'')+(e?' enemy':'')+(id?' occupied':'')+(id===selectedId&&id?' placing':'')+(fixed(at)?' locked':'');
  if(at>=0)return '<button class="'+classes+'" data-deploy-slot="'+at+'" data-grid-x="'+x+'" data-grid-y="'+y+'" aria-label="'+coordinate+' · '+esc(id?name(id):'빈 출발 칸')+(fixed(at)?' · 위치 고정':'')+'" aria-pressed="'+(!!id&&id===selectedId)+'" title="'+coordinate+' · '+esc(id?name(id):'공석')+'">'+(id?'<b>'+esc(name(id).slice(0,1))+'</b><small>'+esc(name(id))+'</small>':'<small>공석</small>')+(fixed(at)?'<span class="deploy-lock" aria-hidden="true">◆</span>':'')+'</button>';
  return '<span class="'+classes+'" title="'+coordinate+(e?' · 적 부대':'')+'" '+(e?'aria-label="적 부대"':'aria-hidden="true"')+'>'+(e?'적':t==='F'?'숲':t==='#'?esc(blockedLabel):'')+'</span>';
 }).join('')).join('');
 const composition=Object.entries(ids.reduce((counts,id)=>{const cls=byId[id]?.cls;counts[cls]=(counts[cls]??0)+1;return counts;},{})).map(([cls,count])=>esc(army.balance?.classes?.[cls]?.name??({infantry:'보병',cavalry:'기병',spear:'창병',archer:'활병',crossbow:'석궁병',strategist:'책사'})[cls])+' '+count).join(' · ');
 return '<div class="deployment-compact '+(ch.campaignLayoutVersion===1?'expanded-deployment':'')+'"><div class="deploy-top"><h3>출전 편성</h3><strong>정규 '+info.regularCount+' / '+info.regularMax+(info.fixedGuests.length?' + 고정 동행 '+info.fixedGuests.length:'')+'</strong><button class="quiet" data-deployment-details="open">편성 상세</button></div><div class="deployment-board-layout"><section class="prep-placement-map"><div class="deploy-map-scroll"><div class="deploy-map" role="group" aria-label="출발 위치 배치 지도" style="--deploy-columns:'+cols+';--deploy-rows:'+rows+';aspect-ratio:'+(cols+1)+' / '+(rows+1)+';grid-template-columns:18px repeat('+cols+',minmax(0,1fr));grid-template-rows:18px repeat('+rows+',minmax(0,1fr))">'+map+'</div></div></section><aside class="deployment-selection-panel"><span class="eyebrow">출발 위치</span><p id="deploy-selection" class="deploy-selection" role="status">'+esc(chosen)+'</p><div class="deployment-map-key"><span><i class="ally"></i>아군 출발 칸</span><span><i class="enemy"></i>적 부대</span><span>◆ 위치 고정</span></div><p class="deploy-key-help">장수 선택 → 출발 칸 선택 → 이동·교환<br>방향키로 칸 이동 · Enter 또는 Space로 배치</p></aside></div><section class="prep-placement-roster"><div class="deployment-roster-heading"><h4>출전 가능한 장수</h4><span>'+visibleUnits.length+'명 · 출전 '+slots.filter(Boolean).length+'명</span></div><div class="deployment-roster-track" role="group" aria-label="출전 장수 선택">'+cards+'</div></section><div class="deploy-actions"><p class="deploy-message" id="deploy-message" role="status">'+esc(message||(ids.length?'빈칸을 포함해 편성과 위치를 확인하세요.':'최소 한 명을 선택하세요.'))+'</p><button data-deploy="reset">기본 편성으로</button>'+(preparing?'':'<button data-deploy="confirm" class="primary" '+(ids.length?'':'disabled')+'>이 편성으로 출전 · '+ids.length+'명 →</button>')+'</div><dialog class="deployment-details-dialog" id="deployment-details-dialog" aria-labelledby="deployment-details-title"><div class="dialog-heading"><h3 id="deployment-details-title">편성 상세</h3><button data-deployment-details="close" aria-label="편성 상세 닫기">닫기</button></div><section class="prep-panel"><h4>편성 상태</h4><p><b>정규 '+info.regularCount+' / '+info.regularMax+'</b> · '+(ids.length?'출전 가능':'최소 한 명을 선택하세요.')+'</p><p>공석 '+(info.regularMax-info.regularCount)+'칸 · 필수 '+ch.required.length+'명 포함</p>'+(info.fixedGuests.length?'<p>고정 동행 '+info.fixedGuests.map(name).map(esc).join(' · ')+'</p>':'')+'</section><section class="prep-panel"><h4>선택한 장수</h4><p>'+esc(selectedId?name(selectedId):'장수를 선택하세요')+(selectedIndex>=0?' · '+deploymentCoordinate(ch.allyPositions[selectedIndex]):'')+'</p><small>'+esc(selectedId?traitLabel(selectedId):'필수 출전과 위치 고정은 별도입니다.')+'</small></section><section class="prep-panel"><h4>병과 구성</h4><p>'+composition+'</p></section></dialog></div>';
}
