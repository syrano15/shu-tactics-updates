import {sortieIds,sortieInfo,positionLockedIndices} from './campaign.js';
export function needsDeployment(ch){return !ch.fixed&&ch.required.length<ch.maxSortie;}
export function validateDraft(ch,army,ids){
 // Validate chapter constraints even when the user temporarily selects no units.
 sortieIds(ch,army);
 const info=sortieInfo(ch);
 if(!Array.isArray(ids)||ids.length>ch.maxSortie||new Set(ids).size!==ids.length||sortieInfo(ch,ids).regularCount>info.regularMax||[...ch.required,...info.fixedGuests].some(id=>!ids.includes(id))||ids.some(id=>!army.joined.includes(id)||army.heroes[id]?.departed||ch.unavailable.includes(id)))throw new Error('출전 편성을 확인하세요.');
 if(positionLockedIndices(ch).some(i=>ids[i]!==ch.required[i]))throw new Error('필수 장수의 배치 순서는 고정입니다.');
 return [...ids];
}
export function toggleDraft(ch,army,ids,id){
 validateDraft(ch,army,ids);
 if(ch.required.includes(id)||sortieInfo(ch).fixedGuests.includes(id))throw new Error('필수 장수와 고정 동행은 제외할 수 없습니다.');
 const next=ids.includes(id)?ids.filter(x=>x!==id):[...ids,id];
 return validateDraft(ch,army,next);
}
export function reorderDraft(ch,army,ids,index,step){
 const next=validateDraft(ch,army,ids),to=index+step;
 if(!Number.isInteger(index)||![-1,1].includes(step)||index<0||index>=next.length||to<0||to>=next.length)throw new Error('배치 순서를 바꿀 수 없습니다.');
 if(positionLockedIndices(ch).some(i=>i===index||i===to))throw new Error('필수 장수의 배치 순서는 고정입니다.');
 [next[index],next[to]]=[next[to],next[index]];return next;
}

// Direct placement uses the same compact order as saves and battle spawns.
export function swapDraft(ch,army,ids,from,to){
 const next=validateDraft(ch,army,ids);
 if(!Number.isInteger(from)||!Number.isInteger(to)||from<0||to<0||from>=next.length||to>=next.length)throw new Error('출전 장수가 있는 출발 칸을 선택하세요.');
 if(from===to)return next;
 if(positionLockedIndices(ch).some(i=>i===from||i===to))throw new Error('필수 장수의 출발 위치는 고정입니다. 다른 출발 칸을 선택하세요.');
 [next[from],next[to]]=[next[to],next[from]];
 return validateDraft(ch,army,next);
}


// Sparse slots are canonical for new formations; historical compact selections remain valid.
export function validateDeploymentSlots(ch,army,slots){
 const info=sortieInfo(ch);
 if(!Array.isArray(slots)||slots.length!==ch.maxSortie||Array.from(slots).some(id=>id!==null&&typeof id!=='string'))throw new Error('출발 위치 편성을 확인하세요.');
 const ids=validateDraft(ch,army,slots.filter(id=>id!==null));
 if(positionLockedIndices(ch).some(i=>slots[i]!==ch.required[i]))throw new Error('위치 고정 장수는 지정된 출발 칸을 유지해야 합니다.');
 if(info.fixedGuests.some((id,i)=>slots[info.regularMax+i]!==id)||slots.slice(0,info.regularMax).some(id=>info.fixedGuests.includes(id)))throw new Error('고정 동행의 출발 위치를 유지해야 합니다.');
 return [...slots];
}
export function deploymentSlots(ch,army,ids=null){
 // A new formation starts with mandatory officers and fixed companions only.
 // Explicit saved/selected identities keep their historical placement order.
 const info=sortieInfo(ch),chosen=validateDraft(ch,army,ids??[...ch.required,...info.fixedGuests]),slots=Array(ch.maxSortie).fill(null);
 chosen.filter(id=>!info.fixedGuests.includes(id)).forEach((id,i)=>slots[i]=id);
 info.fixedGuests.forEach((id,i)=>slots[info.regularMax+i]=id);
 return validateDeploymentSlots(ch,army,slots);
}
export function toggleDeploymentSlots(ch,army,slots,id){
 const next=validateDeploymentSlots(ch,army,slots),info=sortieInfo(ch);
 if([...ch.required,...info.fixedGuests].includes(id))throw new Error('필수 장수와 고정 동행은 제외할 수 없습니다.');
 const from=next.indexOf(id);
 if(from>=0)next[from]=null;
 else{const at=next.slice(0,info.regularMax).indexOf(null);if(at<0)throw new Error('출전 칸이 가득 찼습니다. 먼저 다른 장수를 대기시키세요.');next[at]=id;}
 return validateDeploymentSlots(ch,army,next);
}
export function moveDeploymentSlot(ch,army,slots,from,to){
 const next=validateDeploymentSlots(ch,army,slots),info=sortieInfo(ch);
 if(!Number.isInteger(from)||!Number.isInteger(to)||from<0||to<0||from>=info.regularMax||to>=info.regularMax||!next[from])throw new Error('정규 장수와 출발 칸을 선택하세요.');
 if(positionLockedIndices(ch).some(i=>i===from||i===to))throw new Error('필수 장수의 출발 위치는 고정입니다.');
 [next[from],next[to]]=[next[to],next[from]];return validateDeploymentSlots(ch,army,next);
}

// Selecting a waiting officer has no placement side effect. Only an explicit
// destination calls this function; an occupied optional slot returns to standby.
export function placeDeploymentSlot(ch,army,slots,id,to){
 const next=validateDeploymentSlots(ch,army,slots),info=sortieInfo(ch),from=next.indexOf(id);
 if(typeof id!=='string'||!id||!Number.isInteger(to)||to<0||to>=info.regularMax||info.fixedGuests.includes(id))throw new Error('정규 장수와 출발 칸을 선택하세요.');
 if(from===to)return next;
 if(from>=0)return moveDeploymentSlot(ch,army,next,from,to);
 if(positionLockedIndices(ch).includes(to))throw new Error('필수 장수의 출발 위치는 고정입니다.');
 if(next[to]&&ch.required.includes(next[to]))throw new Error('필수 장수는 대기시킬 수 없습니다. 다른 출발 칸을 선택하세요.');
 next[to]=id;return validateDeploymentSlots(ch,army,next);
}
