.on-title .masthead{display:none}
.title-scene{position:relative;isolation:isolate;min-height:100dvh;overflow:hidden;background:#111f1d}
.title-landscape{position:absolute;inset:0;z-index:-1;background:var(--title-art) center/cover no-repeat,radial-gradient(ellipse at 74% 35%,#aa91624d,transparent 45%),linear-gradient(140deg,#0b1d1b 8%,#253c36 60%,#667263)}
.title-landscape:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#0c1917ed 2%,#10221a80 50%,transparent 85%),linear-gradient(0deg,#0b1716,transparent 45%)}
.title-sun{position:absolute;top:16%;right:16%;width:clamp(110px,18vw,260px);aspect-ratio:1;border-radius:50%;background:#d5b47e80;box-shadow:0 0 90px #d5b47e22}
.ridge{position:absolute;bottom:10%;width:115%;height:52%;background:#283f39;clip-path:polygon(0 60%,12% 40%,22% 65%,39% 4%,51% 48%,63% 22%,78% 67%,87% 30%,100% 58%,100% 100%,0 100%)}
.ridge-back{bottom:22%;left:10%;opacity:.65;background:#506056}
.ridge-front{left:-8%;background:#192f2c}
.war-banner{position:absolute;right:19%;top:30%;border-left:6px solid #524d36;padding:28px 35px 60px;background:linear-gradient(100deg,#74664b,#3f4c37);clip-path:polygon(0 0,100% 6%,100% 100%,50% 88%,0 100%);color:#c7b890;font:700 clamp(60px,9vw,140px) var(--font-heading);transform:rotate(-7deg);box-shadow:0 20px 80px #0005}
.title-content{width:min(650px,70%);padding:clamp(65px,12vh,140px) 0 100px clamp(30px,9vw,150px)}
.title-kicker{color:#c8b891;font-size:12px;letter-spacing:5px}
#title-name{font:700 clamp(56px,7vw,106px)/1.3 var(--font-heading);letter-spacing:-.07em;color:#e8d8b3;margin:22px 0;text-shadow:0 5px 25px #0005;white-space:nowrap}
.title-rule{width:60px;height:2px;background:var(--gold);margin:28px 0}
.title-sub{font:16px var(--font-heading);color:#bec5b5;letter-spacing:1px;word-break:keep-all}
.title-menu{display:grid;gap:10px;max-width:300px;margin-top:55px}
.title-menu button{display:flex;align-items:center;justify-content:space-between;text-align:left;padding:15px 20px;border:1px solid #ac9b6f66;background:#10261e99;font-size:17px}
.title-menu button.primary{background:var(--gold);color:#17241c;border-color:var(--gold)}
.title-menu button:disabled{background:#273a30;color:#859383;border-color:#50614b;opacity:.7}
.title-menu button span{font-size:12px;opacity:.6}
.title-save-info{font-size:12px;color:#a4b3a0;max-width:340px;margin-top:18px}
.title-footer{position:absolute;bottom:25px;left:clamp(30px,9vw,150px);right:40px;display:flex;justify-content:space-between;font-size:10px;color:#8e9d8e;letter-spacing:2px;gap:15px}
.save-dialog{max-width:680px}
.save-slot{border:1px solid #465747;background:#122119;padding:17px;margin:12px 0}
.save-slot h4{color:var(--gold);margin:0;font-size:17px}
.save-slot p{margin:8px 0}.save-slot small{color:#a1b39e}
.save-slot>div{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.save-actions{display:flex;gap:10px;flex-wrap:wrap}
.import-label{display:block;border:1px solid #65775e;padding:9px 12px;cursor:pointer}
.import-label input{display:block;max-width:210px;font-size:11px;margin-top:6px}
.save-notice{font-size:12px;color:var(--gold);margin:0 0 10px;min-height:0}
.save-notice:empty{display:none}
#save-feedback{color:var(--gold)}
.masthead nav{flex-wrap:wrap}
@media(max-width:650px){.title-content{width:100%;padding:65px 28px 100px}.title-menu{max-width:300px}.war-banner{right:8%;top:20%;opacity:.45}.title-sun{right:5%}.title-landscape:after{background:linear-gradient(90deg,#0c1917ef,#10221a90)}.title-footer{left:28px;right:28px;font-size:9px;letter-spacing:0}.title-sub{font-size:14px}.title-kicker{letter-spacing:3px}#title-name{font-size:64px}}


/* Hide synthetic scenery only after the real backdrop has loaded successfully. */
.title-art-ready .title-sun,.title-art-ready .ridge,.title-art-ready .war-banner{display:none}
#title-name{position:relative;isolation:isolate}
.title-frame-art{position:absolute;inset:-12% -8%;width:116%;height:124%;object-fit:contain;object-position:center;pointer-events:none;z-index:-1}

/* Availability is visible before hover, including touch screens. Native disabled
   attributes still control all loading, missing-save and pending-write guards. */
.title-menu button:not(:disabled){background:#355443;border-color:#B6C6A4;color:#F8F1DE;opacity:1;font-weight:700}
.title-menu button:not(:disabled):hover{background:#406552;border-color:#E3DFC1}
.title-menu button.primary:not(:disabled){background:#E1BF7E;border-color:#E1BF7E;color:#17241C}
.title-menu button.primary:not(:disabled):hover{background:#F0D49C;border-color:#F0D49C}
.title-menu button:not(:disabled) span{opacity:1;color:inherit}
.title-menu button:disabled{background:#25342D;border-color:#647267;border-style:dashed;color:#A7B1A4;opacity:1;box-shadow:none;cursor:not-allowed}
.title-menu button:focus-visible,#save-dialog #save-current:focus-visible{outline:3px solid #F7E5B1;outline-offset:3px}
#save-dialog #save-current:not(:disabled){background:#E1BF7E;border-color:#E1BF7E;color:#17241C;opacity:1;font-weight:700}
#save-dialog #save-current:not(:disabled):hover{background:#F0D49C;border-color:#F0D49C}
#save-dialog #save-current:disabled{background:#25342D;border-color:#647267;border-style:dashed;color:#A7B1A4;opacity:1;cursor:not-allowed}
