// Distances run backwards from legal firing cells. Entering a forest is weighted
// in the forward direction, and occupied friendly cells allow transit but not landing.
function distancesToEnemyRange(s,u,target,anchor=null) {
  const costs=new Map(),queue=[];
  const passable=(x,y)=>inside(x,y,s)&&s.terrain[y][x]!=='#'&&(!occupant(s,x,y)||occupant(s,x,y).team===u.team);
  for(let y=0;y<s.terrain.length;y++)for(let x=0;x<s.terrain[0].length;x++) {
    const at=occupant(s,x,y);
    if(!passable(x,y)||(at&&at.id!==u.id)||(anchor&&distance({x,y},anchor)>DEFENSE_RADIUS)||!inRange({...u,x,y},target))continue;
    costs.set(key(x,y),0);queue.push({x,y,cost:0});
  }
  while(queue.length) {
    queue.sort((a,b)=>a.cost-b.cost||a.y-b.y||a.x-b.x);
    const p=queue.shift();if(p.cost!==costs.get(key(p.x,p.y)))continue;
    const enter=terrainMovementCost(s,u,p.x,p.y);
