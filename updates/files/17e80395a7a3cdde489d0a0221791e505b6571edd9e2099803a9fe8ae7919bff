function decideTacticalEnemy(s,u,supportPursuit=false) {
  const idle={x:u.x,y:u.y,targetId:null},order=enemyOrder(s,u),reserve=order?.advanceRound>s.round;
  const support=releasedCampaignDefender(s,u,order),post=order?.aiMode==='hold'?{x:order.position[0],y:order.position[1]}:null;
  const anchor=post&&!supportPursuit&&!(support&&distance(u,post)>DEFENSE_RADIUS)?post:null;
  const waitOrSupport=()=>anchor&&support&&!reserve&&!u.moved?decideTacticalEnemy(s,u,true):idle;
  const choices=[...(reserve||u.moved?new Map([[key(u.x,u.y),0]]):reachable(s,u))].map(([k,cost])=>{const [x,y]=k.split(',').map(Number);return {x,y,cost};})
    .filter(pos=>reserve||!anchor||distance(pos,anchor)<=DEFENSE_RADIUS);
  const opponents=s.units.filter(v=>v.hp>0&&v.team!==u.team&&(!v.protectedFromFaction||v.protectedFromFaction!==u.faction));
  const foes=opponents.filter(v=>!anchor||reserve||distance(v,anchor)<=DEFENSE_RADIUS+maxRange(u));
  if(!foes.length||!choices.length)return waitOrSupport();
  const positionRisk=enemyPositionRisk(s,u,opponents),attacks=[];
  for(const pos of choices) {
    const actor={...u,x:pos.x,y:pos.y,moved:u.moved||pos.x!==u.x||pos.y!==u.y};
    for(const target of foes) {
      if(!canTarget(actor,target))continue;
      for(const value of enemyTacticChoices(s,actor,target))attacks.push({pos,target,...value,score:value.score-positionRisk(pos)*.2});
    }
  }
  attacks.sort((a,b)=>Number(b.productive)-Number(a.productive)||Number(!!b.target.spirits?.wall)-Number(!!a.target.spirits?.wall)||Number(b.kill)-Number(a.kill)||b.score-a.score||a.pos.cost-b.pos.cost||a.target.id.localeCompare(b.target.id)||a.pos.y-b.pos.y||a.pos.x-b.pos.x);
  if(attacks.length) {
    const best=attacks[0];
    return {x:best.pos.x,y:best.pos.y,targetId:best.target.id,...(best.skill!=='fire'?{skill:best.skill}:{})};
  }
  if(reserve||u.moved)return idle;
  const stride=Math.max(1,movement(u,s)),approaches=[];
