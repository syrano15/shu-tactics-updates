  return approaches.length?{x:approaches[0].pos.x,y:approaches[0].pos.y,targetId:null}:waitOrSupport();
}

export function decideAI(s, u, forcedTargets = null, friendly = false) {
  if (disabled(u) || u.done || u.hp <= 0) return { x: u.x, y: u.y, targetId: null };
  if(huarongChaser(s,u))return decideHuarongEscape(s,u);
  if(campaignEnemyAI(s)&&u.team==='enemy'&&!friendly&&!forcedTargets)return decideTacticalEnemy(s,u);
  const enemyOrder=CHAPTERS[s.chapter]?.enemies.find(e=>e.id===u.id);
  const hold=!friendly&&u.team==='enemy'&&(enemyOrder?.aiMode==='hold'||isAct2Battle(s)&&enemyOrder?.advanceRound>s.round);
  const choices = [...(hold?new Map([[key(u.x,u.y),0]]):reachable(s, u))].map(([k, cost]) => { const [x, y] = k.split(',').map(Number); return { x, y, cost }; });
