    const paths=distancesToEnemyRange(s,u,target,anchor),before=paths.get(key(u.x,u.y))??Infinity;
    const tactics=enemyTacticChoices(s,{...u,moved:false},target);
    if(!tactics.length)continue;
    const value=Math.max(...tactics.map(choice=>choice.score));
    for(const pos of choices) {
      const remaining=paths.get(key(pos.x,pos.y))??Infinity;
