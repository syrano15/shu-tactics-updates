}
// Visible opponent movement and exact min/max range inform a position's risk.
// Attack plans still take a productive shot; this cannot create a retreat-only loop.
function enemyPositionRisk(s,u,opponents) {
  const threats=opponents.filter(foe=>!foe.nonCombat&&!disabled(foe));
  const cached=new Map();
  return pos=>{
    const cell=key(pos.x,pos.y);if(cached.has(cell))return cached.get(cell);
    const target={...u,x:pos.x,y:pos.y},hp=Math.max(1,u.hp);let risk=0;
    // Vacate the old cell and block the proposed cell before forecasting legal pursuit.
    const forecast={...s,units:s.units.map(unit=>unit.id===u.id?target:unit)};
    for(const foe of threats){
      const positions=[...reachable(forecast,foe)].map(([k])=>{const [x,y]=k.split(',').map(Number);return {x,y};});
      let worst=0;
      for(const at of positions){
        const actor={...foe,...at,moved:at.x!==foe.x||at.y!==foe.y};
        if(!canTarget(actor,target))continue;
        const skill=foe.cls==='strategist'&&s.weather.kind==='rain'?'confusion':'fire',p=preview(actor,target,s,skill),chance=p.chance??1;
        const value=skill==='confusion'?chance*150:chance*Math.min(hp,p.hit)/hp*550+(p.hit>=hp?chance*450:0);
