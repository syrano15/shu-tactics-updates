      const x=p.x+dx,y=p.y+dy;if(!passable(x,y))continue;
      const cost=p.cost+enter,k=key(x,y);if(cost>=(costs.get(k)??Infinity))continue;
      costs.set(k,cost);queue.push({x,y,cost});
    }
  }
