import {installCampaign,comparisonFromSearch} from './story-data.js';
import {loadAssetManifest} from './story-assets.js';
import {setTextCatalog} from './story-presentation.js';
import {activateExpandedCampaign} from './campaign-layout.js';
import {appendAct4} from './act4-campaign.js';
import {appendAct5} from './act5-campaign.js';
import {appendAct6} from './act6-campaign.js';
import {appendAct7} from './act7-campaign.js';
import {installAct7MapArt} from './act7-map-art.js';
import {installAct4MapArt} from './act4-map-art.js';
import {installAct5MapArt} from './act5-map-art.js';
import {installAct6MapArt} from './act6-map-art.js';
import {installAct2MapRefinement} from './act2-map-art.js';
import {installExpandedTerrainMetadata,registerExpandedStageMapArt} from './terrain-art.js';
import {installCampaignMapPresentation} from './campaign-map-presentation.js';
try{
 // This module defines presentation helpers but does not initialize the game.
 // Fetch its dependency graph while the unchanged campaign JSON is in flight;
 // artwork still initializes only after the campaign and asset manifest exist.
 const releaseModule=import('./release-ui.js');
 void releaseModule.catch(()=>{}); // The later await reports failure through the existing boot error UI.
 const names=['stages-act1.json','dialogue-act1-v3.json','text-heroes.json','text-stages.json','text-glossary.json','stages-act2.json','dialogue-act2-v3.json','stages-act3.json','dialogue-act3-v3.json','stages-act4.json','dialogue-act4-playable-v040.json','stages-act5.json','dialogue-act5-v3.json','stages-act6.json','dialogue-act6-v3.json','stages-act7.json','dialogue-act7-v3.json'];
 const docs=await Promise.all(names.map(async name=>{
  const response=await fetch(new URL('./data/'+name,import.meta.url));
  if(!response.ok)throw new Error('데이터를 읽지 못했습니다: '+name);
  return response.json();
 }));
 const comparison=comparisonFromSearch(globalThis.location?.search??'');
 installCampaign(docs[0],docs[1],docs[5],docs[6],{comparison,act3:docs[7],dialogue3:docs[8]});
 if(!comparison){
  const expanded=activateExpandedCampaign();
  appendAct4(docs[9],docs[10]);
  appendAct5(docs[11],docs[12]);
  appendAct6(docs[13],docs[14]);
  appendAct7(docs[15],docs[16]);
  installExpandedTerrainMetadata(expanded);
  const fleet=expanded.find(ch=>ch.id==='s15_chibi');
  registerExpandedStageMapArt({id:fleet.id,src:'art/act3/maps/s15_chibi-v039.webp',width:2200,height:1600,columns:22,rows:16,terrainKey:fleet.terrain.join('\n'),blockedKind:'water',coverKind:'woodenCargo'});
  await installCampaignMapPresentation(expanded.filter(ch=>ch.act<=3),registerExpandedStageMapArt);
  installAct2MapRefinement(expanded,registerExpandedStageMapArt);
  installAct4MapArt(expanded,registerExpandedStageMapArt);
  installAct5MapArt(expanded,registerExpandedStageMapArt);
  installAct6MapArt(expanded,registerExpandedStageMapArt);
  installAct7MapArt(expanded,registerExpandedStageMapArt);
 }
 setTextCatalog({heroes:docs[2],stages:docs[3],glossary:docs[4]});
 await loadAssetManifest();
 const {initializeTitleArtwork}=await releaseModule;
 initializeTitleArtwork();
 await import('./app.js');
}catch(error){
 document.getElementById('title-save-info').textContent='여정 데이터 오류: '+error.message;
 document.querySelectorAll('.title-menu button').forEach(button=>button.disabled=true);
 console.error(error);
}
