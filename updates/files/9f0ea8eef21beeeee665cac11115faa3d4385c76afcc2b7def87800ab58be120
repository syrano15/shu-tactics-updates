/* v0.26 — silhouette contact and result anchors keep the fixed battlefield. */
.combat.combat-scene-host,.combat-scene-host{position:fixed;inset:auto;top:50%;left:50%;right:auto;bottom:auto;margin:0;transform:translate(-50%,-50%);width:min(860px,calc(100vw - 24px));max-width:none;height:auto;max-height:calc(100dvh - 24px);padding:0;overflow:hidden;border:1px solid #a88e50;background:#101711;color:#e8e2cb;box-shadow:0 24px 100px #000c}
.combat-scene-host,.combat-map-host{display:block;grid-template-rows:none;gap:0}
dialog.combat:not([open]){display:none}
.combat-scene-host::backdrop{background:#020906c9;backdrop-filter:none}
.combat-scene{--combat-speed:1;--combat-sprite-size:240px;--combat-dodge-distance:64px;position:relative;width:100%;height:min(560px,calc(100dvh - 24px));display:grid;grid-template-rows:50px minmax(0,1fr) 86px 82px;overflow:hidden;isolation:isolate;background:#111c16;font-family:inherit}
.combat-scene::after{content:"";position:absolute;inset:6px;border:1px solid #e5c77c38;pointer-events:none;z-index:12}
.combat-scene-heading{position:relative;display:flex;align-items:center;justify-content:space-between;padding:0 24px;gap:12px;min-width:0;background:linear-gradient(90deg,#13291c,#09150f);border-bottom:1px solid #b29b6455;z-index:11}
.combat-scene-label{color:#d8c68f;font-size:18px;letter-spacing:.2em;font-weight:700}
.combat-scene-skip{font:inherit;font-size:12px;padding:7px 12px;white-space:nowrap;border:1px solid #b59b5866;color:#d8c993;background:#101a15;cursor:pointer;border-radius:2px}
.combat-scene-skip:hover,.combat-scene-skip:focus-visible{background:#2b3320;outline:2px solid #cdbb75;outline-offset:2px}
.combat-scene-field{position:relative;min-height:0;overflow:hidden;background:linear-gradient(#243b2c,#27291c 70%,#131c16);isolation:isolate}
.combat-scene-background{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.76) saturate(.7);opacity:.92;z-index:-3}
.combat-scene-vignette{position:absolute;inset:0;background:linear-gradient(#09150dbb,transparent 35%,#07120c66),radial-gradient(ellipse at 50% 60%,transparent 25%,#051009a8);z-index:-2;pointer-events:none}
.combat-scene-field::after{content:"";position:absolute;bottom:7%;left:8%;right:8%;height:1px;background:linear-gradient(90deg,transparent,#d4bc7555,transparent);pointer-events:none}
.combat-scene-huds{position:relative;display:flex;justify-content:space-between;padding:12px 20px;gap:20px;z-index:7;pointer-events:none}
.combat-hud{width:34%;max-width:270px;min-width:0;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:5px 8px;align-items:baseline;text-shadow:0 2px 4px #000}
.combat-hud strong{font-size:17px;color:#ede5c9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.combat-scene-hp{font-variant-numeric:tabular-nums;font-size:12px;white-space:nowrap;color:#e0dbb7}
.combat-hp-track{display:block;grid-column:1/-1;width:100%;height:8px;border:1px solid #ab985570;background:#090d09c9;box-shadow:0 1px 6px #0007;overflow:hidden}
.combat-hp-fill{display:block;height:100%;background:linear-gradient(90deg,#477653,#b0c178);transition:width calc(.04s * var(--combat-speed)) linear}
.combat-hud-target .combat-hp-fill{background:linear-gradient(90deg,#925c47,#ce9471)}
.combat-hud.is-ally .combat-hp-fill{background:linear-gradient(90deg,#477653,#b0c178)}
.combat-hud.is-enemy .combat-hp-fill{background:linear-gradient(90deg,#925c47,#ce9471)}
.combat-hp-fill.is-low{background:linear-gradient(90deg,#8d312c,#cb7151)}
.combat-combatant{position:absolute;width:var(--combat-sprite-size);height:calc(var(--combat-sprite-size) + 26px);bottom:20px;margin:0;transform:translateX(-50%);z-index:2;transform-origin:center bottom}
.combat-actor{left:27%}.combat-target{left:73%}
.combat-sprite-crop{display:block;position:absolute;bottom:26px;left:50%;width:var(--combat-sprite-size);height:var(--combat-sprite-size);overflow:hidden;transform:translateX(-50%);isolation:isolate;filter:drop-shadow(0 5px 3px #0008)}
.combat-sprite-crop.is-mirrored{transform:translateX(-50%) scaleX(-1)}
.combat-scene-sprite{display:block;position:absolute;width:100%;height:100%;left:0;top:0;object-fit:contain;object-position:center bottom;image-rendering:auto;max-width:none;user-select:none}
.combat-sprite-crop.is-atlas .combat-scene-sprite{object-fit:fill;image-rendering:auto}
.combat-palette-shu{filter:url(#cloth-shu)}.combat-palette-wu{filter:url(#cloth-wu)}.combat-palette-yellow{filter:url(#cloth-yellow)}.combat-palette-dong{filter:url(#cloth-dong)}.combat-palette-cao{filter:url(#cloth-cao)}.combat-palette-lu{filter:url(#cloth-lu)}
.combat-troop-strategist.combat-palette-shu{filter:url(#cloth-strategist-shu)}.combat-troop-strategist.combat-palette-wu{filter:url(#cloth-strategist-wu)}
.combat-ground-shadow{position:absolute;width:72%;height:22px;bottom:18px;left:14%;border-radius:50%;background:#0008;filter:blur(5px);transform:scaleY(.6)}
.combat-unit-name{position:absolute;bottom:0;left:0;width:100%;height:25px;text-align:center;font-size:13px;letter-spacing:.08em;color:#e4dcb7;text-shadow:0 2px 3px #000;font-weight:700}
.combat-fallback-crest{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:grid;place-items:center;width:90px;height:150px;border:1px solid #ab925566;color:#c2b687;background:linear-gradient(#24382a,#111e15);font-size:42px;clip-path:polygon(20% 0,80% 0,100% 20%,90% 100%,10% 100%,0 20%)}
.combat-fallback-crest[hidden],.combat-scene-sprite[hidden]{display:none}
.combat-combatant.is-attacking{animation:combat-approach calc(var(--combat-strike-duration,.3s) * var(--combat-speed)) cubic-bezier(.22,.65,.3,1) both;z-index:4}
.combat-combatant.is-attacking.is-contact{animation:none;transform:translateX(-50%) translateX(calc(var(--combat-direction) * var(--combat-body-travel,0px)))}
.combat-combatant.is-attacking.is-recovering{animation:combat-recover calc(var(--combat-recovery-duration,.16s) * var(--combat-speed)) ease-out both}
.combat-combatant.is-hit{animation:combat-recoil calc(.28s * var(--combat-speed)) ease-out both}.combat-combatant.is-critical-hit{animation-name:combat-critical-recoil;animation-duration:calc(.32s * var(--combat-speed))}
.combat-combatant.is-dodging{animation:combat-dodge calc(.42s * var(--combat-speed)) cubic-bezier(.12,.86,.26,1) both}
.combat-combatant.is-retreating{animation:combat-retreat calc(.3s * var(--combat-speed)) ease-out both;opacity:.28}
.combat-scene-cue{position:absolute;top:37%;left:50%;transform:translateX(-50%);width:max-content;max-width:min(220px,48%);text-align:center;line-height:1.1;overflow-wrap:anywhere;z-index:8;font-weight:800;font-size:32px;letter-spacing:.06em;color:#eed9a3;text-shadow:0 3px 8px #000,0 0 14px #000;pointer-events:none;min-height:42px}
.combat-scene-cue.is-landed{animation:combat-number calc(.25s * var(--combat-speed)) ease-out both}
.combat-scene-cue.is-miss{color:#ccdbd3;font-size:27px}
.combat-scene-cue.is-critical{color:#ff6b62;font-size:52px;font-weight:950;text-shadow:0 2px 3px #180300,0 0 12px #580900}
.combat-critical-label{display:block;font-size:15px;line-height:1.35;font-weight:900;letter-spacing:.06em}.combat-critical-number{display:block;font-size:inherit;font-weight:950;font-variant-numeric:tabular-nums;letter-spacing:.01em}
.combat-scene-cue.is-finished{opacity:.7}
.combat-scene-field.is-hit-impact{animation:combat-impact calc(.16s * var(--combat-speed)) ease-out both}
.combat-scene-lines{position:relative;display:flex;flex-direction:column;justify-content:center;gap:4px;min-width:0;min-height:0;overflow:auto;padding:8px 26px;background:linear-gradient(90deg,#091710,#14231a,#091710);border-top:1px solid #967e4a55;border-bottom:1px solid #967e4a55;z-index:9}
.combat-scene-line{display:flex;align-items:baseline;gap:14px;margin:0;line-height:1.65;font-size:15px;color:#e5dfc8;min-width:0}
.combat-scene-line strong{flex:0 0 84px;max-width:100px;color:#c7ae6b;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.combat-scene-line span{overflow-wrap:anywhere;word-break:keep-all;min-width:0}
.combat-scene-silent{font-size:13px;color:#9aab98;justify-content:center;letter-spacing:.1em}
.combat-scene-footer{position:relative;display:flex;flex-direction:column;justify-content:center;gap:7px;margin:0;border:0;padding:10px 26px;min-height:0;overflow:hidden;background:#08130e;z-index:9}
.combat-scene-phase{font-size:14px;letter-spacing:.1em;color:#ceb978}
.combat-scene-detail{margin:0;font-size:12px;color:#b7c0aa;line-height:1.5;max-height:36px;overflow:auto;word-break:keep-all}
.combat-scene-cutin{position:absolute;top:28%;left:0;right:0;height:138px;display:grid;grid-template-columns:180px 1fr;grid-template-rows:1fr 1fr;align-items:end;column-gap:22px;padding:0 28px;background:linear-gradient(90deg,#1f392eed,#0a1b11f2 65%,#102c1fd9);border-top:1px solid #c4a660;border-bottom:1px solid #c4a660;box-shadow:0 5px 35px #0008;z-index:10;animation:combat-cutin calc(.18s * var(--combat-speed)) ease-out both;pointer-events:none}
.combat-cutin-frame{position:relative;width:138px;height:138px;overflow:hidden;grid-row:1/3;background:#15251f}
.combat-cutin-frame img{position:absolute;max-width:none;object-fit:fill}
.combat-scene-cutin>strong{font-size:30px;color:#e0c686;letter-spacing:.12em;align-self:end;padding-bottom:4px;text-shadow:0 2px 6px #000}
.combat-scene-cutin>span:not(.combat-cutin-frame){font-size:14px;letter-spacing:.08em;align-self:start;padding-top:5px;color:#c1d1bc}
.combat-effect{position:absolute;inset:0;z-index:5;pointer-events:none;overflow:hidden}
.combat-weapon-streak{position:absolute;left:var(--impact-x);top:var(--impact-y,48%);width:120px;height:120px;transform:translate(-50%,-50%) rotate(-25deg);border-radius:50%;border:7px solid transparent;border-right-color:#ffe1a8;border-top-color:#ffe1a899;filter:drop-shadow(0 0 8px #f2ac55);animation:combat-saber-trail calc(var(--combat-strike-duration,.3s) * var(--combat-speed)) linear both}
.combat-effect-glaive .combat-weapon-streak{width:165px;height:165px;border-width:9px}
.combat-effect-mounted-slash .combat-weapon-streak{width:140px;height:140px;border-width:8px}
.combat-effect-thrust .combat-weapon-streak,.combat-effect-charge .combat-weapon-streak{width:180px;height:5px;border:0;border-radius:0;transform:translate(-50%,-50%);background:linear-gradient(90deg,transparent,#e8d2a1,#fff4cf);animation:combat-spear-tip calc(var(--combat-strike-duration,.3s) * var(--combat-speed)) linear both}
.combat-effect-thrust.is-posed-thrust .combat-weapon-streak{width:96px;height:3px;animation:combat-spear-tip calc(var(--combat-strike-duration,.3s) * var(--combat-speed)) linear both}
.combat-effect-slash.is-posed-attack .combat-weapon-streak{animation:combat-saber-trail calc(var(--combat-strike-duration,.3s) * var(--combat-speed)) linear both}
.combat-effect-arrow.is-posed-attack .combat-projectile{animation-duration:calc(var(--combat-strike-duration,.5s) * var(--combat-speed))}
.combat-effect-arrow.is-posed-attack .combat-projectile-track{animation-duration:calc(var(--combat-strike-duration,.5s) * var(--combat-speed))}
.combat-effect-mounted-thrust .combat-weapon-streak,.combat-effect-halberd .combat-weapon-streak{width:200px;height:7px;border:0;border-radius:0;transform:translate(-50%,-50%);background:linear-gradient(90deg,transparent,#d1c497,#fff1bb);animation:combat-spear-tip calc(var(--combat-strike-duration,.3s) * var(--combat-speed)) linear both}
.combat-effect-halberd .combat-weapon-streak::after{content:"";position:absolute;right:4px;top:-13px;width:24px;height:32px;border-right:5px solid #f2ddb1;border-radius:50%}
.combat-projectile-track{position:absolute;left:var(--projectile-start);top:var(--projectile-start-y,62%);animation:combat-projectile-travel calc(.55s * var(--combat-speed)) calc(var(--bolt-delay,0s) * var(--combat-speed)) ease-in-out both;will-change:transform}
.combat-projectile{position:absolute;left:0;top:0;width:42px;height:3px;background:linear-gradient(90deg,#5d4022,#e8d5a0);box-shadow:0 0 5px #f9d88c66;animation:combat-arrow calc(.55s * var(--combat-speed)) calc(var(--bolt-delay,0s) * var(--combat-speed)) ease-in-out both;transform-origin:center;will-change:transform,translate}
.combat-projectile::after{content:"";position:absolute;right:-5px;top:-3px;border-left:8px solid #e0d1ab;border-top:4px solid transparent;border-bottom:4px solid transparent}
.combat-effect-bolts .combat-projectile{height:2px;width:28px;animation-name:combat-bolt}
.combat-effect-bolts .combat-projectile-track:nth-child(2){margin-top:-8px}.combat-effect-bolts .combat-projectile-track:nth-child(3){margin-top:8px}
.combat-flame{position:absolute;left:calc(var(--impact-x) + (var(--flame-index) - 2) * 17px);top:calc(var(--impact-y,60%) - 52px);width:38px;height:86px;transform:translateX(-50%);background:radial-gradient(ellipse at 50% 80%,#fff0ab,#efa040 35%,#b6301999 68%,transparent 70%);border-radius:70% 30% 60% 40%;filter:drop-shadow(0 0 8px #ef601999);animation:combat-flame calc(.55s * var(--combat-speed)) calc(var(--flame-index) * .045s * var(--combat-speed)) ease-out both}
.combat-status-mark{position:absolute;left:var(--impact-x);top:var(--impact-y,47%);font-style:normal;font-size:34px;font-weight:bold;color:#bdc99c;text-shadow:0 0 12px #335644;animation:combat-orbit calc(.8s * var(--combat-speed)) calc(var(--mark-index) * -.16s) ease-in-out both}
.combat-effect-deception .combat-status-mark{color:#c8a3cb;text-shadow:0 0 16px #4b2853;animation-name:combat-rumor}
.combat.combat-map-host,.combat-map-host{position:fixed;inset:auto auto 86px 50%;transform:translateX(-50%);width:min(680px,calc(100vw - 24px));max-width:none;height:auto;max-height:none;margin:0;padding:0;overflow:hidden;border:1px solid #947c43;background:#091710ef;color:#e6debd;box-shadow:0 8px 30px #0009;z-index:30}
.combat-map-toast{--combat-speed:1;min-width:0;max-height:260px;overflow:hidden}
.combat-map-toast .combat-scene-heading{padding:7px 15px}.combat-map-toast .combat-scene-label{font-size:12px}
.combat-map-toast .combat-scene-skip{font-size:11px;padding:3px 9px}
.combat-map-result{margin:10px 16px 0;font-size:14px;line-height:1.55;color:#e6dab5;max-height:108px;overflow:auto}
.combat-map-strike{margin:0}.combat-map-strike-value{display:inline-block;vertical-align:middle}.combat-map-strike.is-critical{color:#ff6b62;font-weight:900}.combat-map-strike.is-critical .combat-critical-number{font-size:26px}.combat-map-strike.is-critical .combat-critical-label{font-size:12px}
.combat-map-toast .combat-scene-huds{padding:9px 16px 12px}.combat-map-toast .combat-hud{width:46%;max-width:none}
.combat-map-toast .combat-hud strong{font-size:12px}.combat-map-toast .combat-scene-hp{font-size:10px}.combat-map-toast .combat-hp-track{height:5px}
.combat-map-toast .combat-scene-lines{padding:4px 16px 9px;max-height:96px;background:none;border:0}
.combat-map-toast .combat-scene-line{font-size:12px;gap:8px}.combat-map-toast .combat-scene-line strong{flex-basis:62px}
@keyframes combat-approach{from{transform:translateX(-50%)}72%{transform:translateX(-50%) translateX(calc(var(--combat-direction) * var(--combat-body-travel,0px) * .94))}to{transform:translateX(-50%) translateX(calc(var(--combat-direction) * var(--combat-body-travel,0px)))}}
@keyframes combat-recover{from{transform:translateX(-50%) translateX(calc(var(--combat-direction) * var(--combat-body-travel,0px)))}to{transform:translateX(-50%)}}
@keyframes combat-spear-tip{0%,56%{opacity:0;transform:translate(-50%,-50%) scaleX(.2)}82%{opacity:.7}100%{opacity:.9;transform:translate(-50%,-50%) scaleX(var(--combat-direction))}}
@keyframes combat-saber-trail{0%,56%{opacity:0;transform:translate(-50%,-50%) rotate(-100deg) scale(.7)}85%{opacity:.9}100%{opacity:0;transform:translate(-50%,-50%) rotate(40deg) scale(1.1)}}
@keyframes combat-bow-release{0%{transform:translateX(-50%)}30%{transform:translateX(-50%) translateX(calc(var(--combat-direction) * -4px))}100%{transform:translateX(-50%)}}
@keyframes combat-aim{0%,100%{transform:translateX(-50%)}45%{transform:translateX(-50%) translateY(-5px)}}
@keyframes combat-recoil{0%{transform:translateX(-50%)}16%{transform:translateX(-50%) translateX(calc(var(--combat-direction) * var(--combat-recoil-distance,16px) * -1))}44%{transform:translateX(-50%) translateX(calc(var(--combat-direction) * var(--combat-recoil-distance,16px) * -.65))}100%{transform:translateX(-50%)}}
@keyframes combat-dodge{0%{transform:translateX(-50%)}20%,42%{transform:translateX(-50%) translateX(calc(var(--combat-direction) * var(--combat-dodge-distance) * -1))}74%{transform:translateX(-50%) translateX(calc(var(--combat-direction) * var(--combat-dodge-distance) * -.25))}100%{transform:translateX(-50%)}}
@keyframes combat-retreat{to{transform:translateX(-50%) translateX(calc(var(--combat-direction) * -42px));opacity:.28}}
@keyframes combat-number{from{opacity:0;transform:translateX(-50%) translateY(10px) scale(.88)}to{opacity:1;transform:translateX(-50%)}}
@keyframes combat-impact{16%,52%{transform:translateX(-2px)}32%,68%{transform:translateX(2px)}100%{transform:none}}
@keyframes combat-cutin{from{opacity:0;transform:translateX(-24px)}to{opacity:1;transform:none}}
@keyframes combat-slash{0%{opacity:0;transform:translate(-50%,-50%) rotate(-100deg) scale(.6)}40%{opacity:.9}100%{opacity:0;transform:translate(-50%,-50%) rotate(40deg) scale(1.2)}}
@keyframes combat-thrust{0%{opacity:0;transform:translate(-50%,-50%) scaleX(.2)}45%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) scaleX(1.2)}}
/* Independent X and Y transforms retain the original whole-flight X easing
   and the arrow's two-part vertical arc without animating layout coordinates. */
@keyframes combat-projectile-travel{from{transform:translateX(0)}to{transform:translateX(calc(var(--projectile-end) - var(--projectile-start)))}}
@keyframes combat-arrow{0%{translate:0 0;opacity:0;transform:scaleX(var(--combat-direction)) rotate(-25deg)}15%{opacity:1}50%{translate:0 calc((var(--impact-y) - var(--projectile-start-y)) / 2 - var(--projectile-arc,45px))}90%{opacity:1}100%{translate:0 calc(var(--impact-y) - var(--projectile-start-y));opacity:0;transform:scaleX(var(--combat-direction)) rotate(25deg)}}
@keyframes combat-bolt{0%{translate:0 0;opacity:0;transform:scaleX(var(--combat-direction))}15%,85%{opacity:1}100%{translate:0 calc(var(--impact-y) - var(--projectile-start-y));opacity:0;transform:scaleX(var(--combat-direction))}}
@keyframes combat-flame{from{opacity:0;transform:translateX(-50%) translateY(35px) scale(.4)}40%{opacity:.95}to{opacity:0;transform:translateX(-50%) translateY(-25px) scale(1.3)}}
@keyframes combat-orbit{0%{opacity:0;transform:translate(-50%,-20px) scale(.7)}40%{opacity:1;transform:translate(calc(-50% + (var(--mark-index) - 1) * 35px),-45px)}100%{opacity:0;transform:translate(-50%,10px)}}
@keyframes combat-rumor{0%{opacity:0;transform:translate(-50%,15px)}45%{opacity:.9;transform:translate(calc(-50% + (var(--mark-index) - 1) * 30px),-25px)}100%{opacity:0;transform:translate(-50%,-55px)}}
@media(max-width:620px){
 .combat-scene{--combat-sprite-size:160px;--combat-dodge-distance:44px;height:min(620px,calc(100dvh - 24px));grid-template-rows:48px minmax(0,1fr) 104px 94px}
 .combat-scene-heading{padding:0 14px}.combat-scene-label{font-size:15px}.combat-scene-skip{padding:7px 8px;font-size:11px}
 .combat-scene-huds{padding:13px 12px;gap:12px}.combat-hud{width:44%;grid-template-columns:1fr;gap:3px}.combat-hud strong{font-size:15px}.combat-scene-hp{font-size:11px}.combat-hp-track{height:7px}
 .combat-combatant{bottom:32px}.combat-actor{left:25%}.combat-target{left:75%}
 .combat-scene-lines{padding:8px 15px;gap:5px}.combat-scene-line{font-size:13px;gap:9px}.combat-scene-line strong{flex-basis:56px;max-width:62px}
 .combat-scene-footer{padding:10px 15px}.combat-scene-detail{font-size:11px;max-height:44px}.combat-scene-cue{font-size:25px;top:42%}.combat-scene-cue.is-critical{font-size:39px}.combat-critical-label{font-size:12px}
 .combat-scene-cutin{height:116px;grid-template-columns:120px 1fr;column-gap:14px;padding:0 15px}.combat-cutin-frame{width:116px;height:116px}.combat-scene-cutin>strong{font-size:24px}.combat-scene-cutin>span:not(.combat-cutin-frame){font-size:12px}
 .combat-map-host{bottom:78px}.combat-map-result{font-size:12px}.combat-map-toast .combat-scene-huds{padding-top:6px}.combat-map-toast .combat-hud{grid-template-columns:1fr}
}
