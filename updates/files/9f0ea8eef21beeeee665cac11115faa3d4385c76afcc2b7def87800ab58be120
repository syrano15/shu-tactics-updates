.combat-effect-water .combat-cast-mote{border-color:#a7dfe8;background:#80c3d638;box-shadow:0 0 9px #7abfcd44}
.combat-water-ring{position:absolute;left:var(--impact-x);top:var(--impact-y);width:82px;height:34px;border:3px solid #bce4e5;border-radius:50%;background:radial-gradient(ellipse,#a6d8df66,transparent 68%);animation:combat-water-ring calc(.4s * var(--combat-speed)) ease-out both}
.combat-water-drop{position:absolute;left:calc(var(--impact-x) + (var(--water-index) - 2) * 16px);top:var(--impact-y);width:10px;height:22px;border-radius:60% 40% 60% 40%;background:linear-gradient(#e1f2eb,#6ca5bb);animation:combat-water-drop calc(.35s * var(--combat-speed)) ease-out both}
@keyframes combat-water-ring{from{opacity:0;transform:translate(-50%,-50%) scale(.25)}35%{opacity:.9}to{opacity:0;transform:translate(-50%,-50%) scale(1.5)}}
@keyframes combat-water-drop{from{opacity:0;transform:translateY(8px) scale(.5)}30%{opacity:.9}to{opacity:0;transform:translateY(-38px) scale(.4)}}
.is-reduced-motion .combat-water-ring{animation:none;opacity:.65;transform:translate(-50%,-50%)}.is-reduced-motion .combat-water-drop{display:none}
@media(prefers-reduced-motion:reduce){.combat-water-ring{animation:none;opacity:.65;transform:translate(-50%,-50%)}.combat-water-drop{display:none}}
@keyframes combat-cast-arrive{0%{left:var(--projectile-start);top:var(--projectile-start-y);opacity:0;transform:translate(-50%,-50%) rotate(-30deg) scale(.5)}25%,85%{opacity:.7}100%{left:var(--impact-x);top:var(--impact-y);opacity:0;transform:translate(-50%,-50%) rotate(30deg) scale(.8)}}
.combat-effect.is-player-attack.is-winding-up .combat-rank-spark{visibility:hidden}
.combat-effect.is-player-attack.is-tactic-contact .combat-rank-spark{animation-duration:calc(.22s * var(--combat-speed));animation-delay:0s}
.combat-effect.is-player-attack .combat-flame{animation-duration:calc(.2s * var(--combat-speed));animation-delay:calc(var(--flame-index) * .012s * var(--combat-speed))}
.combat-effect.is-player-attack .combat-status-mark{animation-duration:calc(.24s * var(--combat-speed));animation-delay:0s;font-size:30px}
.combat-tactic-dissipate{position:absolute;left:var(--impact-x);top:var(--impact-y);width:58px;height:58px;border:1px dashed #c8d7cb80;border-radius:35%;animation:combat-tactic-dissipate calc(.24s * var(--combat-speed)) ease-out both}
@keyframes combat-tactic-dissipate{from{opacity:.65;transform:translate(-50%,-50%) scale(.65)}to{opacity:0;transform:translate(-50%,-50%) scale(1.2)}}
.is-reduced-motion .combat-thrust-wake,.is-reduced-motion .combat-charge-dust,.is-reduced-motion .combat-cast-mote{display:none}
.is-reduced-motion .combat-effect.is-player-attack .combat-tactic-dissipate{animation:none;opacity:.4;transform:translate(-50%,-50%)}
@media(prefers-reduced-motion:reduce){.combat-thrust-wake,.combat-charge-dust,.combat-cast-mote{display:none}.combat-effect.is-player-attack .combat-tactic-dissipate{animation:none;opacity:.4;transform:translate(-50%,-50%)}}

/* Mobile owns one visible action row throughout playback and resolved results.
   The dialog follows the visual viewport; only text/result content scrolls. */
.combat.combat-mobile-host{
 inset:auto;left:50%;top:50%;bottom:auto;right:auto;transform:translate(-50%,-50%);
 width:min(740px,calc(100vw - 16px));max-width:calc(100vw - 16px);
 max-height:calc(100dvh - 16px);padding:0;overflow:hidden;
}
.combat.combat-map-host.combat-mobile-host{width:min(430px,calc(100vw - 16px));top:auto;bottom:max(8px,env(safe-area-inset-bottom));transform:translateX(-50%)}
.combat-mobile-host .is-mobile-combat{
 --combat-sprite-size:clamp(56px,calc(42dvh - 76px),160px);
 --combat-dodge-distance:clamp(18px,5vw,40px);
 display:grid;width:100%;height:min(660px,calc(100dvh - 20px));max-height:calc(100dvh - 20px);
 grid-template-rows:44px minmax(0,1fr) clamp(44px,16dvh,96px) 44px auto;
 overflow:hidden;min-width:0;min-height:0;
}
.combat-mobile-host .combat-scene-heading{padding:0 12px;min-width:0;min-height:0}
.combat-mobile-host .combat-scene-label{font-size:14px;letter-spacing:.04em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.combat-mobile-host .combat-combatant{bottom:4px}
.combat-mobile-host .is-artwork-loading .combat-combatant,.combat-mobile-host .is-artwork-loading .combat-scene-background{visibility:hidden}
.combat-mobile-host .combat-scene-field.is-artwork-loading::before{content:"전투 그림을 준비하고 있습니다";position:absolute;left:12px;right:12px;top:50%;text-align:center;font-size:12px;color:#c6d2bd;z-index:10}
.combat-mobile-host .combat-actor{left:25%}.combat-mobile-host .combat-target{left:75%}
.combat-mobile-host .combat-scene-huds{padding:5px 9px;gap:8px}
.combat-mobile-host .combat-hud{width:44%;grid-template-columns:minmax(0,1fr);gap:1px}
.combat-mobile-host .combat-hud strong{font-size:12px}.combat-mobile-host .combat-scene-hp{font-size:11px}
.combat-mobile-host .combat-hp-track{height:5px}
.combat-mobile-host .combat-scene-lines{padding:4px 10px;justify-content:flex-start;gap:3px;overscroll-behavior:contain}
.combat-mobile-host .combat-scene-line{font-size:12px;gap:7px;line-height:1.45}
.combat-mobile-host .combat-scene-line strong{flex-basis:56px;max-width:64px}
.combat-mobile-host .combat-scene-footer{padding:3px 10px;gap:1px;overflow:auto;justify-content:flex-start}
.combat-mobile-host .combat-scene-phase{font-size:11px}.combat-mobile-host .combat-scene-detail{font-size:11px;max-height:none;line-height:1.35;overflow:visible}
.combat-mobile-host .combat-scene-cutin{height:clamp(68px,24dvh,116px);grid-template-columns:minmax(64px,25%) minmax(0,1fr);gap:9px;padding:0 10px}
.combat-mobile-host .combat-cutin-frame{width:min(100%,100px);height:100%;max-height:116px}
.combat-mobile-host .combat-scene-cutin>strong{font-size:clamp(16px,4vw,24px);overflow-wrap:anywhere}
.combat-mobile-host .combat-scene-cutin>span:not(.combat-cutin-frame){font-size:11px;letter-spacing:0}
.combat-mobile-actions{display:flex;align-items:center;justify-content:stretch;min-height:56px;padding:5px 10px max(5px,env(safe-area-inset-bottom));background:#0b1811;border-top:1px solid #7b704b;z-index:20}
.combat-mobile-host .combat-mobile-actions .combat-scene-skip{flex:1;min-width:44px;min-height:44px;height:auto;padding:8px 12px;font-size:14px;line-height:1.35;white-space:normal;background:#d6bd7c;color:#182319;border:1px solid #e9d69e;font-weight:800;touch-action:manipulation}
.combat-mobile-host .combat-map-toast.is-mobile-combat{height:auto;max-height:calc(100dvh - 20px);grid-template-rows:44px minmax(0,auto) auto minmax(0,auto) auto}
.combat-mobile-host .combat-map-result{margin:6px 10px 0;max-height:min(35dvh,140px);font-size:13px;overflow:auto}
.combat-mobile-host .is-mobile-combat.has-final-result{height:min(560px,calc(100dvh - 20px));grid-template-rows:44px minmax(0,1fr) auto}
.combat-final-result{overflow:auto;min-height:0;min-width:0;padding:12px;overscroll-behavior:contain;background:#102219;touch-action:pan-y}
.combat-final-result h2{font-size:20px;font-weight:700;line-height:1.4;margin:0 0 8px;color:#ecd599}
.combat-final-opponents{font-size:15px;font-weight:700;margin:0 0 12px;overflow-wrap:anywhere}
.combat-final-strike{padding:10px;margin-bottom:9px;border:1px solid #657657;background:#172b20;border-radius:4px}
.combat-final-result .combat-map-strike{font-size:15px;line-height:1.6;overflow-wrap:anywhere}
.combat-final-hp{font-size:14px;line-height:1.55;margin:4px 0 0;color:#d9e2c4;overflow-wrap:anywhere}
.combat-final-quote{font-size:13px;line-height:1.6;margin:8px 0;overflow-wrap:anywhere}
.combat-final-note{font-size:12px;line-height:1.5;color:#bfcdb5;margin:12px 0 0}
@media(max-height:330px){
 .combat-mobile-host .is-mobile-combat:not(.has-final-result){grid-template-rows:36px minmax(0,1fr) 44px 28px auto}
 .combat-mobile-host .combat-map-toast.is-mobile-combat:not(.has-final-result){grid-template-rows:36px minmax(0,auto) auto minmax(0,auto) auto}
 .combat-mobile-host .combat-scene-detail{display:none}
}
