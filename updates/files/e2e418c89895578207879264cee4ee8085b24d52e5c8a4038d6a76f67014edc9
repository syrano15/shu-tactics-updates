 }),deck=deckPaths.join(''),edge=terrainBoundaryPath(terrain,'B');
 let grain='';for(let x=0;x<spec.width;x+=15){grain+='<path d="M'+x+' 0v'+spec.height+'" stroke="#634d35" stroke-width="1.7" opacity=".42"/>';grain+='<path d="M'+(x+2)+' 0v'+spec.height+'" stroke="#dec394" stroke-width="1.1" opacity=".36"/>';}
 const seed=seedFor(chapter.id);for(let i=0;i<420;i++){const x=number(fraction(i,84,seed)*spec.width),y=number(fraction(i,85,seed)*spec.height);grain+='<path d="M'+x+' '+y+'q-3 12 1 28t0 24" stroke="#705538" stroke-width=".8" opacity=".3" fill="none"/>';}
 return '<svg xmlns="http://www.w3.org/2000/svg" width="'+spec.width+'" height="'+spec.height+'" viewBox="0 0 '+spec.width+' '+spec.height+'"><defs><clipPath id="deck">'+deckPaths.map(d=>'<path d="'+d+'"/>').join('')+'</clipPath><linearGradient id="oak" x2=".05" y2="1"><stop stop-color="#b49366"/><stop offset=".45" stop-color="#b99b6c"/><stop offset="1" stop-color="#9a794f"/></linearGradient></defs><g clip-path="url(#deck)"><rect width="100%" height="100%" fill="url(#oak)"/>'+grain+'<path d="'+edge+'" fill="none" stroke="#5b4834" stroke-width="7" opacity=".75"/><path d="'+edge+'" fill="none" stroke="#d8bb88" stroke-width="2" opacity=".75"/></g></svg>';
}
