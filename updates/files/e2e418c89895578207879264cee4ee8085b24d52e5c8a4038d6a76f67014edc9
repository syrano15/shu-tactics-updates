 for(const row of rows){
  const start=[0,row],goal=[spec.columns-1,row];if(terrain[row]?.[0]==='#'||terrain[row]?.[goal[0]]==='#')continue;
  const queue=[start],prev=new Map([[start.join(','),null]]);
  for(let i=0;i<queue.length;i++){const [x,y]=queue[i];if(x===goal[0]&&y===goal[1])break;for(const [dx,dy] of [[1,0],[0,-1],[0,1],[-1,0]]){const nx=x+dx,ny=y+dy,k=nx+','+ny;if(terrain[ny]?.[nx]===undefined||terrain[ny][nx]==='#'||prev.has(k))continue;prev.set(k,x+','+y);queue.push([nx,ny]);}}
  let cursor=goal.join(',');if(!prev.has(cursor))continue;const path=[];while(cursor){const [x,y]=cursor.split(',').map(Number);path.unshift([x*CELL+50,y*CELL+50]);cursor=prev.get(cursor);}
