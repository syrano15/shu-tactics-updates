    const angle=fraction(i*16+leaf,27,seed)*Math.PI*2,r=Math.sqrt(fraction(i*16+leaf,28,seed))*.74,lx=x+Math.cos(angle)*rx*r,ly=y+Math.sin(angle)*ry*r;
