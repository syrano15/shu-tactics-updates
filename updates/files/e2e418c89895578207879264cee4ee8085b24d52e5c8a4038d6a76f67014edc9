 }
 out+='</g><g clip-path="url(#passable)" opacity=".3" fill="none" stroke-linecap="round">';
 for(let i=0;i<450;i++){
  const x=number(fraction(i,5,seed)*spec.width),y=number(fraction(i,6,seed)*spec.height),len=3+fraction(i,7,seed)*9;
  out+='<path d="M'+x+' '+y+'q'+number(len*.3)+' -'+number(len)+' '+number(len*.8)+' -'+number(len*.7)+'" stroke="'+(i%3?'#65794d':'#dcc5a0')+'" stroke-width="1.3"/>';
 }
