   const rx=26+fraction(i,22,seed)*32,ry=19+fraction(i,23,seed)*29,d=organicShape(x,y,rx,ry,i,seed);
   out+='<path d="'+d+'" transform="translate(5 7)" fill="#19362b" opacity=".38"/><path d="'+d+'" fill="url(#canopy'+j%3+')" stroke="#274b32" stroke-width="1"/>';
