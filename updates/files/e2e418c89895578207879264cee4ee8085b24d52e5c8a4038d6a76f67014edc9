  const px=x*CELL,py=y*CELL;
  if(!has(x,y-1))path+='M'+px+' '+py+'h100';
  if(!has(x+1,y))path+='M'+(px+100)+' '+py+'v100';
  if(!has(x,y+1))path+='M'+px+' '+(py+100)+'h100';
