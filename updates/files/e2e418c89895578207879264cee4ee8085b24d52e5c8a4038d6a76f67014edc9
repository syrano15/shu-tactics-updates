  const minX=Math.min(...region.map(c=>c[0]))*CELL,minY=Math.min(...region.map(c=>c[1]))*CELL,maxX=(Math.max(...region.map(c=>c[0]))+1)*CELL,maxY=(Math.max(...region.map(c=>c[1]))+1)*CELL,count=Math.ceil(region.length*6.4);
