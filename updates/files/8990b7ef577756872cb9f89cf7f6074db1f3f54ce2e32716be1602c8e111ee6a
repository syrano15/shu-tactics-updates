/* v0.27: geometric attack area above terrain (0), below unit tokens (2). */
.cell.attack-range::before{
  content:"";position:absolute;inset:0;z-index:1;pointer-events:none;border-radius:inherit;
  background:repeating-linear-gradient(135deg,#ee575694 0 3px,#cc352b61 3px 8px);
  box-shadow:inset 0 0 0 1px #ff9b85d9;
}
/* Green landing fill stays visible between the red stripes. */
.cell.reachable.attack-range::before{
  background:repeating-linear-gradient(135deg,#ef6355a3 0 3px,#be292a45 3px 9px);
  box-shadow:inset 0 0 0 1px #eb857c99,inset 0 0 0 3px #a5e2b854;
}
.cell.attack-range.attack-range-target::before{
  box-shadow:inset 0 0 0 2px #ff8470,inset 0 0 0 4px #59151199;
  background:repeating-linear-gradient(135deg,#ec4b46b3 0 3px,#b4262980 3px 8px);
}
.cell.range-origin::before{
  content:"";position:absolute;inset:3px;z-index:1;pointer-events:none;border-radius:inherit;
  outline:2px dashed #fce2a2;outline-offset:-2px;
}
.cell.selected.attack-range::before,.cell.targeted.attack-range::before,.cell.attack-range:focus-visible::before{
  outline:2px solid #ffe3a1;outline-offset:-2px;
}
.attack-range-legend{
  display:inline-flex;align-items:center;gap:6px;color:#f0b4a6;
}
.attack-range-legend .key,.attack-range-key{
  display:inline-block;width:11px;height:11px;flex:none;border:1px solid #f39b84;
  background:repeating-linear-gradient(135deg,#e96153b3 0 3px,#9d3c3c80 3px 6px);
}
.range-hint{
  margin:0;padding:7px 17px;border-top:1px solid #4c4638;background:#19271f;
  color:#e9c8b4;font-size:12px;line-height:1.6;word-break:keep-all;overflow-wrap:anywhere;
}
/* The app also removes the classes during busy/modal phases. */
.board-stage[aria-busy="true"] .cell.attack-range::before,
.board-stage[aria-busy="true"] .cell.range-origin::before,
.board[aria-busy="true"] .cell.attack-range::before,
.board[aria-busy="true"] .cell.range-origin::before{display:none}
@media(max-width:620px){
  .range-hint{font-size:11px;padding:6px 10px}
  .attack-range-legend{gap:4px}
}
@media(forced-colors:active){
  .cell.attack-range::before{background:transparent;outline:1px dashed Mark;outline-offset:-2px}
  .cell.attack-range.attack-range-target::before{outline:3px solid Mark;outline-offset:-3px}
  .cell.range-origin::before{outline-color:Highlight}
}
