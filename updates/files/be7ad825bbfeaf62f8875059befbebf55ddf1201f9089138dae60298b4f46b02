 const columns=chapter.terrain[0].length,rows=chapter.terrain.length;
 return {id:chapter.id,columns,rows,width:columns*CELL,height:rows*CELL,terrainKey:art.terrainKey,blockedKind:art.blockedKind,src:'art/act2-v0401/maps/'+chapter.id+'-v0401.webp',...(chapter.id==='s09_baima'?{bridgeDisplayLabel:'흙둑길'}:{}),...(art.bridgeCells.length?{overlaySrc:chapter.id==='s09_baima'?BAIMA_EARTH_CAUSEWAY_SRC:'art/act2-v0401/maps/'+chapter.id+'-traversal-v0401.svg'}:{})};
}
export function act2BridgeDisplayLabel(chapter){return refinedAct2MapSpec(chapter)?.bridgeDisplayLabel??'다리';}
export function installAct2MapRefinement(chapters,register){
