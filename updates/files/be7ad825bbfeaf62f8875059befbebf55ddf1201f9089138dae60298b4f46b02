}
export function continuousCellPaths(cells){
 const all=new Set(cells.map(p=>p.join(','))),seen=new Set(),regions=[];
 for(const start of cells){const k=start.join(',');if(seen.has(k))continue;const region=[start];seen.add(k);for(let i=0;i<region.length;i++)for(const [dx,dy] of [[1,0],[-1,0],[0,1],[0,-1]]){const [x,y]=region[i],next=[x+dx,y+dy],key=next.join(',');if(all.has(key)&&!seen.has(key)){region.push(next);seen.add(key);}}regions.push(region);}
 return regions.map(region=>{
  const keys=new Set(region.map(p=>p.join(','))),edges=new Map(),has=(x,y)=>keys.has(x+','+y),add=(a,b,c,d)=>edges.set(a+','+b,[c,d]);
  for(const [x,y] of region){if(!has(x,y-1))add(x,y,x+1,y);if(!has(x+1,y))add(x+1,y,x+1,y+1);if(!has(x,y+1))add(x+1,y+1,x,y+1);if(!has(x-1,y))add(x,y+1,x,y);}
  const first=edges.keys().next().value;let cursor=first,path='M'+first.split(',').map(n=>Number(n)*CELL).join(' '),count=0;
  do{const next=edges.get(cursor);if(!next||count++>edges.size)throw new Error('Invalid Act 2 cell contour');path+='L'+next.map(n=>n*CELL).join(' ');cursor=next.join(',');}while(cursor!==first);return path+'z';
 });
}
// Detail is sampled inside the continuous earth footprint, rather than scattered
// across the whole map where almost every mark would be discarded by the clip.
export function act2CausewaySurfaceDetail(chapter,{includeBridgeCells=false}={}){
 const geometry=act2TraversalGeometry(chapter),bridgeCells=geometry.bridgeCells,causewayCells=includeBridgeCells?[...bridgeCells,...geometry.causewayCells]:geometry.causewayCells;if(!causewayCells.length)return {marks:[],patches:[],rim:[]};
 const cells=new Set(causewayCells.map(p=>p.join(','))),inside=(x,y)=>cells.has(Math.floor(x/CELL)+','+Math.floor(y/CELL));
 const left=Math.min(...causewayCells.map(p=>p[0]))*CELL,top=Math.min(...causewayCells.map(p=>p[1]))*CELL,right=(Math.max(...causewayCells.map(p=>p[0]))+1)*CELL,bottom=(Math.max(...causewayCells.map(p=>p[1]))+1)*CELL;
 const seed=[...chapter.id].reduce((sum,c)=>sum+c.charCodeAt(0),0),marks=[],patches=[],rim=[];
 let i=0;for(let y=top+5;y<bottom;y+=10)for(let x=left+5;x<right;x+=10){
  const px=+(x+(hash(i,seed)-.5)*8).toFixed(2),py=+(y+(hash(i,seed+1)-.5)*8).toFixed(2);
  if(inside(px,py))marks.push({x:px,y:py,size:+(1.4+hash(i,seed+2)*2.8).toFixed(2),angle:Math.round(hash(i,seed+3)*100-50),tone:i%5});i++;
 }
 for(let j=0;j<causewayCells.length*36;j++){
  const x=+(left+hash(j,seed+4)*(right-left)).toFixed(2),y=+(top+hash(j,seed+5)*(bottom-top)).toFixed(2);
  if(inside(x,y))patches.push({x,y,rx:+(9+hash(j,seed+6)*24).toFixed(2),ry:+(4+hash(j,seed+7)*12).toFixed(2),angle:Math.round(hash(j,seed+8)*150),tone:j%4});
 }
 const wood=new Set(bridgeCells.map(p=>p.join(',')));let edge=0;
 for(const [x,y] of causewayCells)for(const [dx,dy] of [[0,-1],[1,0],[0,1],[-1,0]]){
  if(cells.has((x+dx)+','+(y+dy))||wood.has((x+dx)+','+(y+dy)))continue;
  for(let distance=6;distance<100;distance+=8){
   const jitter=(hash(edge,seed+9)-.5)*4,normal=(hash(edge,seed+10)-.5)*4,px=dx?((x+(dx>0?1:0))*CELL+dx*normal):(x*CELL+distance+jitter),py=dy?((y+(dy>0?1:0))*CELL+dy*normal):(y*CELL+distance+jitter);
   rim.push({x:+px.toFixed(2),y:+py.toFixed(2),size:+(2+hash(edge,seed+11)*4).toFixed(2),angle:(dx?90:0)+Math.round(hash(edge,seed+12)*40-20),tone:edge%5});edge++;
  }
 }
 return {marks,patches,rim};
}
