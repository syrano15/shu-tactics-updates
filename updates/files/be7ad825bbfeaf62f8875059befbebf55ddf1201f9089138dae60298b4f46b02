const CELL=100,pointsKey=points=>JSON.stringify([...points].sort((a,b)=>a[1]-b[1]||a[0]-b[0]));
export const BAIMA_EARTH_CAUSEWAY_SRC='art/playfix-v0601/s09_baima-earth-causeway-v0601.svg';
const hash=(i,s)=>{let n=Math.imul(i+19,374761393)^Math.imul(s+31,668265263);n=Math.imul(n^(n>>>13),1274126177);return ((n^(n>>>16))>>>0)/4294967296;};
export function refinedAct2MapSpec(chapter){
