export function act2TraversalGeometry(chapter){
 const spec=refinedAct2MapSpec(chapter);if(!spec)throw new Error('Act 2 overlay terrain signature mismatch');
 const bridgeCells=chapter.bridgeCells??[],wood=new Set(bridgeCells.map(p=>p.join(','))),riverColumns=[];
 if(spec.blockedKind==='water')for(let x=0;x<spec.columns;x++){let count=0;for(const row of chapter.terrain)count+=row[x]==='#';if(count>=spec.rows/2)riverColumns.push(x);}
 const causewayCells=[];for(const x of riverColumns)for(let y=0;y<spec.rows;y++)if(chapter.terrain[y][x]==='.'&&!wood.has(x+','+y))causewayCells.push([x,y]);
