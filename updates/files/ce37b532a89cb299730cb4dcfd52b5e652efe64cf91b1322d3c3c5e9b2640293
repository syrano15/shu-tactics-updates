 const marker=value.state?.enemyProgressionVersion;
 ensure(marker===undefined||[1,2,3].includes(marker),'전투 기록 버전이 올바르지 않습니다.');
 ensure(value.enemyProgressionVersion===undefined||marker===undefined||value.enemyProgressionVersion===marker,'전투와 저장의 성장 버전이 다릅니다.');
 const version=value.enemyProgressionVersion??marker??1;
 ensure(version===3?marker===3&&value.state?.enemyHpCap===ENEMY_HP_CAP:value.state?.enemyHpCap===undefined,'적 병력 상한 버전이 다릅니다.');
}
export function enemyProgressionStamp(state,chapter){
 if(!isAct2(chapter))return {};
