import {CHAPTERS} from './campaign.js';
import {awardAct7ObjectiveExperience} from './growth.js';

const scenarioFor=state=>state.chapterId?CHAPTERS.find(ch=>ch.id===state.chapterId):CHAPTERS[state.chapter];
const atTile=(unit,[x,y])=>unit.x===x&&unit.y===y;
const regular=unit=>unit.team==='ally'&&!unit.extra&&!unit.generic&&!unit.nonCombat&&unit.hp>0&&!unit.withdrawn&&!unit.escaped;

export function initializeAct7Mission(state,scenario){
 if(scenario?.act===7){state.act7MissionVisits=[];state.act7OptionalObjectiveAchieved=false;}
}
// Moving alone is cancellable. A goal is credited only after the unit commits
// an action; selection, hover, preview and cancelled movement never grant EXP.
export function recordAct7MissionProgress(state){
 const scenario=scenarioFor(state);
 if(scenario?.act!==7||state.act7GrowthVersion!==1||state.phase!=='ally'||state.result||state.replayChapterId)return [];
 const events=[];
 for(const unit of state.units.filter(unit=>regular(unit)&&unit.done)){
  for(const goal of scenario.act7Objectives??[]){
   if(!goal.tiles.some(tile=>atTile(unit,tile)))continue;
   if(!state.act7MissionVisits.some(v=>v.key===goal.key&&v.unitId===unit.id)){
    state.act7MissionVisits.push({key:goal.key,unitId:unit.id,round:state.round});
   }
   const event=awardAct7ObjectiveExperience(state,unit,goal.key);if(event)events.push(event);
  }
 }
 const optional=scenario.act7OptionalObjective;
 if(!state.act7OptionalObjectiveAchieved&&optional?.tiles?.length&&optional.tiles.every(tile=>state.units.some(unit=>regular(unit)&&unit.done&&atTile(unit,tile)))){
  const unit=state.units.find(unit=>regular(unit)&&unit.done&&atTile(unit,optional.tiles[0]));
  state.act7OptionalObjectiveAchieved=true;
  state.act7MissionVisits.push({key:'optional_supply',unitId:unit.id,round:state.round});
 }
 return events;
}
export function validateAct7Mission(state,scenario){
 const fail=()=>{throw new Error('7막 거점 기여 기록이 올바르지 않습니다.');};
 if(scenario?.act!==7){if(state.act7MissionVisits!==undefined||state.act7OptionalObjectiveAchieved!==undefined)fail();return;}
 if(!Array.isArray(state.act7MissionVisits)||state.act7MissionVisits.length>37||typeof state.act7OptionalObjectiveAchieved!=='boolean')fail();
 const keys=new Set();
 for(const visit of state.act7MissionVisits){
  if(!visit||Object.keys(visit).some(key=>!['key','unitId','round'].includes(key))||!Number.isInteger(visit.round)||visit.round<1||visit.round>state.round||!state.units.some(unit=>regular({...unit,hp:1})&&unit.id===visit.unitId))fail();
  const id=visit.unitId+'|'+visit.key;if(keys.has(id))fail();keys.add(id);
  if(visit.key==='optional_supply'){if(!scenario.act7OptionalObjective?.tiles?.length||!state.act7OptionalObjectiveAchieved)fail();}
  else if(!scenario.act7Objectives?.some(goal=>goal.key===visit.key))fail();
 }
 const optionalVisits=state.act7MissionVisits.filter(v=>v.key==='optional_supply');
 if(optionalVisits.length!==(state.act7OptionalObjectiveAchieved?1:0))fail();
 for(const key of Object.keys(state.act7Growth?.record?.objectiveKeys??{}))if(!scenario.act7Objectives?.some(goal=>key.endsWith('|'+goal.key)))fail();
}
