function readBalanceForm() {
  const form = new FormData($('balance-form')), value = cloneBalance();
  for (const id of CLASS_IDS) {
    for (const prop of ['hp', 'atk', 'int', 'def', 'move', 'min', 'max']) {
      const raw = form.get(`${id}.${prop}`); value.classes[id][prop] = raw === '' ? NaN : Number(raw);
    }
    value.classes[id].attackAfterMove = form.has(`${id}.attackAfterMove`);
    for (const other of CLASS_IDS) { const raw = form.get(`match.${id}.${other}`); value.matchups[id][other] = raw === '' ? NaN : Number(raw) / 100; }
  }
  value.terrain.forestCost = Number(form.get('forestCost')); value.terrain.forestDefense = Number(form.get('forestDefense'));
  value.healing = Number(form.get('healing')); value.counterMultiplier = Number(form.get('counterMultiplier')) / 100;
  for (const key of ['damage', 'baseChance', 'minChance', 'maxChance', 'forestBonus']) value.fire[key] = Number(form.get(`fire.${key}`));
  for (const key of ['baseChance','minChance','maxChance']) value.tactics[key] = Number(form.get(`tactics.${key}`));
  value.weather.start = form.get('weather.start');
  for (const key of ['minRounds','maxRounds','changeChance']) value.weather[key] = Number(form.get(`weather.${key}`));
  for(const key of ['enabled','counter','morale'])value.critical[key]=form.has('critical.'+key);
  validateBalance(value); return value;
}

