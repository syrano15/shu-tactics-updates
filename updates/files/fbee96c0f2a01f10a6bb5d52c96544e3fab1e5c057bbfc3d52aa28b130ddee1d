.shop-roster{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));max-height:280px;overflow:auto;padding:3px}.hero-placeholder{display:flex;align-items:center;justify-content:center;min-width:52px;min-height:64px;background:linear-gradient(150deg,#3e594b,#14251e);border:1px solid #b6a16c;border-radius:5px;color:#f4e5bb;font-size:15px;font-weight:700}.trait-note{color:#d7c28e!important;line-height:1.5}.guest-note{color:#e1bf86}.deploy-card small{white-space:normal}.command-hint{line-height:1.5}

.dialogue-scene.narration .dialogue-box{background:#090f0d;border-color:#425047}.dialogue-scene.narration .scene-calligraphy{opacity:.18}.character-portrait[hidden]{display:none!important}.dialogue-scene .portrait-stage{min-height:220px}

.story-event{width:min(640px,90vw);border:1px solid #bd9652;border-radius:12px;background:#172324;color:#f4eee0;padding:24px}.story-event::backdrop{background:#0009}.event-text{font-size:1.15rem;line-height:1.8;white-space:pre-wrap}.cell.exit-tile{box-shadow:inset 0 0 0 3px #f6d77b}.cell.exit-tile .terrain-mark{color:#ffe194;font-weight:bold;opacity:1}
/* Commander victory choice is a small native modal, separate from the UI proposal. */
.boss-cleanup-dialog{max-width:520px;width:calc(100% - 40px);background:#11231a;color:#e7e6d6;border:1px solid #c9ad6e;padding:26px;}
.boss-cleanup-dialog::backdrop{background:rgba(0,0,0,.65);}
.boss-cleanup-dialog h3{margin:0 0 14px;color:#d4b477;}
.boss-cleanup-dialog p{line-height:1.6;}
.boss-cleanup-dialog .dialog-actions{display:flex;gap:10px;flex-wrap:wrap;}
.boss-cleanup-dialog button{min-height:44px;flex:1;}
.boss-cleanup-finish{margin-top:10px;width:100%;min-height:44px;}
.boss-cleanup-finish[hidden]{display:none;}
