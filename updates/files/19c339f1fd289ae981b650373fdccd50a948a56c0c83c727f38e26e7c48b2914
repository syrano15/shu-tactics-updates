/* Player-only state contours. Face, troop bar, goals and input remain above/outside them. */
.spirit-fx-layer,.spirit-effect,.spirit-shape{pointer-events:none!important;box-sizing:border-box}
.spirit-fx-layer{position:absolute;inset:0;z-index:1;overflow:visible;contain:layout style}
.spirit-effect{position:absolute;display:block;inset:0;color:#b8e5ff;filter:drop-shadow(0 0 3px currentColor)}
.spirit-shape{position:absolute;display:block;font-style:normal}
.spirit-effect-wall{inset:-6% -8% 17%;color:#acd9fb}
.spirit-effect-wall .spirit-shape{top:25%;width:29%;height:66%;border:1.5px solid currentColor;border-radius:25% 25% 45% 45%;background:linear-gradient(100deg,#78b5e00b,#d7efff29,#78b5e00b);clip-path:polygon(10% 0,90% 0,100% 68%,50% 100%,0 68%)}
.spirit-effect-wall .part-0{left:0;transform:perspective(80px) rotateY(-30deg)}
.spirit-effect-wall .part-1{right:0;transform:perspective(80px) rotateY(30deg)}
.spirit-effect-wall .part-2{left:35.5%;top:65%;height:32%;background:#acd9fb12}
.spirit-effect-accel{inset:48% 1% 19%;color:#9eead6}
.spirit-effect-accel .spirit-shape{left:0;top:30%;width:70%;height:42%;border:0;border-top:2px solid currentColor;border-radius:75% 40% 0 0;transform:rotate(-8deg)}
.spirit-effect-accel .part-1{left:30%;top:65%;width:65%;transform:rotate(-12deg);opacity:.7}
.spirit-effect-accel::after{content:"";position:absolute;right:1%;top:31%;width:11%;height:27%;border-top:2px solid currentColor;border-right:2px solid currentColor;transform:rotate(20deg)}
.spirit-effect-focus{inset:3% 14% 43%;color:#f9e5a5}
.spirit-effect-focus .spirit-shape{width:19%;height:27%;border:0;border-style:solid;border-color:currentColor}
.spirit-effect-focus .part-0{left:0;top:0;border-width:2px 0 0 2px}.spirit-effect-focus .part-1{right:0;top:0;border-width:2px 2px 0 0}
.spirit-effect-focus .part-2{left:0;bottom:0;border-width:0 0 2px 2px}.spirit-effect-focus .part-3{right:0;bottom:0;border-width:0 2px 2px 0}
.cell.selected .spirit-effect-focus:not(.is-expiring){animation:spirit-focus-breathe 2.8s ease-in-out infinite}
.spirit-effect.is-expiring{animation:spirit-shape-exit .2s ease-out both}
.spirit-effect.is-casting{animation:spirit-shape-cast .58s ease-out both}
.spirit-effect-wall.is-casting{animation-name:spirit-shield-raise}.spirit-effect-accel.is-casting{animation-name:spirit-wind-settle}.spirit-effect-focus.is-casting{animation-name:spirit-focus-gather}
.spirit-effect-wall.is-reacting{animation:spirit-shield-contact .24s ease-out both}
.spirit-effect-focus.is-reacting{filter:drop-shadow(0 0 7px #fff5ca);opacity:1}
.spirit-fx-layer.is-combat{inset:0 3% 26px;z-index:3}.is-combat .spirit-effect-wall{inset:5% -4% 0}.is-combat .spirit-effect-wall .spirit-shape{border-width:2px}
.is-combat .spirit-effect-focus{inset:5% 18% 48%}.is-combat .spirit-effect-accel{inset:67% 10% 0}
.unit-traveller.has-spirit-accel-motion .spirit-effect-accel{filter:drop-shadow(0 0 5px #b1ffeb);animation:spirit-moving-wind .22s ease-out infinite}
.unit-traveller.sprite-token>.spirit-movement-echo{pointer-events:none;z-index:0;opacity:.2!important;animation:none!important;translate:-12% 0;filter:sepia(.5) hue-rotate(100deg) saturate(.5)!important}
.unit-traveller.sprite-token>.spirit-movement-echo.echo-1{opacity:.1!important;translate:-24% 1%}
.spirit-presentation-ring:has(>.spirit-effect){border:0;border-radius:0;box-shadow:none;animation:none}
.spirit-presentation-ring>.spirit-effect{inset:-5%;font-size:16px}.spirit-presentation-ring>.spirit-effect-accel{inset:30% 0 0}.spirit-presentation-ring>.spirit-effect-focus{inset:0 5% 20%}
@keyframes spirit-focus-breathe{0%,100%{opacity:.65}50%{opacity:1}}
@keyframes spirit-shape-cast{from{opacity:0;scale:.6}65%{opacity:1;scale:1.1}to{opacity:.9;scale:1}}
@keyframes spirit-shield-raise{from{opacity:0;translate:0 24%;scale:.85 .25}65%{opacity:1;translate:0 -2%;scale:1.06}to{opacity:.9;translate:0 0;scale:1}}
@keyframes spirit-wind-settle{from{opacity:0;translate:0 30%;scale:1.2 .6}60%{opacity:1;translate:0 -15%;scale:1}to{opacity:.9;translate:0 0;scale:1}}
@keyframes spirit-focus-gather{from{opacity:0;scale:1.6}65%{opacity:1;scale:.92}to{opacity:.9;scale:1}}
@keyframes spirit-shape-exit{from{opacity:.65;scale:1}to{opacity:0;scale:.8 .65}}
@keyframes spirit-shield-contact{0%{filter:drop-shadow(0 0 3px #b8e5ff)}30%{filter:drop-shadow(0 0 12px #e5f7ff);background:radial-gradient(ellipse,#ccecff40,transparent 65%)}100%{filter:drop-shadow(0 0 3px #b8e5ff)}}
@keyframes spirit-moving-wind{from{translate:0 0;opacity:.9}to{translate:-10% 0;opacity:.6}}
.is-reduced-motion .spirit-effect,.is-reduced-motion .spirit-movement-echo{animation:none!important}.is-reduced-motion .spirit-movement-echo{display:none}
@media(prefers-reduced-motion:reduce){.spirit-effect{animation:none!important}.spirit-effect.is-expiring{opacity:0}.spirit-movement-echo{display:none!important}.has-spirit-accel-motion .spirit-effect-accel{translate:none}}
/* V2: parallel weapon lines, a split flame, a closed talisman, one star, instant morale rays. */
.spirit-effect-strike{inset:30% -7% 34% 68%;color:#ffdf8c}
.spirit-effect-strike .spirit-shape{left:0;top:35%;width:90%;height:0;border-top:2px solid currentColor;transform:rotate(-18deg)}
.spirit-effect-strike .part-1{top:64%;width:70%}.spirit-effect-strike .part-2{left:70%;top:4%;width:17%;height:22%;border:1px solid currentColor;background:#ffeab660;transform:rotate(45deg)}
.spirit-effect-fury{inset:33% 39% 25% 39%;color:#ff9c69}
.spirit-effect-fury .spirit-shape{left:10%;top:13%;width:75%;height:73%;border:1px solid currentColor;border-radius:70% 15% 65% 35%;background:linear-gradient(0deg,#c7492717,#ffad5d6b,transparent);transform:rotate(24deg)}
.spirit-effect-fury .part-1{left:-28%;top:31%;width:57%;height:57%;transform:rotate(-27deg)}.spirit-effect-fury .part-2{left:76%;top:36%;width:50%;height:51%;transform:rotate(44deg)}
.spirit-effect-wisdom{inset:2% 67% 53% -7%;color:#d5c3ff}
.spirit-effect-wisdom .spirit-shape{inset:10% 0;border:1px solid currentColor;background:linear-gradient(120deg,#8772b32a,#d9c7f34a,#8772b31a);transform:rotate(-18deg);clip-path:polygon(0 0,100% 8%,100% 100%,0 90%)}
.spirit-effect-wisdom .part-0::after{content:"";position:absolute;inset:22%;border:1px solid currentColor;transform:rotate(45deg)}
.spirit-effect-wisdom .part-1{inset:20% -19% 0 62%;transform:rotate(15deg);opacity:.5}
.spirit-effect-flash{inset:-3% -13% 65% 82%;color:#e2f5ff}
.spirit-effect-flash .spirit-shape{inset:2%;background:currentColor;clip-path:polygon(50% 0,60% 37%,100% 50%,60% 61%,50% 100%,39% 61%,0 50%,39% 38%);filter:drop-shadow(0 0 4px #baeaff)}
.spirit-effect-spirit{inset:-3% 3% 0;color:#f8da8b}
.spirit-effect-spirit .spirit-shape{left:47%;bottom:9%;width:6%;height:77%;background:linear-gradient(0deg,transparent,#ffdf8b,#fff2c6);clip-path:polygon(50% 0,100% 100%,0 100%);transform-origin:50% 100%;transform:rotate(-24deg)}
.spirit-effect-spirit .part-1{transform:rotate(0deg);height:96%}.spirit-effect-spirit .part-2{transform:rotate(24deg)}
.spirit-effect-strike.is-casting{animation-name:spirit-lines-align}.spirit-effect-fury.is-casting{animation-name:spirit-flame-gather}.spirit-effect-wisdom.is-casting{animation-name:spirit-talisman-open}.spirit-effect-flash.is-casting{animation-name:spirit-star-gather}.spirit-effect-spirit.is-casting{animation:spirit-morale-rise .65s ease-out both}
.spirit-effect-strike.is-reacting{filter:drop-shadow(0 0 7px #ffe4a6)}.spirit-effect-fury.is-reacting{animation:spirit-flame-charge .25s ease-out both}.spirit-effect-wisdom.is-reacting{animation:spirit-talisman-open .28s ease-out both}.spirit-effect-flash.is-reacting{animation:spirit-star-dodge .24s ease-out both}
.is-combat .spirit-effect-strike{inset:37% -2% 38% 71%}.is-combat .spirit-effect-fury{inset:33% 35% 29% 41%}.is-combat .spirit-effect-wisdom{inset:9% 70% 53% 1%}.is-combat .spirit-effect-flash{inset:1% -2% 75% 86%}
.spirit-presentation-ring>.spirit-effect-strike{inset:15% 5% 25% 15%}.spirit-presentation-ring>.spirit-effect-fury{inset:0 30% 10%}.spirit-presentation-ring>.spirit-effect-wisdom{inset:0 28% 15%}.spirit-presentation-ring>.spirit-effect-flash{inset:5% 22% 25%}
@keyframes spirit-lines-align{from{opacity:0;translate:-30% 12%;scale:.6 1}65%{opacity:1;translate:0 0;scale:1.08 1}to{opacity:.9;translate:0 0;scale:1}}
@keyframes spirit-flame-gather{from{opacity:0;translate:0 -25%;scale:1.5}70%{opacity:1;translate:0 0;scale:.9}to{opacity:.9;scale:1}}
@keyframes spirit-talisman-open{from{opacity:.4;scale:.35 1;rotate:-15deg}65%{opacity:1;scale:1.13 1;rotate:5deg}to{opacity:.9;scale:1;rotate:0deg}}
@keyframes spirit-star-gather{from{opacity:0;scale:1.8;rotate:-45deg}65%{opacity:1;scale:.8;rotate:0deg}to{opacity:.9;scale:1}}
@keyframes spirit-morale-rise{0%{opacity:0;translate:0 25%;scale:.7 .2}35%,70%{opacity:1;translate:0 0;scale:1}100%{opacity:0;translate:0 -20%;scale:.9 1.1}}
@keyframes spirit-flame-charge{from{filter:drop-shadow(0 0 3px #ff9c69);scale:1}to{filter:drop-shadow(0 0 9px #ffc599);scale:1.2}}
@keyframes spirit-star-dodge{from{opacity:1;scale:1}45%{opacity:1;scale:1.7}to{opacity:.2;scale:.5;translate:10% -5%}}
.is-reduced-motion .spirit-effect{animation:none!important}
@media(prefers-reduced-motion:reduce){.spirit-effect{animation:none!important}}
/* Existing small-cell overview: preserve each silhouette, reduce decorative detail first. */
.board-overview .spirit-effect{animation:none!important;filter:none;opacity:.88}
.board-overview .spirit-effect.is-expiring{opacity:0}
.board-overview .spirit-effect-wall{inset:1% 2% 22%}
.board-overview .spirit-effect-wall .spirit-shape{border-width:1px;background:#b9dfff0e}
.board-overview .spirit-effect-wall .part-2{display:none}
.board-overview .spirit-effect-accel{inset:50% 4% 23%}.board-overview .spirit-effect-accel .spirit-shape,.board-overview .spirit-effect-accel::after{border-width:1px}
.board-overview .spirit-effect-focus{inset:4% 18% 45%}.board-overview .spirit-effect-focus .spirit-shape{border-width:1px 0 0 1px}
.board-overview .spirit-effect-focus .part-1{border-width:1px 1px 0 0}.board-overview .spirit-effect-focus .part-2{border-width:0 0 1px 1px}.board-overview .spirit-effect-focus .part-3{border-width:0 1px 1px 0}
.board-overview .spirit-effect-strike{inset:32% 0 36% 68%}.board-overview .spirit-effect-strike .spirit-shape{border-top-width:1px}
.board-overview .spirit-effect-fury{inset:34% 40% 28% 40%}.board-overview .spirit-effect-fury .part-1,.board-overview .spirit-effect-fury .part-2{display:none}
.board-overview .spirit-effect-wisdom{inset:5% 72% 52% 2%}.board-overview .spirit-effect-wisdom .part-1{display:none}
.board-overview .spirit-effect-flash{inset:2% 0 72% 76%}.board-overview .spirit-effect-flash .spirit-shape{filter:none}
.board-overview .spirit-movement-echo{display:none!important}
