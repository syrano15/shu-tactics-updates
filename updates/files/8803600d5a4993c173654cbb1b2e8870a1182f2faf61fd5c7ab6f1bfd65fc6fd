/* A fitted map and a vertical officer list share the available window. */
body.ui-stage-deployment{height:100dvh;min-height:0;overflow:hidden}
body.ui-stage-deployment:not(.on-title):not(.in-preparation) #game-main{height:calc(100dvh - 46px);min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr);gap:6px;padding:6px 10px;max-width:none}
body.ui-stage-deployment #game-main>.battle-heading{margin:0;min-height:0;align-items:center;gap:8px}
body.ui-stage-deployment .battle-heading h2{font-size:20px;line-height:1.3;margin:0}
body.ui-stage-deployment .battle-heading p,body.ui-stage-deployment .story-progress{display:none}
body.ui-stage-deployment #deployment-scene{height:100%;min-height:0;overflow:hidden;padding:0;border:0;background:transparent}
:is(#deployment-scene,#shop-scene) .deployment-compact{height:100%;min-height:0;min-width:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:8px;padding:10px;overflow:hidden;border:1px solid var(--prep-line,var(--line));border-radius:6px;background:var(--prep-panel,#14221b);color:var(--prep-ink,var(--text))}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-top{display:flex;align-items:center;gap:12px;margin:0;min-height:42px;flex-wrap:nowrap}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-top h3{font:600 20px/1.3 var(--font-heading);margin:0;white-space:nowrap}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-top strong{font-size:15px;line-height:1.4;color:var(--gold);white-space:nowrap}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-top>button{margin-left:auto;min-height:44px;min-width:44px;padding:6px 10px;font-size:13px;white-space:nowrap}
:is(#deployment-scene,#shop-scene) .deployment-compact .deployment-content-scroll{min-height:0;min-width:0;overflow:hidden;display:grid;grid-template-columns:minmax(0,1fr) clamp(280px,32vw,430px);gap:10px}
:is(#deployment-scene,#shop-scene) .deployment-compact .deployment-board-layout{display:grid;grid-template-rows:minmax(0,1fr) auto;grid-template-columns:1fr;gap:6px;min-height:0;min-width:0;padding:0;border:0;background:var(--prep-bg,#0e1b15);overflow:hidden}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-map-scroll{container-name:deployment-map;container-type:size;width:100%;height:100%;max-height:none;min-height:0;min-width:0;overflow:hidden;display:grid;place-items:center;padding:0}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-map{display:grid;width:min(100cqw,calc(100cqh * var(--deploy-ratio)));height:min(100cqh,calc(100cqw / var(--deploy-ratio)));max-width:100%;max-height:100%;min-width:0;min-height:0;margin:0;gap:1px;align-self:center}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-axis{display:grid;place-items:center;min-height:0;font-size:clamp(7px,1.2cqw,11px);line-height:1;color:var(--prep-muted,var(--muted));overflow:hidden}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;width:auto;height:auto;min-width:0;min-height:0;aspect-ratio:auto;padding:0;border:1px solid #4c5c47;border-radius:1px;line-height:1;font-size:clamp(7px,1.3cqw,11px);background:#3a4735;overflow:hidden;touch-action:manipulation}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell.forest{background:#1e3c2a}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell.river{background:repeating-linear-gradient(135deg,#293839,#293839 4px,#354748 4px,#354748 6px);border-color:#4c5d5b}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell.enemy{background:#633e32;color:#ffd7bd}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell.enemy i{font-size:clamp(7px,1.2cqw,11px);font-style:normal}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell.spawn{border:1px solid #a7bc91;background:#354e37;color:#d5e3c4}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell.occupied{border-color:#d1b86d;background:#66572f;color:#fff1bc}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell.placeable{box-shadow:inset 0 0 0 1px #c8dfb4}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell.placing{background:#d7b779!important;color:#17271c!important;border:2px solid #fff2c6;box-shadow:none}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell b{font-size:clamp(8px,2cqh,17px);line-height:1}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell small{display:none;min-width:0;max-width:100%;font-size:8px;line-height:1;white-space:nowrap;margin-top:1px;overflow:hidden}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-lock{position:absolute;right:0;top:0;font-size:clamp(5px,.8cqw,8px);line-height:1;color:inherit}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-cell:focus-visible{outline:2px solid #fff0a3;outline-offset:-2px;z-index:1}
:is(#deployment-scene,#shop-scene) .deployment-compact .deployment-map-key{display:flex;align-items:center;justify-content:center;gap:4px 10px;flex-wrap:wrap;min-width:0;padding:4px 6px;font-size:10px;line-height:1.4;color:var(--prep-muted,var(--muted))}
.deployment-map-key>span{white-space:nowrap}
.deployment-map-key i{display:inline-block;width:8px;height:8px;margin-right:4px;background:#78996a}
.deployment-map-key i.enemy{background:#ac6a53}.deployment-map-key i.forest{background:#326043}.deployment-map-key i.blocked{background:#667c7c}
:is(#deployment-scene,#shop-scene) .deployment-compact .deployment-selection-panel{display:grid;grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr);gap:6px;width:100%;min-height:0;min-width:0;padding:0;border:0;background:transparent;overflow:hidden}
:is(#deployment-scene,#shop-scene) .deployment-compact .deployment-roster-heading{display:flex;align-items:center;justify-content:space-between;gap:6px;margin:0;min-height:40px;flex-wrap:nowrap}
:is(#deployment-scene,#shop-scene) .deployment-compact .deployment-roster-heading h4{margin:0;font-size:15px;line-height:1.4;color:var(--prep-ink,var(--text))}
.deployment-roster-heading h4 small{font-size:12px;font-weight:400;color:var(--prep-muted,var(--muted))}
:is(#deployment-scene,#shop-scene) .deployment-compact .deployment-roster-heading>button{margin:0;min-height:44px;padding:5px 9px;font-size:13px;line-height:1.3;white-space:nowrap}
.deployment-selection-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:8px;padding:6px 8px;border:1px solid var(--prep-line,var(--line));border-radius:4px;background:var(--prep-bg,#0e1b15)}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-selection{min-height:0;margin:0;padding:0;border:0;background:transparent;font-size:12px;line-height:1.5;color:var(--gold);overflow-wrap:anywhere}
:is(#deployment-scene,#shop-scene) .deployment-compact .deployment-selection-toolbar>button{min-width:64px;min-height:44px;padding:5px 8px;font-size:13px;line-height:1.3;white-space:nowrap;touch-action:manipulation}
:is(#deployment-scene,#shop-scene) .deployment-compact .deployment-roster-track{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:max-content;align-content:start;gap:6px;min-height:0;min-width:0;overflow-x:hidden;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scroll-snap-type:none;padding:2px}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:stretch;position:relative;min-width:0;min-height:0;margin:0;padding:0;border:1px solid var(--prep-line,var(--line));border-radius:4px;background:var(--prep-panel-raised,#223427);overflow:hidden;scroll-snap-align:none}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card.in-sortie{border-color:#a09460}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card.placing{border-color:var(--gold);background:#46482e;box-shadow:inset 0 0 0 1px var(--gold)}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card-main{display:flex;align-items:center;gap:6px;width:100%;min-width:0;min-height:72px;padding:6px;border:0;border-radius:0;text-align:left;background:transparent;touch-action:manipulation}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card-main .battle-sprite{position:static;inset:auto;width:30px!important;height:44px!important;flex:0 0 30px;display:block;transform:none;object-fit:contain;margin:0}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card-main .promotion-aura{display:none}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card-main>span:last-child{min-width:0;flex:1}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card-main b{display:block;font-size:14px;line-height:1.3;white-space:normal;overflow-wrap:normal;word-break:keep-all}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card-main small{display:block;font-size:11px;line-height:1.4;color:var(--prep-muted,var(--muted));white-space:normal;word-break:keep-all}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card-main b small{display:inline;font-size:10px;color:var(--gold);white-space:nowrap}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-card-main .deploy-card-status{font-size:10px;color:var(--gold)}
:is(#deployment-scene,#shop-scene) .deployment-compact .hero-placeholder{display:grid;place-items:center;width:30px;min-width:30px;font-size:22px;color:var(--gold)}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-remove{position:static;align-self:stretch;width:auto;min-width:36px;min-height:48px;margin:0;padding:4px;font-size:11px;line-height:1.3;border:0;border-left:1px solid var(--prep-line,var(--line));border-radius:0;background:#17271d;touch-action:manipulation}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-actions{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;justify-content:stretch;gap:8px;margin:0;padding:7px 0 0;min-height:0;max-width:100%;border-top:1px solid var(--prep-line,var(--line));background:var(--prep-panel,#14221b)}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-actions .deploy-message{min-width:0;max-width:none!important;width:auto;margin:0;padding:0;font-size:12px!important;line-height:1.4;color:var(--prep-muted,var(--muted))}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-actions>button{width:auto;min-width:0;min-height:48px;padding:7px 12px;font-size:14px;line-height:1.4;white-space:normal;word-break:keep-all;touch-action:manipulation}
:is(#deployment-scene,#shop-scene) .deployment-compact .deploy-actions .primary{min-width:170px;font-size:15px}
#shop-scene .prep-content[data-page="deployment"] .prep-main{display:flex;min-height:0;overflow:hidden}
#shop-scene .prep-content[data-page="deployment"] .deployment-compact{flex:1;min-height:0}
.deployment-details-dialog,.deployment-slot-dialog{width:min(600px,calc(100vw - 24px));max-width:calc(100vw - 24px);max-height:calc(100dvh - 24px);overflow:auto;background:var(--prep-panel,#202a31);color:var(--prep-ink,var(--text));border:1px solid var(--prep-accent,var(--gold));padding:16px}
.deployment-details-dialog .dialog-heading,.deployment-slot-dialog .dialog-heading{display:flex;align-items:center;justify-content:space-between;gap:10px}
.deployment-slot-dialog .dialog-heading h3{min-width:0;margin:0;font-size:20px;line-height:1.4}
.deployment-slot-dialog button{min-height:48px;font-size:15px;touch-action:manipulation}
