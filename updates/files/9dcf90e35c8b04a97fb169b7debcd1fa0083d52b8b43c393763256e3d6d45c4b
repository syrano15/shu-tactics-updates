.battle-result-summary{position:absolute;left:50%;bottom:7px;transform:translateX(-50%);max-width:calc(100% - 16px);width:max-content;padding:7px 12px;border:1px solid #9c895c99;background:#102119ed;color:#e8e2cd;box-shadow:0 3px 15px #0005;z-index:7;pointer-events:none;text-align:center;line-height:1.45;border-radius:3px}
.battle-result-title{display:block;font-size:12px;color:#d7bd7e;margin-bottom:2px}.battle-result-row,.battle-result-detail{margin:0;font-size:11px;overflow-wrap:anywhere}.battle-result-detail{color:#becbb7;font-size:10px}
.battle-result-mark{position:absolute;transform:translate(-50%,-35%);display:block;padding:3px 7px;max-width:calc(100% - 12px);background:#0c1815f0;border:1px solid #cdb88699;border-radius:3px;color:#f5e5bd;font-size:14px;line-height:1.25;font-weight:800;text-shadow:0 1px 2px #000;z-index:8;pointer-events:none;white-space:nowrap;animation:battle-result-rise .28s ease-out both}
.battle-result-mark.is-critical{color:#ff6b62;border-color:#ff766b;font-size:26px;font-weight:950;background:#210907f2;text-align:center;box-shadow:0 0 12px #ac25184d}
.battle-critical-label{display:block;font-size:12px;line-height:1.3;font-weight:900}.battle-critical-number{display:block;font-size:inherit;font-weight:950;font-variant-numeric:tabular-nums}.battle-critical-retreat{display:block;font-size:11px}
.token.is-critical-shaken{animation:battle-critical-shake .24s ease-out both}
@keyframes battle-critical-shake{0%,100%{translate:0 0}15%,45%{translate:-4px 0}30%,60%{translate:4px 0}75%{translate:-2px 0}90%{translate:2px 0}}.battle-result-mark.is-miss{color:#d3e7dc;border-color:#a4c6b9}.battle-result-mark.is-status{color:#d7c4ed;border-color:#ab8bc6}.battle-result-mark.is-retreat{border-color:#e6a88b}
@keyframes battle-result-rise{from{opacity:0;transform:translate(-50%,15%)}to{opacity:1;transform:translate(-50%,-35%)}}
@media(max-width:620px){.battle-result-summary{padding:5px 8px;bottom:4px}.battle-result-title{font-size:11px}.battle-result-row{font-size:10px}.battle-result-detail{font-size:9px}.battle-result-mark{font-size:12px;padding:2px 5px}.battle-result-mark.is-critical{font-size:21px}.battle-critical-label{font-size:10px}}
@media(prefers-reduced-motion:reduce){.battle-result-mark,.token.is-critical-shaken{animation:none}}

/* A brief impact bloom belongs to the struck cell; the camera remains stationary. */
.battle-critical-shock{position:absolute;z-index:43;pointer-events:none;width:100px;height:100px;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,#fff0e2e8 0,#ff5748cc 12%,#da172276 35%,transparent 65%);filter:drop-shadow(0 0 8px #c71520);animation:battle-critical-shock .42s ease-out both}
.battle-critical-shock::before,.battle-critical-shock::after{content:"";position:absolute;left:8%;top:48%;width:84%;height:5px;background:linear-gradient(90deg,transparent,#fff5e8,#ff4e43,transparent);transform:rotate(35deg)}.battle-critical-shock::after{transform:rotate(-35deg)}
@keyframes battle-critical-shock{0%{opacity:0;transform:translate(-50%,-50%) scale(.45)}20%{opacity:1;transform:translate(-50%,-50%) scale(1)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.4)}}
@media(prefers-reduced-motion:reduce){.battle-critical-shock{display:none}}

/* Officer defeats have their own long-lived, click-through morale feedback. */
.has-officer-morale-result:not(#board-stage){position:relative}
.battle-officer-morale-banner{position:absolute;left:50%;top:10px;transform:translateX(-50%);z-index:78;pointer-events:none;width:max-content;max-width:calc(100% - 20px);padding:12px 24px;background:linear-gradient(120deg,#231d0af5,#10261ef5);border:2px solid #e9c369;border-radius:7px;box-shadow:0 5px 28px #0009,0 0 18px #e5bd6133;text-align:center;line-height:1.45;animation:battle-morale-banner-in .22s ease-out both}
.battle-officer-morale-title{display:block;color:#ffe3a0;font-size:clamp(18px,2vw,25px);font-weight:900;letter-spacing:.05em;text-shadow:0 2px 3px #000;margin-bottom:4px;overflow-wrap:anywhere}
.battle-officer-morale-team{margin:1px 0;font-size:clamp(12px,1.2vw,16px);font-weight:800;overflow-wrap:anywhere}.battle-officer-morale-team.is-enemy{color:#ff9b8d}.battle-officer-morale-team.is-ally{color:#a3efb1}
.battle-morale-layer{position:absolute;z-index:44;pointer-events:none;overflow:hidden;contain:paint}
.battle-morale-mark{position:absolute;transform:translateX(-50%);z-index:3;padding:3px 5px;background:#0c1913ed;border:1px solid currentColor;border-radius:4px;font-weight:900;line-height:1.3;white-space:nowrap;text-shadow:0 1px 2px #000;pointer-events:none;animation:battle-morale-mark-in .25s ease-out both}
.battle-morale-mark.is-up{color:#a0f5b0;box-shadow:0 0 10px #53cd6a44}.battle-morale-mark.is-down{color:#ff9a88;background:#26100bed;box-shadow:0 0 10px #e8523344}
.battle-morale-ring{position:absolute;transform:translate(-50%,-50%);border:3px solid currentColor;border-radius:50%;pointer-events:none;animation:battle-morale-ring-pulse .8s ease-out 3 both}.battle-morale-ring.is-up{color:#83f398;box-shadow:0 0 14px #7ce99188}.battle-morale-ring.is-down{color:#ff8976;box-shadow:0 0 14px #ff745b88}
.token.is-morale-up{animation:battle-morale-token-up .7s ease-in-out 3}.token.is-morale-down{animation:battle-morale-token-down .7s ease-in-out 3}
@keyframes battle-morale-banner-in{from{opacity:0;transform:translate(-50%,-8px)}to{opacity:1;transform:translate(-50%,0)}}
@keyframes battle-morale-mark-in{from{opacity:0;transform:translate(-50%,10px)}to{opacity:1;transform:translate(-50%,0)}}
@keyframes battle-morale-ring-pulse{0%{opacity:.95;transform:translate(-50%,-50%) scale(.75)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.45)}}
@keyframes battle-morale-token-up{50%{filter:drop-shadow(0 0 8px #93efa1) brightness(1.25)}}
@keyframes battle-morale-token-down{50%{filter:drop-shadow(0 0 8px #f67865) brightness(.85)}}
@media(max-width:620px){.battle-officer-morale-banner{top:7px;padding:8px 12px}.battle-officer-morale-title{font-size:18px}.battle-officer-morale-team{font-size:11px}.battle-morale-mark{padding:2px 4px}}
@media(prefers-reduced-motion:reduce){.battle-officer-morale-banner,.battle-morale-mark,.token.is-morale-up,.token.is-morale-down{animation:none}.battle-morale-ring{display:none}}

/* Morale remains visible when the commander choice replaces the battlefield. */
.boss-morale-result{border:1px solid #d7b779;background:#102119;padding:12px 15px;margin-bottom:16px;text-align:center;border-radius:4px}.boss-morale-result>strong{font-size:23px;color:#f2d294}.boss-morale-result p{margin:5px 0;font-weight:800}.boss-morale-result .morale-enemy{color:#ff9687}.boss-morale-result .morale-ally{color:#98e7b7}.result-scene{position:relative}
.result-scene .battle-officer-morale-banner{left:auto;right:18px;top:18px;max-width:min(320px,calc(100% - 36px));transform:none;animation:none}
