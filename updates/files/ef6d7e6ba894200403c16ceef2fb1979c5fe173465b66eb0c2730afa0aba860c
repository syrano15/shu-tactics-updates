 const selected=new Set(effect.cells.map(pairKey)),hits=[];
 const fleet=revised||state.enemyProgressionVersion===3&&terrainChapter(state)?.act!==6;
 const units=fleet?[...state.units,...(state.reinforcements?.pending??[]).flatMap(w=>w.units)]:state.units;
 for(const unit of units.filter(u=>u.hp>0&&(fleet&&u.team==='enemy'||selected.has(u.x+','+u.y)))){
  const ratio=fleet&&unit.team==='enemy'?CHIBI_ENEMY_FIRE_RATIO:effect.damageRatio;
  const beforeHp=unit.hp,damage=revised&&unit.team==='enemy'?Math.min(beforeHp,3000):Math.min(beforeHp-1,Math.floor(unit.maxHp*ratio));unit.hp-=damage;
