  // The expanded fleet loses its fighting spirit once when the fire strikes.
  // This environmental shock is independent of the fixed troop-strength rule.
  if(fleet&&state.campaignLayoutVersion===1&&unit.team==='enemy')unit.morale=Math.min(unit.morale,60);
  hits.push({unitId:unit.id,maxHp:unit.maxHp,beforeHp,damage,afterHp:unit.hp});
  if(state.battleRecords?.minHpRatios&&state.units.includes(unit))state.battleRecords.minHpRatios[unit.id]=Math.min(state.battleRecords.minHpRatios[unit.id]??1,unit.hp/unit.maxHp);
 }
 state.shipFire={event:index,round:state.round,cells:structuredClone(effect.cells),hits,...(revised?{rulesVersion:1}:{})};return true;
}
