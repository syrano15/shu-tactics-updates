.sfx-settings{display:flex;align-items:center;gap:4px;position:relative}.sfx-volume-menu{position:relative}.sfx-volume-menu>summary{cursor:pointer;color:var(--muted,#bdc6b5);padding:8px 6px;font-size:.72rem;list-style:none}.sfx-volume-menu>summary::-webkit-details-marker{display:none}.sfx-volume-panel{position:absolute;right:0;top:calc(100% + 5px);z-index:1200;width:240px;padding:14px;background:#182e24;border:1px solid #8b794b;border-radius:5px;box-shadow:0 10px 28px #0008;color:#e4dabf}.sfx-volume-panel label{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:.8rem}.sfx-volume-panel input{width:100%;accent-color:#d7b574;margin:14px 0 5px}.sfx-volume-panel small{font-size:.68rem;color:#adb6a5;line-height:1.5;display:block}.sfx-volume-panel output{color:#e6c780}@media(max-width:600px){.sfx-volume-panel{right:0;width:210px}}

.sfx-volume-panel{max-height:calc(100dvh - 100px);overflow:auto}.sfx-volume-panel hr{border:0;border-top:1px solid #8b794b66;margin:12px 0}.sfx-volume-panel #bgm-toggle{display:block;width:100%;margin:0 0 12px}
