// Removed chapters use explicit redirects; old reward IDs remain historical receipts.
export const RETIRED_CHAPTERS = {};
export function resolveChapterId(id){
 const matches=CHAPTERS.filter(ch=>ch.id===id||ch.aliases?.includes(id));
 if(matches.length!==1)throw new Error('알 수 없거나 중복된 장 ID입니다: '+id);
 return matches[0];
}
export function sortieInfo(ch,ids=[]){
 const fixedGuests=ch.fixedGuests??[],regularMax=ch.regularSortie??ch.maxSortie;
 if(!Array.isArray(fixedGuests)||new Set(fixedGuests).size!==fixedGuests.length||!Number.isInteger(regularMax)||regularMax<1||regularMax>(ch.campaignLayoutVersion===1?18:6)||ch.maxSortie!==regularMax+fixedGuests.length||fixedGuests.some(id=>!UNIT_TEMPLATES[id]?.playable||ch.required?.includes(id)||ch.unavailable?.includes(id)))throw new Error('고정 동행 편성 설정 오류');
 return {fixedGuests:[...fixedGuests],regularMax,regularCount:ids.filter(id=>!fixedGuests.includes(id)).length,totalMax:ch.maxSortie};
}
export function positionLockedIndices(ch){const ids=Array.isArray(ch.positionLocked)?ch.positionLocked:ch.lockRequired?ch.required:[];if(new Set(ids).size!==ids.length||ids.some(id=>!ch.required.includes(id)))throw new Error('위치 고정 설정 오류');return ids.map(id=>ch.required.indexOf(id));}
export function sortieIds(ch,army,selection=null){
 const owned=army?army.joined.filter(id=>!army.heroes[id]?.departed):STARTING_HEROES;
 if(!Number.isInteger(ch.maxSortie)||ch.maxSortie<1||typeof ch.fixed!=='boolean'||!Array.isArray(ch.required)||!Array.isArray(ch.unavailable))throw new Error('편성 설정 오류');
 const {fixedGuests,regularMax}=sortieInfo(ch);
 if(new Set(ch.required).size!==ch.required.length||new Set(ch.unavailable).size!==ch.unavailable.length||ch.required.length>regularMax)throw new Error('필수 출전 목록 오류');
 if(ch.required.some(id=>!owned.includes(id)||!UNIT_TEMPLATES[id]?.playable||ch.unavailable.includes(id))||selection===null&&fixedGuests.some(id=>!owned.includes(id)))throw new Error('필수 장수가 미합류 또는 출전 불가입니다.');
 const recommended=ch.act===4&&selection===null&&Array.isArray(ch.act4SuggestedSortie)?ch.act4SuggestedSortie:[];
 const optional=[...new Set([...recommended,...owned])].filter(id=>owned.includes(id)&&!ch.required.includes(id)&&!fixedGuests.includes(id)&&!ch.unavailable.includes(id));
 const defaults=[...ch.required,...optional].slice(0,regularMax);
 // Explicit historical selections retain their original six slots and may omit a later fixed guest.
 const ids=ch.fixed?ch.required:(selection??[...defaults,...fixedGuests]);
 if(!Array.isArray(ids)||!ids.length||ids.length>ch.maxSortie||new Set(ids).size!==ids.length||sortieInfo(ch,ids).regularCount>regularMax||ch.required.some(id=>!ids.includes(id))||ids.some(id=>!owned.includes(id)||ch.unavailable.includes(id)||!UNIT_TEMPLATES[id]?.playable))throw new Error('출전 명단 오류');
 if(positionLockedIndices(ch).some(i=>ids[i]!==ch.required[i]))throw new Error('필수 장수는 앞 슬롯 순서를 유지해야 합니다.');
 return [...ids];
}
// Intermission and the next act use this same chapter-ID progression. Battle rules stay in the engine.
export class Campaign {
  constructor() { this.chapter = 0; this.stage = 'preDialogue'; this.line = 0; this.result = null; this.lastVictoryId = null; this.sortie=null; this.draft=null;this.draftSlots=null;this.sortieSlots=null; }
  get scenario() { return CHAPTERS[this.chapter]; }
  get act() { return this.scenario?.act??1; }
  get lines() { return this.stage === 'preDialogue' ? this.scenario.pre : this.stage==='defeatDialogue'?this.scenario.defeatDialogue:campaignDialogueLines(this,this.scenario.post); }
  nextDialogue() {
    if (!['preDialogue', 'postDialogue','defeatDialogue'].includes(this.stage)) throw new Error('대화 중에만 진행할 수 있습니다.');
    if (this.line + 1 < this.lines.length) this.line++; else this.finishDialogue();
  }
  finishDialogue() {
    if (this.stage === 'preDialogue') this.stage = !this.scenario.fixed&&this.scenario.required.length<this.scenario.maxSortie?'deployment':'battle';
    else if (this.stage === 'postDialogue') this.stage = 'intermission';
    else if(this.stage==='defeatDialogue')this.stage='result';
    else throw new Error('대화 중이 아닙니다.');
    this.line = 0;
  }
  confirmDeployment(army) {
    if(this.stage!=='deployment')throw new Error('편성 중이 아닙니다.');
    if(!Array.isArray(this.draft))throw new Error('출전할 장수를 선택하세요.');
    const ids=sortieIds(this.scenario,army,this.draft);
    if(sortieInfo(this.scenario).fixedGuests.some(id=>!ids.includes(id)))throw new Error('고정 동행 장수는 반드시 출전합니다.');
    this.sortie=ids;this.sortieSlots=this.draftSlots?[...this.draftSlots]:null;this.draft=null;this.draftSlots=null;this.stage='battle';
  }
  resolve(result) {
    if (this.stage !== 'battle' || !['victory', 'defeat'].includes(result)) throw new Error('전투 결과가 올바르지 않습니다.');
    this.result = result; if(result==='victory')this.lastVictoryId=this.scenario.id; this.stage = result==='defeat'&&this.scenario.defeatDialogue?.length?'defeatDialogue':'result';
  }
  afterVictory() {
    if (this.stage !== 'result' || this.result !== 'victory') throw new Error('승리 후에만 전후 대화로 진행합니다.');
    this.stage = 'postDialogue'; this.line = 0;
  }
  nextChapter() {
    if (this.stage !== 'intermission') throw new Error('다음 전투로 이동할 수 없습니다.');
    if (this.chapter + 1 >= CHAPTERS.length) { this.stage = 'complete'; return; }
    const previousAct=this.act;
    this.chapter++; this.stage = 'preDialogue'; this.line = 0; this.result = null; this.sortie=null;this.draft=null;this.draftSlots=null;this.sortieSlots=null;
    if(this.nextDraft?.chapterId===this.scenario.id){this.draft=[...this.nextDraft.ids];this.draftSlots=[...this.nextDraft.slots];}delete this.nextDraft;
    return previousAct!==this.act?{act:this.act,title:this.scenario.episodeTitle??this.scenario.subtitle,chapterId:this.scenario.id}:null;
  }
  retry() { this.stage = 'battle'; this.result = null; this.line = 0; }
}
