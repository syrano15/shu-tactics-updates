.skill-map-layer{--skill-color:#ffd47a;--skill-hot:#fff7cc;position:absolute;z-index:66;overflow:hidden;pointer-events:none;isolation:isolate}
.skill-map-layer.is-dragon{--skill-color:#7cffe0;--skill-hot:#effff7}.skill-map-layer.is-storm{--skill-color:#ffbd57;--skill-hot:#fff2b9}.skill-map-layer.is-oath{--skill-color:#ffd874;--skill-hot:#fff8d1}.skill-map-layer.is-fire{--skill-color:#ff701f;--skill-hot:#fff095}.skill-map-layer.is-spear{--skill-color:#8fe6ff;--skill-hot:#fff}.skill-map-layer.is-relief,.skill-map-layer.is-supply{--skill-color:#91edbf;--skill-hot:#ecffdd}
.skill-map-caster,.skill-map-impact,.skill-map-counter{position:absolute;transform:translate(-50%,-50%);pointer-events:none;color:var(--skill-color);filter:drop-shadow(0 0 8px var(--skill-color));contain:layout style}
.skill-map-core,.skill-map-ray,.skill-map-glyph{position:absolute;display:block;left:50%;top:50%;transform:translate(-50%,-50%);box-sizing:border-box;pointer-events:none}
.skill-map-core{width:115%;height:115%;border:3px solid var(--skill-hot);border-radius:50%;background:radial-gradient(circle,#fff9 0%,color-mix(in srgb,var(--skill-color) 55%,transparent) 30%,transparent 70%);animation:skill-impact-burst .65s ease-out both;box-shadow:0 0 18px var(--skill-color),inset 0 0 15px var(--skill-color)}
.skill-map-ray{height:6%;width:165%;background:linear-gradient(90deg,transparent,var(--skill-hot),var(--skill-color),transparent);border-radius:50%;animation:skill-impact-ray .75s ease-out both;--ray-angle:-35deg}
.skill-map-ray.ray-two{--ray-angle:35deg}.skill-map-ray.ray-three{--ray-angle:90deg;width:135%}
.skill-map-glyph{font-family:'Noto Serif KR','Malgun Gothic',serif;font-size:clamp(23px,3vw,48px);font-weight:900;text-shadow:0 0 12px var(--skill-color),0 2px 2px #000;animation:skill-caster-sigil .75s ease-out both}
.skill-map-value{position:absolute;left:50%;top:0;transform:translate(-50%,-55%);color:#fff5d4;font-size:var(--skill-label-size,14px);font-weight:950;line-height:1.25;text-align:center;white-space:nowrap;text-shadow:0 2px 2px #000,0 0 4px #000;background:#081611d9;padding:3px 5px;border-radius:3px;animation:skill-value-rise .75s ease-out both}
.skill-map-caster .skill-map-core{width:150%;height:150%;border-style:double;border-width:5px;animation:skill-caster-ring .8s ease-out both}.skill-map-caster .skill-map-ray{display:none}
.skill-map-title{position:absolute;z-index:69;transform:translateX(-50%);display:flex;gap:10px;align-items:baseline;max-width:min(430px,85%);padding:6px 14px;border:1px solid #c7af69;background:#0a1b18ef;color:#ffe4a2;white-space:nowrap;overflow:hidden;border-radius:3px;box-shadow:0 0 15px #0008;pointer-events:none}.skill-map-title strong{font-size:18px}.skill-map-title small{font-size:11px;color:#dce4d5}
.is-oath .skill-map-impact .skill-map-core,.is-relief .skill-map-impact .skill-map-core,.is-supply .skill-map-impact .skill-map-core{border-radius:25%;height:150%;width:90%;background:linear-gradient(0deg,color-mix(in srgb,var(--skill-color) 75%,transparent),transparent);animation:skill-support-column .85s ease-out both}
.is-oath .skill-map-impact .skill-map-ray,.is-relief .skill-map-impact .skill-map-ray,.is-supply .skill-map-impact .skill-map-ray{width:12%;height:100%;--ray-angle:0deg;left:25%}.is-oath .skill-map-impact .ray-two,.is-relief .skill-map-impact .ray-two,.is-supply .skill-map-impact .ray-two{left:75%}.is-oath .skill-map-impact .ray-three,.is-relief .skill-map-impact .ray-three,.is-supply .skill-map-impact .ray-three{width:85%;height:7%;top:80%}
.is-dragon .skill-map-impact .skill-map-core{border:0;border-left:8px solid var(--skill-hot);border-bottom:5px solid var(--skill-color);width:155%;height:95%;transform:translate(-50%,-50%) rotate(-35deg);animation:skill-dragon-cut .8s ease-out both}
.is-storm .skill-map-impact .skill-map-ray{height:10%;width:185%}.is-storm .skill-map-caster .skill-map-core{width:230%;height:230%;border:6px double var(--skill-hot)}
.is-spear .skill-map-impact .skill-map-ray{width:220%;height:9%;--ray-angle:-15deg}.is-spear .skill-map-impact .ray-two{width:160%;height:5%;--ray-angle:0deg}.is-spear .skill-map-impact .ray-three{display:none}
.is-fire .skill-map-impact .skill-map-core{width:105%;height:180%;border:0;border-radius:65% 35% 45% 45%;transform-origin:50% 100%;background:radial-gradient(ellipse at 50% 80%,#fff4ae 5%,#ffb429 25%,#f34c12 55%,#ac231366 70%,transparent 80%);animation:skill-fire-column .8s ease-out both}
.is-fire .skill-map-impact .skill-map-ray{width:12%;height:135%;top:30%;--ray-angle:12deg;background:linear-gradient(0deg,#ffa825,transparent);animation:skill-fire-sparks .8s ease-out both}.is-fire .skill-map-impact .ray-two{left:25%;--ray-angle:-15deg}.is-fire .skill-map-impact .ray-three{left:75%;--ray-angle:25deg}
.skill-map-impact.is-miss{filter:none;opacity:.7}.skill-map-impact.is-miss .skill-map-core{background:none;border:1px dashed #d0dacf;box-shadow:none}.skill-map-impact.is-miss .skill-map-ray{display:none}.skill-map-impact.is-miss .skill-map-value{color:#d8e2d3}
@keyframes skill-impact-burst{0%{opacity:0;transform:translate(-50%,-50%) scale(.25)}25%{opacity:1;transform:translate(-50%,-50%) scale(.95)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.55)}}
@keyframes skill-impact-ray{0%{opacity:0;transform:translate(-50%,-50%) rotate(var(--ray-angle)) scaleX(.1)}25%{opacity:1;transform:translate(-50%,-50%) rotate(var(--ray-angle)) scaleX(1)}100%{opacity:0;transform:translate(-50%,-50%) rotate(var(--ray-angle)) scaleX(1.2)}}
@keyframes skill-caster-sigil{0%{opacity:0;transform:translate(-50%,-40%) scale(.6)}25%,65%{opacity:1;transform:translate(-50%,-50%) scale(1.05)}100%{opacity:0;transform:translate(-50%,-60%) scale(1.2)}}
@keyframes skill-caster-ring{0%{opacity:0;transform:translate(-50%,-50%) scale(.35)}35%{opacity:1}100%{opacity:0;transform:translate(-50%,-50%) scale(1.4)}}
@keyframes skill-support-column{0%{opacity:0;transform:translate(-50%,0) scaleY(.1)}25%,65%{opacity:1;transform:translate(-50%,-50%) scaleY(1)}100%{opacity:0;transform:translate(-50%,-65%) scaleY(1.15)}}
@keyframes skill-dragon-cut{0%{opacity:0;transform:translate(-65%,-55%) rotate(-70deg) scale(.3)}30%{opacity:1;transform:translate(-50%,-50%) rotate(-35deg) scale(1)}100%{opacity:0;transform:translate(-35%,-45%) rotate(10deg) scale(1.25)}}
@keyframes skill-fire-column{0%{opacity:0;transform:translate(-50%,-30%) scale(.3,.1)}30%,65%{opacity:1;transform:translate(-50%,-60%) scale(1,1.05)}100%{opacity:0;transform:translate(-50%,-75%) scale(.8,1.2)}}
@keyframes skill-fire-sparks{0%{opacity:0;transform:translate(-50%,-25%) rotate(var(--ray-angle)) scaleY(.1)}30%{opacity:1}100%{opacity:0;transform:translate(-50%,-100%) rotate(var(--ray-angle)) scaleY(1)}}
@keyframes skill-value-rise{0%{opacity:0;transform:translate(-50%,10%)}25%,65%{opacity:1;transform:translate(-50%,-55%)}100%{opacity:0;transform:translate(-50%,-110%)}}
.skill-map-layer.is-preparing .skill-map-caster .skill-map-core{animation:skill-charge-ring .38s ease-out both}.skill-map-layer.is-preparing .skill-map-caster .skill-map-glyph{animation:skill-charge-glyph .38s ease-out both}.skill-map-layer.is-impact .skill-map-caster .skill-map-core{animation:skill-release-ring .55s ease-out both}.skill-map-layer.is-impact .skill-map-caster .skill-map-glyph{animation:skill-caster-sigil .65s ease-out both}
.skill-map-counter .skill-map-core,.skill-map-counter .skill-map-ray,.skill-map-counter .skill-map-glyph{display:none}.skill-map-counter .skill-map-value{top:80%;color:#ffd0ac}
@keyframes skill-charge-ring{0%{opacity:0;transform:translate(-50%,-50%) scale(1.3) rotate(-30deg)}65%,100%{opacity:.8;transform:translate(-50%,-50%) scale(.7) rotate(0deg)}}
@keyframes skill-charge-glyph{0%{opacity:0;transform:translate(-50%,-50%) scale(.65)}100%{opacity:1;transform:translate(-50%,-50%) scale(.9)}}
@keyframes skill-release-ring{0%{opacity:.85;transform:translate(-50%,-50%) scale(.7)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.9)}}
.skill-map-layer.is-reduced-motion *{animation:none!important}.skill-map-layer.is-reduced-motion .skill-map-ray{display:none}.skill-map-layer.is-reduced-motion .skill-map-core{opacity:.55;transform:translate(-50%,-50%);height:100%;width:100%}.skill-map-layer.is-reduced-motion .skill-map-glyph{font-size:26px}.skill-map-layer.is-reduced-motion .skill-map-value{opacity:1}
@media(prefers-reduced-motion:reduce){.skill-map-layer *{animation:none!important}.skill-map-layer .skill-map-ray{display:none}}
