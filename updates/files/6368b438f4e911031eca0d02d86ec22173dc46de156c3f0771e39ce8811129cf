.title-updates{max-width:430px;margin-top:16px;padding:12px 14px;background:#10221ad9;border:1px solid #59704b;border-radius:7px;color:#c9d4c8;font-size:12px}.update-heading{display:flex;align-items:center;gap:12px}.update-heading strong{font-size:19px;color:#e4c276;white-space:nowrap}.update-buttons{display:flex;gap:7px;margin-top:10px;flex-wrap:wrap}.update-buttons button,.update-source button{padding:7px 10px;font-size:12px}.title-updates [hidden]{display:none!important}.title-updates p{white-space:pre-line;font-size:12px;max-height:80px;overflow:auto;margin:10px 0 0}.update-source{margin-top:10px;font-size:11px}.update-source summary{cursor:pointer;color:#a5b5a5}.update-source label{display:block;margin-top:10px}.update-source input{width:100%;box-sizing:border-box;background:#0a1711;border:1px solid #4b614e;color:#dfdfce;padding:6px;margin:5px 0}.update-source small{display:block;margin-top:7px;line-height:1.5}.title-updates button:disabled{opacity:.55}
