export function preparationTransaction(army,id,action,balance,chapter){
 if(action?.kind==='modifyBatch')return preparationUpgradePlan(army,id,action.targets,balance,chapter);
 const before=['sell','buy'].includes(action?.kind)&&!id?null:createUnit(balance,id,'ally',army),candidate=structuredClone(army);let label='',reason='';
 try{
  if(!action)throw new Error('적용할 항목을 선택하세요.');
  const h=candidate.heroes[id];
  if(action.kind==='equip'){equip(candidate,id,action.slot,action.part);label=(action.part?PARTS[action.part].name+' 장착':'장비 해제')+' · 장비 '+(action.slot+1);}
  else if(action.kind==='class'){changeHeroClass(candidate,id,action.cls,chapter);label=balance.classes[action.cls].name+' 병과 변경';}
  else if(action.kind==='specialize'){const result=selectSpecialization(candidate,id,action.key,chapter);if(!result.changed)throw new Error('현재 전문화입니다.');label=result.name+' 전문화';}
  else if(action.kind==='promote'){const result=promoteHero(candidate,id);label=result.nextName+' 승급';}
  else if(action.kind==='fourthSpirit'){selectFourthSpirit(candidate,id,action.key);label=action.key?'네 번째 정신기 · '+SPIRITS[action.key].name:'선택 정신기 해제';}
  else if(action.kind==='modify'){modifyHero(candidate,id,action.key,action.steps??1,chapter,before.maxHp);label=({weapon:before.cls==='strategist'?'지력 단련':'무기 개조',troops:'병력 증편',defense:'방어 개조'}[action.key])+' '+(action.steps??1)+'단계';}
  else if(action.kind==='buy'){buyPart(candidate,action.part,action.quantity,chapter);label=PARTS[action.part].name+' '+action.quantity+'개 구매';}
  else if(action.kind==='sell'){if(!Number.isInteger(action.quantity)||action.quantity<1||action.quantity>(candidate.stock[action.part]??0))throw new Error('판매 수량을 확인하세요.');for(let i=0;i<action.quantity;i++)sellPart(candidate,action.part);label=PARTS[action.part].name+' '+action.quantity+'개 판매';}
  else throw new Error('알 수 없는 정비 항목입니다.');
  validateArmyFeatures(candidate);
 }catch(e){reason=e.message;}
 const after=reason?before:before?createUnit(balance,id,'ally',candidate):null;
 return {before,after,candidate:reason?null:candidate,label,reason,cost:reason?0:army.gold-candidate.gold};
}
export function applyPreparation(army,id,action,balance,chapter){
 const result=preparationTransaction(army,id,action,balance,chapter);if(result.reason)throw new Error(result.reason);
 // No writes occur until the whole operation, including multi-item sales, has validated.
 Object.assign(army,result.candidate);return result;
}
export function stepPreparationUpgrade(ui,army,balance,chapter,key,delta){
 if(!PREPARATION_UPGRADE_KINDS.includes(key)||![1,-1].includes(delta))throw new Error('강화 단계를 확인하세요.');
 const current=currentUpgradeTargets(army,ui.hero,chapter),targets={...(ui.pending?.kind==='modifyBatch'?ui.pending.targets:current)};
 targets[key]+=delta;const plan=preparationUpgradePlan(army,ui.hero,targets,balance,chapter);
 if(plan.reason&&plan.changed)throw new Error(plan.reason);
 if(targets[key]<current[key]||targets[key]>MODIFICATION_MAX)throw new Error('현재 단계부터 15단계까지 목표를 선택하세요.');
 ui.pending=plan.changed?{kind:'modifyBatch',targets}:null;return plan;
}
export function maximizePreparationUpgrade(ui,army,balance,chapter,key){
 if(!PREPARATION_UPGRADE_KINDS.includes(key))throw new Error('강화 항목을 확인하세요.');
 const current=currentUpgradeTargets(army,ui.hero,chapter),targets={...(ui.pending?.kind==='modifyBatch'?ui.pending.targets:current)};
 let target=current[key];
 for(let level=current[key]+1;level<=MODIFICATION_MAX;level++){
  if(!preparationUpgradePlan(army,ui.hero,{...targets,[key]:level},balance,chapter).available)break;
  target=level;
 }
 targets[key]=target;const plan=preparationUpgradePlan(army,ui.hero,targets,balance,chapter);
 if(plan.reason&&plan.changed)throw new Error(plan.reason);
 ui.pending=plan.changed?{kind:'modifyBatch',targets}:null;return plan;
}
