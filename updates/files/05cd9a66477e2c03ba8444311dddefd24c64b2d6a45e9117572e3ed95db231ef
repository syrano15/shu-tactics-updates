import {campaignEnemyOrder} from './campaign-events.js';
import {ENEMY_CHAPTER_PROGRESSION,ENEMY_HP_CAP,ACT2_ENEMY_HEALTH_RATIO,progressionEnemyOrder} from './enemy-progression.js';
// Live difficulty changes leave already recorded water damage and secured
// victories untouched. Only the exact old enemy capacity is valid as history.
export function historicalAct2EnemyCapacity(state,chapter,unit,maxHp){
 if(state?.act2EnemyDifficultyVersion!==1||state.act2EnemyHealthVersion!==1||state.enemyProgressionVersion!==3||chapter?.act!==2||unit?.team!=='enemy'||![0,1].includes(state.act2EnemyDifficultySourceHealthVersion))return false;
 const raw=chapter.enemies?.find(entry=>entry.id===unit.id),profile=ENEMY_CHAPTER_PROGRESSION[chapter.id];if(!raw||!profile)return false;
 const order=progressionEnemyOrder(chapter,campaignEnemyOrder(chapter,raw,state.campaignEventsVersion??0),3,0);
 const hp=({troop:profile[0],elite:profile[1],officer:profile[2],boss:profile[3]})[order.combatTier];
 if(!Number.isInteger(hp))return false;
 const expected=Math.min(ENEMY_HP_CAP,state.act2EnemyDifficultySourceHealthVersion===1?Math.floor(hp*ACT2_ENEMY_HEALTH_RATIO):hp);
 return Number.isInteger(maxHp)&&maxHp===expected;
}
export function historicalAct2PendingHp(state,chapter,unit,snapshot){
 if(!historicalAct2EnemyCapacity(state,chapter,unit,snapshot.maxHp))return null;
 return snapshot.hp===0?0:Math.max(1,Math.min(unit.maxHp,Math.round(snapshot.hp/snapshot.maxHp*unit.maxHp)));
}
