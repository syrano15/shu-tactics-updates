import {HERO_DATA} from './heroes.js';
const object=v=>v!==null&&typeof v==='object'&&!Array.isArray(v);
const ensure=ok=>{if(!ok)throw new Error('조건부 장비 획득 기록이 올바르지 않습니다.');};
export function equipmentDropItems(scenario,targetId,actorId,version=0,campaignEventsVersion=0){
 if(version!==1||scenario.enemies.find(unit=>unit.id===targetId)?.campaignTemplateId&&campaignEventsVersion!==1)return [];
 return (scenario.equipmentDrops??[]).filter(drop=>drop.targetId===targetId&&(!drop.actorId||drop.actorId===actorId)).map(drop=>drop.itemId);
}
export function equipmentDropActors(state,scenario,sources=state.pendingLoot?.sourceUnitIds??[]){
 const targets=new Set((scenario.equipmentDrops??[]).map(drop=>drop.targetId));
 return Object.fromEntries(sources.filter(id=>targets.has(id)).map(id=>[id,state.battleRecords.defeats.find(record=>record.targetId===id)?.actorId]));
}
export function validateEquipmentDropsReceipt(receipt,scenario,parts){
 if(receipt.equipmentDropsVersion===undefined){ensure(receipt.equipmentDropActors===undefined);return;}
 ensure(receipt.equipmentDropsVersion===1&&object(receipt.equipmentDropActors));
 const targets=new Set((scenario.equipmentDrops??[]).map(drop=>drop.targetId)),expected=receipt.sourceUnitIds.filter(id=>targets.has(id)),actors=new Set([...Object.keys(HERO_DATA),...(scenario.extraAllies??[]).map(unit=>unit.id)]);
 ensure(Object.keys(receipt.equipmentDropActors).length===expected.length&&expected.every(id=>Object.hasOwn(receipt.equipmentDropActors,id)&&actors.has(receipt.equipmentDropActors[id])));
 for(const drop of scenario.equipmentDrops??[])ensure(scenario.enemies.some(unit=>unit.id===drop.targetId)&&Object.hasOwn(parts,drop.itemId)&&(!drop.actorId||actors.has(drop.actorId)));
}
