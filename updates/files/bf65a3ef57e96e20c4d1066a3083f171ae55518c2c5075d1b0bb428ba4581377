body.ui-stage-result #game-main,body.ui-stage-complete #game-main{height:calc(100dvh - 46px);display:grid;grid-template-rows:38px minmax(0,1fr);gap:10px}
body.ui-stage-result #game-main>.battle-heading,body.ui-stage-complete #game-main>.battle-heading{margin-bottom:0}
body.ui-stage-result #result-scene,body.ui-stage-complete #result-scene{min-height:0;height:100%;padding:0;text-align:left;overflow:hidden;border:0;background:transparent}
#result-scene>.result-compact{width:100%;max-width:none;margin:0}
.result-compact{height:100%;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:20px;padding:24px;background:radial-gradient(ellipse at 50% 0,#33432d 0,#17271e 65%);border:1px solid #607056;border-radius:8px}
.result-compact .result-verdict{text-align:center;display:flex;flex-direction:column;align-items:center}
.result-compact .result-seal{font:700 clamp(44px,8vh,78px)/1.1 var(--font-heading);color:var(--gold);margin:10px 0 5px}
.result-compact .result-verdict h3{font:600 22px var(--font-heading);margin:4px 0}
.result-compact .result-verdict p{font-size:13px;color:var(--muted);margin:8px 0 0;max-width:640px}
.result-compact .result-growth-summary{width:min(920px,100%);min-height:0;margin:0 auto;display:flex;flex-direction:column}
.result-growth-summary h4{font-size:14px;color:var(--gold);margin:0 0 10px;flex-shrink:0}
.result-growth-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;min-height:0;overflow:auto;align-content:start;scrollbar-width:thin;padding:1px 4px 2px 1px}
.result-growth-officer{display:flex;align-items:center;gap:12px;padding:12px;background:#14261ded;border:1px solid #405941;border-radius:4px;min-width:0}
.result-growth-initial{font:600 27px var(--font-heading);color:var(--gold);flex:0 0 28px;text-align:center}
.result-growth-officer>div{min-width:0}
.result-growth-officer b{display:block;font-size:14px;white-space:nowrap}
.result-growth-officer b small{font-size:9px;color:var(--muted);margin-left:5px;font-weight:400}
.result-growth-officer span:not(.result-growth-initial){font-size:12px;color:var(--muted);white-space:nowrap}
.result-growth-officer i{font-style:normal;color:#68856b;margin:0 3px}
.result-growth-officer>strong{font-size:17px;color:var(--green);margin-left:auto;white-space:nowrap;font-variant-numeric:tabular-nums}
.result-growth-officer>strong small{font-size:9px;color:var(--muted);display:block;text-align:right}
.result-compact .result-actions{display:flex;align-items:center;justify-content:center;gap:12px;margin:0;flex-shrink:0}
.result-compact .result-actions button{min-height:48px;min-width:140px}
.result-compact .result-actions .primary{min-width:240px;min-height:52px;font-size:16px}
.result-compact.result-complete{grid-template-rows:minmax(0,1fr) auto}
.result-complete .result-verdict{justify-content:center}
.result-details-dialog{width:min(850px,calc(100vw - 28px));max-height:85dvh;overflow:auto;text-align:left;padding:24px}
.result-details-dialog .dialog-heading{position:sticky;top:-24px;padding:12px 0;background:#19291ff7;z-index:1}
.result-details-dialog .result-stats{display:flex;justify-content:flex-start;gap:30px;margin:20px 0}
.result-details-dialog .growth-card{margin:18px 0;text-align:left}
.result-details-dialog .reward-card{margin:18px 0;text-align:left}
@media(max-height:760px) and (min-width:900px){.result-compact{padding:16px;gap:14px}.result-compact .result-seal{font-size:56px;margin:6px 0 3px}.result-growth-officer{padding:9px 12px}.result-compact .result-actions .primary{min-height:48px}}
@media(max-width:899px){.result-growth-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.result-compact{gap:14px;padding:18px}.result-growth-officer{padding:9px;gap:8px}.result-growth-officer>strong{font-size:15px}}
@media(max-width:600px){body.ui-stage-result,body.ui-stage-complete{height:auto;overflow:auto}body.ui-stage-result #game-main,body.ui-stage-complete #game-main{height:auto;display:block}body.ui-stage-result #result-scene,body.ui-stage-complete #result-scene{height:auto;overflow:visible}.result-compact{min-height:550px;padding:14px}.result-growth-grid{grid-template-columns:1fr;max-height:300px}.result-compact .result-actions{gap:8px}.result-compact .result-actions button{min-width:90px;padding:8px;font-size:12px}.result-compact .result-actions .primary{min-width:150px;flex:1;font-size:13px}.result-details-dialog{padding:16px}.result-details-dialog .dialog-heading{top:-16px}}
