const statKeys=[['병력','maxHp'],['공격','atk'],['방어','def'],['지력','int'],['이동','move']];
function stats(before,after=before){
 return '<div class="prep-stats" aria-live="polite">'+statKeys.map(([label,key])=>{
  const a=before[key],b=after[key],d=b-a;return '<div class="'+(d?'changed':'')+'"><small>'+label+'</small><b>'+n(a)+(d?' <span aria-hidden="true">→</span> <span class="'+(d>0?'stat-up':'stat-down')+'">'+n(b)+'</span> <em>('+signed(d)+')</em>':'')+'</b></div>';
 }).join('')+'<div><small>사거리</small><b>'+esc(unitRange(before))+(unitRange(after)!==unitRange(before)?' → '+esc(unitRange(after)):'')+'</b></div></div>';
}
export function preparationStatChanges(before,after){
 const rows=statKeys.map(([label,key])=>({label,key,before:before[key],after:after[key],delta:after[key]-before[key]})).filter(row=>row.delta!==0);
 if(unitRange(before)!==unitRange(after))rows.push({label:before.cls==='strategist'?'책략 사거리':'사거리',key:'range',before:unitRange(before),after:unitRange(after),delta:after.max-before.max});
 if(after.cavalryDamageReceived!==null&&after.cavalryDamageReceived!==before.cavalryDamageReceived)rows.push({label:'기병 피해 감소 강화',key:'cavalryGuard'});
 if(after.cavalryDamageDealt!==null&&after.cavalryDamageDealt!==before.cavalryDamageDealt)rows.push({label:'기병 상대 피해 강화',key:'cavalryStrike'});
 return rows;
}
export function preparationGrowthSummary(before,after){
 return preparationStatChanges(before,after).map(row=>row.key==='range'?row.label+' '+row.before+' → '+row.after:row.delta===undefined?row.label:row.label+' '+signed(row.delta)).join(' · ');
}
export function preparationPromotionPreview(army,id,balance){
 const status=promotionStatus(army,id),before=createUnit(balance,id,'ally',army);
 if(status.nextRank===null)return {status,before,after:before,rows:[],summary:''};
 const draft=structuredClone(army);draft.heroes[id].promotion=status.nextRank;
 const after=createUnit(balance,id,'ally',draft);
 return {status,before,after,rows:preparationStatChanges(before,after),summary:preparationGrowthSummary(before,after)};
}
