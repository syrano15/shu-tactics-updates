function detailsPage(army){return meritHTML(army)+'<section class="prep-panel"><h4>장수 성장 · Lv99</h4>'+growthHelpHTML()+'</section><section class="prep-panel"><h4>군단 기록과 정비</h4><p>장수 정보에서 합류·이탈 기록, 능력치 출처와 성장 상황을 확인할 수 있습니다.</p>'+button('장수 정보 보기','data-prep-nav="info"')+'<p>정비를 확정하면 자동 저장됩니다. 현재 전장의 병력·SP는 바꾸지 않으며 다음 출전에 정비 결과를 반영합니다.</p>'+button('저장 · 불러오기','data-prep-nav="save"')+'</section>';}

export function preparationHTML({army,balance,currentChapter,chapter,ui,draft,deploymentContent='',message=''}){
 const history=preparationHistoryIds(army),ids=ui.page==='info'?history:preparationRosterIds(chapter,army);
 if(!ids.includes(ui.hero)){ui.hero=ids[0]??null;ui.slot=0;if(ui.pending?.kind!=='sell')ui.pending=null;}
 if(ui.hero)ui.slot=Math.max(0,Math.min(ui.slot,equipmentSlotCapacity(army,ui.hero)-1));
 const u=ui.hero?createUnit(balance,ui.hero,'ally',army):null,transactionId=ui.hero??history[0],model=ui.pending&&(u||ui.pending.kind==='sell'&&transactionId)?preparationTransaction(army,transactionId,ui.pending,balance,chapter??currentChapter):null;
 let body;
 if(ui.page==='hub')body=hubPage(army,balance,chapter,ui,draft);
 else if(ui.page==='growth')body=chapter?.act===5?act5GrowthSupportHTML(army,chapter):act4GrowthSupportHTML(army,chapter);
 else if(ui.page==='deployment')body=deploymentContent;
 else if(ui.page==='details')body=detailsPage(army);
 else if(['equipment','classes','upgrade','info','spirits'].includes(ui.page)&&!u)body='<section class="prep-panel prep-empty"><p>'+(ui.page==='info'?'조회할 장수 기록이 없습니다.':'다음 출전에 정비할 수 있는 장수가 없습니다.')+'</p>'+button('장수 기록 보기','data-prep-nav="info"',ui.page==='info'||!history.length)+'</section>';
 else if(ui.page==='equipment')body=equipmentPage(army,balance,chapter,ui,u,model);
 else if(ui.page==='classes')body=classesPage(army,balance,chapter,ui,u,model);
 else if(ui.page==='upgrade')body=upgradePage(army,balance,chapter??currentChapter,ui,u,model);
 else if(ui.page==='shop')body=shopPage(army,ui,model);
 else if(ui.page==='info')body=infoPage(army,balance,chapter??currentChapter,ui,u);
 else if(ui.page==='spirits')body=spiritPage(army,ui,u,model);
 else body=briefPage(chapter,army);
 const showRoster=!['hub','deployment','brief','details','growth'].includes(ui.page);
 let footer=model?'<div class="prep-apply-bar'+(ui.page==='equipment'?' prep-equipment-apply':'')+'" role="region" aria-label="선택 항목 적용"><div><small>선택 · '+esc(model.label||'적용 불가')+'</small><p>'+esc(model.reason||(ui.pending.kind==='promote'?preparationGrowthSummary(model.before,model.after):'실제 능력치와 재고를 확인한 뒤 확정하세요.'))+'</p></div><p>'+(model.cost<0?'받는 자금 <b class="stat-up">+'+n(-model.cost)+'</b>':'비용 <b>'+(model.cost?n(model.cost):'0')+'</b>')+' · 적용 후 자금 '+n(army.gold-model.cost)+'</p>'+button('선택 취소','data-prep="cancel"')+button(ui.pending.kind==='sell'?'판매 확정':ui.pending.kind==='promote'?'승급 확정':'적용 확정','data-prep="apply" class="primary"',!!model.reason)+'</div>':'';
 if(ui.page==='upgrade'&&u&&ui.pending?.kind!=='modify')footer=upgradeFooter(army,model?.rows?model:preparationUpgradePlan(army,ui.hero,currentUpgradeTargets(army,ui.hero,chapter??currentChapter),balance,chapter??currentChapter),!!ui.pending);
 if(ui.page==='equipment'&&u&&!model)footer='<div class="prep-apply-bar prep-equipment-apply"><div><small>장비 교체</small><p>'+esc(message||'슬롯과 장비를 선택하면 실제 능력치 변화를 확인할 수 있습니다.')+'</p></div>'+button('선택 취소','disabled',true)+button('적용 확정','class="primary"',true)+'</div>';
 if(ui.page==='hub')footer='<div class="prep-depart prep-apply-bar"><p>정비를 마치면 출전 대화와 편성을 확인합니다.</p>'+button(chapter?'정비 완료 · 출전 대화로 →':'정비 완료 · 여정 마무리 →','data-prep="depart" class="primary"')+'</div>';
 return '<header class="prep-top">'+(ui.page==='hub'?'<div><small>'+esc(currentChapter.title)+' · 전투 후 정비</small><h2>출전 준비</h2></div>':button('← 출전 준비','data-prep-nav="hub"')+'<div><h2>'+PREPARATION_PAGES[ui.page]+'</h2><small>'+esc(chapter?chapter.title+' · 다음 출전 준비':'여정 마무리')+'</small></div>')+'<div class="prep-funds"><small>공용 자금</small><b>'+n(army.gold)+'</b></div>'+button('⚙','data-prep="settings" aria-label="설정"')+'</header><div class="prep-content '+(showRoster?'with-roster':'')+'" data-page="'+esc(ui.page)+'">'+(showRoster?roster(army,balance,chapter,ui):'')+'<div class="prep-main">'+body+'</div></div><p class="prep-message" id="shop-message" role="status">'+esc(message)+'</p>'+footer;
}
