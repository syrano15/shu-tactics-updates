const ordinary=(slot,kind)=>kind==='auto'&&slot==='auto'||kind==='manual'&&/^manual(?:-([2-9]|[1-4][0-9]|5[0-6]))?$/.test(slot);
export function captureCloudCandidate(draft,slotId,kind,libraryKey){
 if(!ordinary(slotId,kind))throw new Error('완료된 보통 자동·수동 기록만 연동합니다.');
 const rawSave=draft.getItem(libraryKey(slotId));if(typeof rawSave!=='string')throw new Error('현재 진행 원문을 확인하지 못했습니다.');
 return {rawSave,slotId,kind};
}
export function createCloudCommitObserver({persistCandidate,coordinator,onNotice=()=>{},refreshUI=()=>{}}){
 let tail=Promise.resolve();
 return result=>{
  if(result?.ok!==true)return Promise.resolve({localCommitted:false,recorded:false});
  const candidate=result.value;
  if(!ordinary(candidate?.slotId,candidate?.kind)||typeof candidate.rawSave!=='string')return Promise.resolve({localCommitted:true,recorded:false});
  const operation=tail.then(async()=>{
   const entry={...candidate,durable:true};
   try{
    // persistCandidate uses separate sync metadata IndexedDB, not game JSON.
    await persistCandidate(entry);
    const status=coordinator?.status?.();
    if(status?.enabled===true&&status.authenticated===true)await coordinator.recordDurableSave(entry);
    await refreshUI();return {localCommitted:true,recorded:true};
   }catch{
    onNotice('로컬 저장은 완료했습니다. 클라우드 연동 대기 기록을 보관하지 못했습니다. 연결을 확인하고 다시 시도해 주세요.');
    return {localCommitted:true,recorded:false};
   }
  });
  tail=operation.catch(()=>{});return operation;
 };
}
