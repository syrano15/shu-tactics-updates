function commitCombatState(resolved){
  // Preserve live unit identities used by selection, the enemy iterator and presentation sessions.
  const units=state.units;
  const live=new Map(units.map(unit=>[unit.id,unit]));
  const reconciled=resolved.units.map(next=>{const unit=live.get(next.id);if(!unit)return next;for(const key of Object.keys(unit))if(!Object.hasOwn(next,key))delete unit[key];Object.assign(unit,next);return unit;});
  units.splice(0,units.length,...reconciled);
  for(const key of Object.keys(state))if(!Object.hasOwn(resolved,key))delete state[key];
  Object.assign(state,resolved);state.units=units;
}
