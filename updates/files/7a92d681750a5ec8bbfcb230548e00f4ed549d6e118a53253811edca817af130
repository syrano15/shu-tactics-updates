  const original=$('board').querySelector('[data-unit-id="'+unit.id+'"]'); if(!original){shortMovementSound=movementSound(unit,{durationMs:180,kind:soundKind});return;}
  const ghost=original.cloneNode(true);ghost.classList.remove('travel-hidden');ghost.classList.add('unit-traveller');ghost.removeAttribute('data-unit-id');ghost.setAttribute('aria-hidden','true');
