}

function battleEvents(stage,chapter,ids){
 const events=structuredClone(chapter.events),effects=stage.eventEffects??[];
 assert(Array.isArray(effects)&&effects.length<=1,'환경 효과 목록');
 for(const effect of effects){
  assert(object(effect)&&Object.keys(effect).every(key=>['eventIndex','terrainEffect','requiresAlive','requiresEnemy'].includes(key))&&integer(effect.eventIndex,0,events.length-1)&&events[effect.eventIndex].trigger.type==='roundStart'&&events[effect.eventIndex].trigger.round===3&&effect.requiresEnemy===true&&Array.isArray(effect.requiresAlive)&&effect.requiresAlive.length===1&&effect.requiresAlive[0]===effect.terrainEffect?.source,'원고 환경 효과 연결');
  validateTerrainEffect(effect.terrainEffect,ids,stage.terrain);
  Object.assign(events[effect.eventIndex],structuredClone(effect));delete events[effect.eventIndex].eventIndex;
 }
 const tactics=stage.act6Tactics;
 if(tactics!==undefined){
  assert(object(tactics)&&Object.keys(tactics).length===1,'서사 전술 목록');
  if(tactics.sleep)assert(stage.id==='s38_langzhong'&&Object.keys(tactics.sleep).length===2&&tactics.sleep.unit==='zhangfei'&&tactics.sleep.untilRound===2,'낭중 기상 시점');
  else if(tactics.retreat)assert(stage.id==='s44_menghuo'&&Object.keys(tactics.retreat).length===3&&tactics.retreat.unit==='e_boss'&&tactics.retreat.hpRatio===.5&&validCell(stage.terrain,tactics.retreat.tile),'맹획 샛길 재배치');
  else if(tactics.escapes){const wuxia=stage.id==='s39_wuxia';assert((wuxia||stage.id==='s45_rattan')&&Object.keys(tactics.escapes).length===3&&tactics.escapes.fromRound===(wuxia?5:3)&&Array.isArray(tactics.escapes.unitIds)&&tactics.escapes.unitIds.length===(wuxia?6:4)&&unique(tactics.escapes.unitIds)&&tactics.escapes.unitIds.every(id=>stage.enemies.some(e=>e.id===id&&e.combatTier==='troop'))&&Array.isArray(tactics.escapes.tiles)&&tactics.escapes.tiles.length===(wuxia?2:3)&&unique(tactics.escapes.tiles.map(tileKey))&&tactics.escapes.tiles.every(tile=>validCell(stage.terrain,tile)),'무협/등갑군 유한 탈출');}
  else assert(false,'알 수 없는 서사 전술');
 }
 return events;
}

function validateMilestones(stage){
 const goals=stage.act6Objectives;
 assert(Array.isArray(goals)&&goals.length===2&&unique(goals.map(goal=>goal.key)),'성장 목표 목록');
 for(const goal of goals)assert(object(goal)&&Object.keys(goal).every(key=>['key','tiles','label'].includes(key))&&/^[a-z][a-z0-9_]*$/.test(goal.key)&&text(goal.label)&&goal.label.length<=40&&Array.isArray(goal.tiles)&&goal.tiles.length>0&&goal.tiles.length<=6&&unique(goal.tiles.map(tileKey))&&goal.tiles.every(tile=>validCell(stage.terrain,tile)),'성장 목표 거점');
 const optional=stage.act6OptionalObjective;
 assert(object(optional)&&Object.keys(optional).every(key=>['type','tiles','label'].includes(key))&&optional.type==='occupyTile'&&text(optional.label)&&optional.label.length<=40&&Array.isArray(optional.tiles)&&optional.tiles.length===1&&optional.tiles.every(tile=>validCell(stage.terrain,tile)),'선택 보급 목표');
 assert(!goals.some(goal=>goal.tiles.some(tile=>tileKey(tile)===tileKey(optional.tiles[0])))&&!(stage.victory.tiles??[]).some(tile=>tileKey(tile)===tileKey(optional.tiles[0])),'선택 목표와 승리/성장 목표 분리');
}

