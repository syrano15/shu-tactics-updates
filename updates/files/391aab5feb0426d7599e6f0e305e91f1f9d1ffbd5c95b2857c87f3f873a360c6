  assert(Array.isArray(stage.size)&&stage.size[0]===size.width&&stage.size[1]===size.height&&size.width>=24&&size.width<=26&&size.height>=18&&size.height<=20,'맵 크기');
  const formation=stage.sortie;
  assert(object(formation)&&formation.fixed===false&&Array.isArray(formation.required)&&formation.required.length>=1&&formation.required.length<=formation.maxSortie&&unique(formation.required)&&Array.isArray(formation.unavailable)&&unique(formation.unavailable)&&formation.maxSortie===ACT6_SORTIE_CAPS[index]&&formation.regularSortie===formation.maxSortie&&!(formation.fixedGuests?.length),'정규/필수 편성');
  const prior=new Set([...CHAPTERS.map(ch=>ch.id),...ACT6_CHAPTER_IDS.slice(0,index)]);
  const owned=Object.values(HERO_DATA).filter(hero=>!hero.guest&&(hero.joinAfterChapter==='start'||prior.has(hero.joinAfterChapter))&&!prior.has(hero.leaveAfterChapter)).map(hero=>hero.id);
