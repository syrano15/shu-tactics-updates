  });
  assert(unique(enemies.map(enemy=>enemy.id))&&enemies.filter(enemy=>enemy.id==='e_boss'&&enemy.combatTier==='boss').length===1,'적 중복/지휘관');
  const extraAllies=stage.extraAllies.map(unit=>{
   const templateId='act6_extra_'+unit.template,base=templates[templateId];
   assert(base?.extra&&/^[a-z][a-z0-9_]*$/.test(unit.id)&&(!HERO_DATA[unit.id]||HERO_DATA[unit.id].joinAfterChapter===stage.id&&!owned.includes(unit.id)&&base.name===HERO_DATA[unit.id].name),'동행 배치/첫 등장 합류 날짜');
