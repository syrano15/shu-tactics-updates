  const events=battleEvents(stage,d,ids);
  validateStoryEvents(events,ids,reinforcements.map(wave=>wave.id),stage.terrain);
  assert(stage.weatherStart===undefined||['clear','rain'].includes(stage.weatherStart),'초기 날씨');
  assert(integer(stage.act6EnemyGoldTotal,0,100000000)&&enemies.reduce((sum,enemy)=>sum+enemy.gold,0)===stage.act6EnemyGoldTotal,'전리금 합계');
  return {id:stage.id,contentVersion:1,aliases:[],title:d.title,location:d.location,subtitle:'6막 삼국 쟁패 · '+d.title,act:6,combatProfile:'act2',rosterMode:'story',campaignLayoutVersion:1,lockRequired:true,positionLocked:formation.required.filter(id=>id==='liubei'),...structuredClone(formation),act6SuggestedSortie:[...stage.act6SuggestedSortie],terrain:[...stage.terrain],allyPositions:structuredClone(stage.allySlots),enemies,extraAllies,battleEventsVersion:1,...(reinforcements.length?{reinforcements}:{}),...(stage.weatherStart?{weatherStart:stage.weatherStart}:{}),...(stage.act6Tactics?{act6Tactics:structuredClone(stage.act6Tactics)}:{}),objective,defeat,brief:stage.brief,intermissionHint:stage.intermissionHint,blockedLabel:stage.blockedLabel,blockedKind:stage.blockedKind,bridgeCells:structuredClone(bridges),reward:structuredClone(stage.reward),art:structuredClone(stage.art),act6Objectives:structuredClone(stage.act6Objectives),act6OptionalObjective:structuredClone(stage.act6OptionalObjective),act6EnemyGoldTotal:stage.act6EnemyGoldTotal,era:d.era,actMap:d.actMap??'map_act6',fate:structuredClone(stage.fate??d.fate),bg:structuredClone(d.bg),bgm:structuredClone(d.bgm),victoryFx:structuredClone(d.victoryFx),episodeTitle:dialogue.episodeTitle,events,pre:structuredClone(d.pre),post:structuredClone(d.post),defeatDialogue:structuredClone(d.defeat),speakers:structuredClone(story.speakers),enemyLabel:index===0?'낭중 반란군':index<3?'오군':index<5?'위군':'남만군',campaignLayout:{version:1,width:size.width,height:size.height,enemyTotal:enemies.length,fronts:index===7?'골짜기 화공·북쪽 탈출로':index>=5?'맑은 물길·깊은 숲·남중 샛길':index>=3?'서쪽 나루·동쪽 협력군·도하 전선':'북측 전열·남측 우회·후방 지원',renderer:'terrainTiles'}};
