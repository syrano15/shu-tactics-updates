 const finish=()=>{if(closed)return;closed=true;observer?.disconnect();orderEditors.delete(host);if(dialog.open)dialog.close();dialog.remove();restoreFocus();};
 const paint=message=>{
  const top=list.scrollTop;
  list.innerHTML=draft.map((id,index)=>'<li><button type="button" data-deploy-order-pick="'+esc(id)+'" aria-pressed="'+(id===selected)+'" aria-label="'+esc(selected?(names.get(selected)??selected)+' · '+(index+1)+'번 자리로 이동':(index+1)+'번 · '+(names.get(id)??id)+' 선택')+'"><span>'+(index+1)+'</span><b>'+esc(names.get(id)??id)+'</b>'+(id===selected?'<small>선택됨</small>':'')+'</button></li>').join('');
