   if(!isCurrent()){finish();return;}
   try{const changed=applyDeploymentOrder(ui,chapter,army,draft,storage);finish();if(changed)onApply();restoreFocus();}catch(error){status.textContent=error.message;}
   return;
  }
  const id=button.dataset.deployOrderPick;if(!draft.includes(id))return;
  if(!selected){selected=id;paint((names.get(id)??id)+' 선택됨 · 옮길 순서를 누르세요.');dialog.querySelector('[data-deploy-order-pick="'+id+'"]')?.focus({preventScroll:true});}
  else if(selected===id){selected=null;paint('선택을 해제했습니다.');dialog.querySelector('[data-deploy-order-pick="'+id+'"]')?.focus({preventScroll:true});}
  else{const moving=selected,to=draft.indexOf(id);draft=moveDeploymentOrderDraft(draft,moving,to);selected=null;paint((names.get(moving)??moving)+' · '+(to+1)+'번으로 옮겼습니다.');dialog.querySelector('[data-deploy-order-pick="'+moving+'"]')?.focus({preventScroll:true});}
 });
 dialog.addEventListener('keydown',event=>{
  const button=event.target.closest('[data-deploy-order-pick]');if(!button||!['ArrowUp','ArrowDown','Home','End'].includes(event.key))return;
