const esc=value=>String(value??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;');
export const deploymentCoordinate=([x,y])=>String.fromCharCode(65+x)+(y+1);
export const deploymentOrderDraft=(chapter,army,order)=>orderedPreparationIds(deploymentRosterIds(chapter,army),order);
export function moveDeploymentOrderDraft(ids,id,position){
 const next=[...ids],from=next.indexOf(id);
 if(from<0||!Number.isInteger(position)||position<0||position>=next.length)return next;
 next.splice(from,1);next.splice(position,0,id);return next;
}
export function applyDeploymentOrder(ui,chapter,army,draft,storage){
 const current=deploymentOrderDraft(chapter,army,ui.rosterOrder),visible=new Set(current);
 if(!Array.isArray(draft)||draft.length!==current.length||new Set(draft).size!==current.length||draft.some(id=>!visible.has(id)))throw new Error('장수 목록이 바뀌었습니다. 순서 편집을 다시 여세요.');
 if(draft.every((id,index)=>id===current[index]))return false;
 const saved=normalizePreparationOrder(ui.rosterOrder,Object.keys(HERO_DATA)),known=new Set(saved),all=[...saved,...current.filter(id=>!known.has(id))];let index=0;
 const next=all.map(id=>visible.has(id)?draft[index++]:id);
 // One preference write, only on Apply. Hidden officers keep their slots.
 try{(storage??globalThis.localStorage)?.setItem(PREPARATION_ORDER_KEY,JSON.stringify(next));}catch{}
 ui.rosterOrder=next;return true;
}
const orderEditors=new WeakMap();
export function openDeploymentOrderEditor(host,{chapter,army,ui,units,onApply=()=>{},isCurrent=()=>true,storage}={}){
