const seenTurns=new WeakMap(),activeTransitions=new WeakMap();
const turnKey=state=>`${state.round}:${state.phase}`;
export function clearTurnTransition(banner){
 if(!banner)return;
 const active=activeTransitions.get(banner);
 if(active){clearTimeout(active.timer);active.resolve(false);activeTransitions.delete(banner);}
 banner.hidden=true;banner.classList.remove('turn-transition','turn-enemy','turn-ally');
}

// Restored games synchronize silently; newly deployed games call show directly.
export function syncTurnTransition(banner,state){
 clearTurnTransition(banner);if(state&&typeof state==='object')seenTurns.set(state,turnKey(state));
}

export function showTurnTransition(banner,state,scenario,{fast=false,reducedMotion=false}={}){
 if(!banner||!state||state.result||!['ally','enemy'].includes(state.phase)||state.storyEvents?.pending?.length)return Promise.resolve(false);
 const current=turnKey(state);if(seenTurns.get(state)===current)return Promise.resolve(false);
 clearTurnTransition(banner);seenTurns.set(state,current);
 banner.classList.add('turn-transition',state.phase==='enemy'?'turn-enemy':'turn-ally');
 banner.classList.toggle('turn-reduced-motion',!!reducedMotion);
 banner.setAttribute('role','status');banner.setAttribute('aria-live','polite');
 prepareSfx(['attackHit','criticalHit','arrowLaunch','fireCast','heal','levelUp','victory']);
 void playSfx(state.phase==='enemy'?'turnEnemy':'turnAlly');
 banner.textContent=(state.phase==='enemy'?armyLabel(null,scenario):'아군')+' 턴 · '+state.round+'라운드';banner.hidden=false;
 return new Promise(resolve=>{
  const active={resolve,timer:null};activeTransitions.set(banner,active);
  active.timer=setTimeout(()=>{
   if(activeTransitions.get(banner)!==active)return;
   banner.hidden=true;banner.classList.remove('turn-transition','turn-enemy','turn-ally');activeTransitions.delete(banner);resolve(true);
  },fast?900:1200);
 });
}
