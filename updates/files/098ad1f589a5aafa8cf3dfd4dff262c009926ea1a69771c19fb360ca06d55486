   else if(selected.level>=MAX_LEVEL){selectedStatus='max-level';lines.push(selected.name+' · 최대 레벨에 도달하여 경험치가 늘지 않습니다.');}
   else if((record.objectiveSpent?.[selected.id]??0)>=40){selectedStatus='capped';lines.push(selected.name+' · 이 전장의 거점 기여 기본 경험치 한도 40에 도달했습니다.');}
