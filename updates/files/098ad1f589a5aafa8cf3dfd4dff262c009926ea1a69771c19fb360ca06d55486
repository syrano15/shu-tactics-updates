  lines.push('승리의 필수 조건이 아닌 성장 거점입니다.','정규 장수마다 이 거점에 도달한 뒤 행동을 확정하면 기본 기여 경험치 20을 한 번 받습니다. 한 전장 기본 합계는 최대 40입니다.');
 }else{
  lines.push(marker.aria,guide.detail);
  if(guide.checks.length)lines.push(guide.checks.map(check=>(check.met?'완료: ':'필요: ')+check.text).join(' · '));
