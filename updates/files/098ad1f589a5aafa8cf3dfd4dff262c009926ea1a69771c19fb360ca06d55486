 }
 return {x,y,coordinate:marker.coordinate,label:marker.label,purpose:marker.purpose,lines:[...new Set(lines.filter(Boolean))],selectedUnitId:selected?.id??null,selectedStatus};
}

function victorySummary(state){
 const goal=battleObjectiveDisplay(scenarioFor(state),validateObjective(state.objective,objectiveUnits(state),state.terrain));
 const alive=state.units.filter(v=>v.team==='enemy'&&v.hp>0).length;
 const defeat=validateDefeat(state.defeat,state.units).map(v=>unit(state,v.unit).name+' 퇴각');
 let condition,progress;
 if(huarongChaseActive(state)){condition='후위대 추격 완료';progress='남은 적 '+alive+'부대 · 격파 '+state.units.filter(u=>u.team==='enemy'&&u.hp===0&&!u.escaped).length+'부대 · 탈출 '+state.huarongChase.escapes.length+'부대';}
 else if(goal.type==='defeatAll'){condition='적 전멸';progress='남은 적 '+alive+'부대';}
 else if(goal.type==='defeatUnit'){
  const targets=[goal.targetId,...(goal.requiredDefeated??[])].map(id=>unit(state,id));condition=targets.map(u=>u.name).join(' · ')+' 격파';progress=targets.map(u=>u.name+' '+(u.hp<=0?'격파 완료':state.units.some(v=>v.id===u.id)?'병력 '+percent(u.hp/u.maxHp):'후속 등장 대기')).join(' · ');
 }else if(goal.type==='defendTiles'){
  condition=(goal.label??'막사')+' '+goal.rounds+'라운드 방어 · 적 진입 금지';progress='완료 '+(state.completedRounds??0)+'/'+goal.rounds+'라운드';
 }else if(goal.type==='escortUnits'){
  condition=goal.unitIds.map(id=>unit(state,id).name).join(' · ')+' 모두 퇴로 도달 후 행동 확정';progress=goal.unitIds.map(id=>{const u=unit(state,id),at=goal.tiles.some(([x,y])=>u.x===x&&u.y===y);return u.name+' '+(at&&u.done?'행동 확정':at?'도착 · 대기 필요':'이동 중');}).join(' · ');
 }else if(goal.type==='surviveRounds'){
  condition=goal.rounds+'라운드 적 턴까지 생존'+(goal.alsoWinOnDefeatAll?' 또는 적 전멸':'');
  progress='완료 '+(state.completedRounds??0)+'/'+goal.rounds+'라운드 · 남은 적 '+alive+'부대'+(goal.alsoWinOnDefeatAll&&pendingEnemyCount(state)?' · 예정 증원 '+pendingEnemyCount(state)+'부대':'');
 }else if(goal.type==='occupyTiles'){
  condition=(goal.label??'모든 목표')+' '+goal.tiles.map(tile).join('/')+' 동시 점령 · 행동 확정';const count=goal.tiles.filter(([x,y])=>state.units.some(u=>u.team==='ally'&&!u.extra&&u.hp>0&&u.done&&u.x===x&&u.y===y)).length;progress='점령 '+count+'/'+goal.tiles.length+' · 필수 격파 잔여 '+(goal.requiredDefeated??[]).filter(id=>unit(state,id).hp>0).length;
 }else{
  const target=unit(state,goal.unit),at=goal.tiles.some(([x,y])=>target.x===x&&target.y===y);
  condition=target.name+' '+(goal.label?goal.label+' ':'')+goal.tiles.map(tile).join('/')+' 도달 후 행동 확정'+(goal.notBeforeRound?' · '+goal.notBeforeRound+'라운드 이후':'')+(goal.requiredDefeated?.length?' · 필수 적 격파':'');
  progress=(at?(target.done?'도달·행동 확정':'도달 · 대기/공격으로 행동 확정 필요'):'현재 '+tile([target.x,target.y]))+(goal.notBeforeRound&&state.round<goal.notBeforeRound?' · 필요 '+goal.notBeforeRound+'라운드':'')+(goal.requiredDefeated?.length?' · 필수 격파 잔여 '+goal.requiredDefeated.filter(id=>(unit(state,id)?.hp??0)>0).length:'');
 }
 return {condition,progress,defeat:[...defeat,'아군 전멸'].join(' / '),status:state.result??'ongoing'};
}

function meritProgress(state,scenario){
 const remaining=state.units.filter(v=>v.team==='enemy'&&v.hp>0).length;
 switch(scenario.id){
  case 's01_zhuoxian':{
   const ids=['liubei','guanyu','zhangfei'];
   return {met:ids.every(id=>ratio(state,id)>=.5),impossible:ids.some(id=>!unit(state,id)||unit(state,id).hp<=0),progress:ids.map(id=>(unit(state,id)?.name??id)+' '+percent(ratio(state,id))).join(' · ')};
  }
  case 's02_yellow_camp':{
   const defeated=!!death(state,'e_boss');
   return {met:state.round<=4&&defeated,impossible:state.round>4,progress:state.round+'/4라운드 · 두목 '+(defeated?'격파 완료':'생존')};
  }
  case 's03_hulao':{
   const killer=death(state,'e_boss'),boss=unit(state,'e_boss');
   return {met:killer?.actorId==='guanyu',impossible:!!killer&&killer.actorId!=='guanyu'||!killer&&((boss?.hp??0)<=0||(unit(state,'guanyu')?.hp??0)<=0),progress:killer?'화웅 격파자: '+(unit(state,killer.actorId)?.name??killer.actorId):'관우의 마지막 일격 대기'};
  }
  case 's04_beihai':return {met:ratio(state,'x_kongrong')>=.7,impossible:(unit(state,'x_kongrong')?.hp??0)<=0,progress:'공융 병력 '+percent(ratio(state,'x_kongrong'))+' / 필요 70%'};
  case 's05_xuzhou_relief':{
   const complete=state.completedRounds??0,allDefeated=state.units.filter(v=>v.team==='enemy').every(v=>v.hp===0&&!v.escaped&&!v.withdrawn);
   return {met:complete<6&&allDefeated,impossible:complete>=6||state.units.some(v=>v.team==='enemy'&&(v.escaped||v.withdrawn)),progress:'남은 적 '+remaining+'부대 · 생존 완료 '+complete+'/6라운드'};
  }
  case 's06_xuzhou_fall':{
   const hero=unit(state,'liubei'),tiles=scenario.objective?.tiles??state.objective?.tiles??[[0,3],[0,4]],at=hero&&tiles.some(([x,y])=>hero.x===x&&hero.y===y);
   const retreats=Math.max(meritRetreatedIds(state).length,regularMeritAllies(state).filter(v=>v.hp<=0).length);
   return {met:!!hero&&hero.hp>0&&hero.done&&at&&retreats===0,impossible:retreats>0,progress:(regularRewards(state)?'정규 아군 퇴각 ':'아군 퇴각 ')+retreats+' · '+(at?(hero.done?'서문 행동 확정':'서문 도달 · 행동 확정 필요'):'유비 서문 도달 대기')};
  }
  case 's09_baima':{
   const killer=death(state,'e_boss'),within=state.campaignEventsVersion===1?killer?.round<=5:state.round<=5;
   return {met:killer?.actorId==='guanyu'&&within,impossible:!!killer&&(killer.actorId!=='guanyu'||!within)||!killer&&state.round>5,progress:killer?'안량 격파: '+killer.round+'라운드 · 격파자 '+(unit(state,killer.actorId)?.name??killer.actorId):state.round+'/5라운드 · 관우의 마지막 일격 대기'};
  }
  case 's12_xinye':{
   const complete=state.completedRounds??0,safe=['liubei','zhugeliang'].every(id=>ratio(state,id)>=.5),allDefeated=state.objective.alsoWinOnDefeatAll&&remaining===0&&pendingEnemyCount(state)===0;
   return {met:safe&&(complete>=6||allDefeated),impossible:['liubei','zhugeliang'].some(id=>ratio(state,id)===0),progress:'유비 '+percent(ratio(state,'liubei'))+' · 제갈량 '+percent(ratio(state,'zhugeliang'))+' · 방어 '+complete+'/6라운드 · 남은 적 '+remaining+'부대'+(pendingEnemyCount(state)?' · 예정 증원 '+pendingEnemyCount(state)+'부대':'')};
  }
  default:{if(scenario?.act===3){const retreat=regularMeritAllies(state,{excludeExtras:true}).filter(u=>u.hp<=0).length;return {met:meritStatus({...state,result:'victory'},scenario)?.achieved??false,impossible:false,progress:state.round+'라운드 · 정규 아군 퇴각 '+retreat+'명 · 보호 대상의 현재 병력으로 판정'};}return {met:false,impossible:false,progress:''};}
 }
}

function survivalBonusView(state,scenario,army){
