export function battleConditionSummary(state,scenario,{army=null}={}){
 const survivorReward=survivorRewardView(state,scenario,army),survivalBonus=survivalBonusView(state,scenario,army),victory=victorySummary(state),spec=ACT1_MERITS[scenario?.id]??ACT2_MERITS[scenario?.id]??ACT3_MERITS[scenario?.id];
 if(!spec)return {victory,merit:null,survivalBonus,survivorReward};
 const live=meritProgress(state,scenario),settled=!!army?.rewardReceipts?.[scenario.id],award=meritStatus(state,scenario)??spec;
 let status=live.impossible?'impossible':live.met?'ready':'ongoing';
 if(state.result==='victory')status=meritStatus(state,scenario).achieved?'achieved':'missed';
 else if(state.result==='defeat')status='missed';
 const labels={ready:'현재 충족 · 승리 시 확정',ongoing:'진행 중',impossible:'이번 전투 달성 불가',achieved:'달성',missed:'미달성'};
 const rewards=['공적 +1',...(award.gold?[award.gold.toLocaleString('ko-KR')+' 자금']:[]),...spec.items.map(id=>PARTS[id].name),...(scenario.id==='s12_xinye'&&state.campaignEventsVersion===1&&state.result===null?['완전 소탕 시 추가 자금 2,000']:[])];
 return {victory,survivalBonus,survivorReward,merit:{id:spec.id,condition:scenario.id==='s12_xinye'&&!state.objective.alsoWinOnDefeatAll?'6라운드 방어, 유비·제갈량 병력 50% 이상 유지':award.condition,progress:live.progress,status,statusText:scenario?.act===2&&state.result===null?'전투 종료 시 판정':labels[status],reward:rewards.join(' · '),settled,settlementText:settled?'이 전투 보상은 이미 정산됨 · 재지급 없음':''}};
}

