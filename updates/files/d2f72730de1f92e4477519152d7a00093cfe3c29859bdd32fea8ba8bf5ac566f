// The caller owns gesture unlock, epoch cancellation and intro-once playback.
// Querying another line in the same segment never creates another entry key.
// Returning the same bed across segment boundaries does not request a restart.
export function dialogueMusicAt(options={}){
  if(!options||typeof options!=='object'||Array.isArray(options))return null;
  const {chapterId,phase,lineIndex=0}=options;
  if(typeof chapterId!=='string'||!Object.hasOwn(DIALOGUE_MUSIC_CUES,chapterId)||!Number.isInteger(lineIndex)||lineIndex<0)return null;
  const chapter=DIALOGUE_MUSIC_CUES[chapterId];
  if(phase==='defeat'){
    if(lineIndex>=chapter.defeatLength)return null;
    return Object.freeze({bedId:'dialogSad',introId:null,entryKey:chapterId+':defeat:0',segmentStart:0});
  }
  if(phase!=='pre'&&phase!=='post')return null;
  const sequence=chapter[phase];if(lineIndex>=sequence.length)return null;
  let cue=sequence.cues[0];
  for(let i=1;i<sequence.cues.length&&sequence.cues[i].at<=lineIndex;i++)cue=sequence.cues[i];
  return Object.freeze({bedId:cue.bedId,introId:lineIndex===cue.at?cue.introId:null,entryKey:chapterId+':'+phase+':'+cue.at,segmentStart:cue.at});
}
