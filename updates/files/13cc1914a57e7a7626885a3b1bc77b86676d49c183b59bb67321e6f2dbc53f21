:root{color-scheme:dark;--page:#121710;--panel:#1d241b;--line:#414839;--gold:#d6bd80;--text:#f3f0e5;--muted:#b7bba9;font-family:"Malgun Gothic","Apple SD Gothic Neo",sans-serif;background:var(--page);color:var(--text)}
*{box-sizing:border-box}body{margin:0}a{color:inherit}button{font:inherit;cursor:pointer}button:focus-visible,a:focus-visible{outline:3px solid var(--gold);outline-offset:4px}button:disabled{opacity:.4;cursor:default}[hidden]{display:none!important}
.gallery-header{max-width:1440px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px 40px;border-bottom:1px solid var(--line)}.gallery-brand{display:flex;align-items:center;gap:12px;text-decoration:none}.gallery-brand>span{display:grid;place-items:center;width:38px;height:38px;background:#62412f;border:1px solid #a77753;color:#ffe3ba;font-family:serif;font-size:25px}.gallery-brand strong{font-size:18px;letter-spacing:.04em}.return-link{text-decoration:none;color:var(--gold);font-size:14px;white-space:nowrap}
main{max-width:1440px;margin:auto;padding:0 40px 56px}.gallery-intro{max-width:760px;padding:48px 0 24px}.eyebrow{margin:0 0 14px;color:var(--gold);letter-spacing:.15em;font-size:13px}.gallery-intro h1{font-family:"Batang",serif;font-size:clamp(25px,4vw,42px);line-height:1.4;margin:0 0 16px;font-weight:600;letter-spacing:-.035em}.gallery-intro>p:not(.eyebrow){font-size:15px;line-height:1.8;color:var(--muted);margin:8px 0}.gallery-intro .gallery-summary{color:var(--gold)!important;font-size:13px!important}
.gallery-filters{display:flex;flex-wrap:wrap;gap:8px;padding:14px 0 20px;margin-bottom:18px;border-bottom:1px solid var(--line)}.gallery-filters button{background:transparent;color:var(--muted);border:1px solid var(--line);border-radius:4px;padding:10px 14px;font-size:13px}.gallery-filters button:hover{border-color:var(--gold);color:var(--text)}.gallery-filters button[aria-pressed=true]{color:#1b2119;background:var(--gold);border-color:var(--gold);font-weight:700}
.art-section{margin-top:40px}.section-heading{display:flex;align-items:baseline;gap:12px;margin:0 0 14px}.section-heading h2{font-size:21px;margin:0;font-family:"Batang",serif}.section-heading span{font-size:12px;color:var(--gold)}.section-intro{margin:0 0 22px;font-size:13px;line-height:1.75;color:var(--muted)}.character-heading{font-size:16px;font-weight:600;margin:24px 0 13px;color:var(--gold)}.art-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.art-grid.landscape{grid-template-columns:repeat(3,minmax(0,1fr))}.art-card{min-width:0;margin:0;border:1px solid var(--line);background:var(--panel);border-radius:5px;overflow:hidden}.art-card button{display:block;width:100%;padding:0;text-align:left;border:0;background:none;color:var(--text)}.art-card button:hover .art-picture{background-color:#263026}.art-picture{display:flex;align-items:center;justify-content:center;aspect-ratio:4/5;background:#111611;background-image:radial-gradient(ellipse at 50% 55%,#283228 0%,#111611 75%);overflow:hidden;transition:background-color .15s}.art-picture img{display:block;width:100%;height:100%;object-fit:contain}.landscape .art-picture{aspect-ratio:16/9;background:#101410}.ui-art .art-picture{aspect-ratio:16/5;padding:14px}.card-caption{display:block;padding:13px 14px 14px;min-height:72px}.card-label{display:block;font-size:14px;line-height:1.6;font-weight:600}.card-meta{display:block;color:var(--muted);font-size:11px;margin-top:5px;line-height:1.5}.image-error{font-size:12px;color:#e0b9aa;text-align:center;padding:12px}.art-card.image-failed .art-picture img{display:none}.gallery-empty{padding:50px 16px;text-align:center;line-height:1.8;border:1px dashed var(--line);color:var(--muted)}.gallery-footer{max-width:1440px;margin:auto;padding:24px 40px 32px;border-top:1px solid var(--line);color:var(--muted);font-size:12px;display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between}.gallery-footer a{color:var(--gold);text-decoration:none}
.art-detail{border:1px solid #657052;border-radius:7px;background:#141913;color:var(--text);padding:0;width:min(1080px,94vw);max-width:94vw;max-height:94dvh;overflow:auto;box-shadow:0 24px 100px #0009}.art-detail::backdrop{background:#050704e8}.detail-panel{padding:18px}.detail-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.detail-top p{margin:0;font-size:12px;color:var(--muted)}.detail-top button,.detail-navigation button{border:1px solid var(--line);color:var(--text);background:#232c21;padding:9px 13px;border-radius:3px}.detail-canvas{height:min(68dvh,750px);display:flex;align-items:center;justify-content:center;background:#0b100b;background-image:radial-gradient(ellipse,#273026 0%,#0b100b 78%);border:1px solid #323a2c}.detail-canvas img{display:block;max-width:100%;max-height:100%;object-fit:contain}.detail-description{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:16px 0}.detail-description h2{font-size:18px;margin:0 0 6px}.detail-description p{font-size:12px;color:var(--muted);margin:0;line-height:1.6}.detail-description a{color:var(--gold);font-size:12px;white-space:nowrap}.detail-navigation{display:flex;justify-content:space-between;align-items:center;gap:10px}.detail-navigation span{font-size:11px;color:var(--muted)}body.detail-open{overflow:hidden}
@media(max-width:900px){.gallery-header{padding:20px 24px}main{padding:0 24px 40px}.art-grid,.art-grid.landscape{grid-template-columns:repeat(2,minmax(0,1fr))}.gallery-footer{padding:24px}.detail-navigation span{display:none}}
@media(max-width:480px){.gallery-header{padding:17px 16px;gap:10px}.gallery-brand{gap:8px}.gallery-brand strong{font-size:15px}.gallery-brand>span{width:31px;height:31px;font-size:21px}.return-link{font-size:12px}main{padding:0 16px 32px}.gallery-intro{padding:32px 0 14px}.gallery-intro>p:not(.eyebrow){font-size:13px}.gallery-filters{gap:6px;padding:10px 0 16px}.gallery-filters button{font-size:12px;padding:9px 10px}.art-section{margin-top:30px}.art-grid{gap:10px}.art-grid.landscape{grid-template-columns:1fr}.section-heading h2{font-size:19px}.card-caption{padding:10px;min-height:65px}.card-label{font-size:12px}.card-meta{font-size:10px}.character-heading{font-size:15px}.gallery-footer{padding:20px 16px}.detail-panel{padding:12px}.detail-canvas{height:62dvh}.detail-description{align-items:flex-start}.detail-description h2{font-size:16px}.detail-navigation button{font-size:12px;padding:10px}.art-detail{width:96vw;max-width:96vw}.detail-top button{font-size:13px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
/* 전장 그림은 정사각형 원본 비율로 초상과 구분해 비교한다. */
.battle-art-card .art-picture{aspect-ratio:1}
.map-art-card .art-picture{aspect-ratio:6/5;background:#101410}
.detail-canvas.map-art-detail{aspect-ratio:6/5;width:min(100%,81.6dvh);height:auto;max-height:68dvh;margin-inline:auto}
.detail-canvas.map-art-detail img{width:100%;height:100%;object-fit:contain}
@media(max-width:480px){.detail-canvas.map-art-detail{width:min(100%,74.4dvh);max-height:62dvh}}
.battle-art-card .art-picture img{width:100%;height:100%;object-fit:contain}
/* Sheet panels are viewed through metadata; no source pixels are rewritten. */
.crop-picture{position:relative;display:block;overflow:hidden}
.crop-picture img{position:absolute;max-width:none!important;max-height:none!important;object-fit:fill!important}
.detail-viewport{display:flex;align-items:center;justify-content:center;width:100%;height:100%;min-width:0;overflow:hidden}
.detail-viewport img{display:block;max-width:100%;max-height:100%;object-fit:contain}
.crop-detail .detail-viewport{display:block;position:relative;width:min(100%,68dvh,750px);height:auto;max-height:100%}
.map-art-detail .detail-viewport{width:100%;height:100%}
@media(max-width:480px){.crop-detail .detail-viewport{width:min(100%,62dvh)}}
