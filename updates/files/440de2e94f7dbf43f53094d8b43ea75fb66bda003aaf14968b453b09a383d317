export function act2EnemyLimitedWaves(state,chapter,waves){
 if(state?.act2EnemyWaveLimitVersion!==1||!act2EnemyWaveLimitApplies(chapter))return waves;const removed=new Set(state.act2EnemyWaveLimitRemovedIds??[]);
