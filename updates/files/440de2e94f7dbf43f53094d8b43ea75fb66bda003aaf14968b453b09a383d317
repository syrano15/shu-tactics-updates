// Versioned overlay: original formations/waves remain references for old saves.
// Active continuations keep arrived enemies and cancel only future enemy waves.
export const ACT2_ENEMY_WAVE_LIMIT_VERSION=1;
const fail=message=>{throw new Error('2막 적 증원 횟수 기록 오류: '+message);};
