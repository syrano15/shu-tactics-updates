export function act2EnemyLimitedOrders(state,chapter,orders){
 if(state?.act2EnemyWaveLimitVersion!==1||!act2EnemyWaveLimitApplies(chapter))return orders;const removed=new Set(state.act2EnemyWaveLimitRemovedIds??[]);return orders.filter(order=>!removed.has(order.id));
