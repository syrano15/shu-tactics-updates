 const allowed=new Set(act2EnemyWaveReserveIds(chapter)),enemyWaves=rawEnemyWaves(state,chapter),retained=retainedAct2EnemyWave(state,chapter),spawned=(state.reinforcements?.spawned??[]).filter(id=>enemyWaves.some(wave=>wave.id===id)),removedIds=[],cancelledWaveIds=[];
 for(const wave of state.reinforcements?.pending??[]){if(!wave.units.some(unit=>unit.team==='enemy')||!spawned.length&&wave.id===retained?.id)continue;ensure(wave.units.every(unit=>unit.team==='enemy'&&allowed.has(unit.id)),'이행 대상 대기 부대');removedIds.push(...wave.units.map(unit=>unit.id));cancelledWaveIds.push(wave.id);}
