import {effectiveClass,classAptitudes,classChangeReason} from './class-change.js';
import {effectiveSkillDefinition} from './combat-skills.js';
import {legendaryOwnerSkill,LEGENDARY_LEVEL} from './legendary-skills.js';
import {skillDescriptionHTML} from './skill-ui-copy.js';
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const SPECIAL_IDS={guanyu:'guanyu-cleave',zhangfei:'zhangfei-roar',liubei:'liubei-oath',jianyong:'jianyong-relief',zhaoyun:'zhaoyun-breakthrough',zhugeliang:'zhugeliang-fire',weiyan:'weiyan-rampage',zhoucang:'zhoucang-breakguard',pangtong:'pangtong-chain',xushu:'xushu-ambush'};
const STATS=[['병력','maxHp'],['공격','atk'],['방어','def'],['지력','int'],['이동','move']];
export const className=(balance,cls)=>balance.classes[cls].name;
export const unitRange=unit=>`${unit.min}~${maxRange(unit)}${maxRange(unit)===1?' · 직선 인접':''}`;
export function classChangePreview(army,id,cls,balance,chapter){
 const draft=structuredClone(army);draft.heroes[id].selectedClass=cls;
 if(cls!==effectiveClass(army,id))delete draft.heroes[id].specialization;
 const current=createUnit(balance,id,'ally',army),candidate=createUnit(balance,id,'ally',draft);
 return {current,candidate,cls,reason:classChangeReason(army,id,cls,chapter),rows:classAptitudes(id,officerHeroRoleVersion(army,id)),changed:current.cls!==cls};
}
export function classSkills(unit){
