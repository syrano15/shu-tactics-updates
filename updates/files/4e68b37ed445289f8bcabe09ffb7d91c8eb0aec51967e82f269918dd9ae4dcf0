 const skills=ids.map(id=>({id,...effectiveSkillDefinition(unit,id)})),legendary=legendaryOwnerSkill(unit.id);
 if(legendary&&!HERO_DATA[unit.id]?.guest)skills.push({...legendary,...(effectiveSkillDefinition(unit,legendary.id).restriction?{restriction:effectiveSkillDefinition(unit,legendary.id).restriction}:{}),...(unit.level<LEGENDARY_LEVEL?{restriction:'Lv'+LEGENDARY_LEVEL+' 해금 · '+legendary.description}:{}),description:legendary.description+' · 사기 140 · SP '+legendary.spCost+' · 전투당 1회'});
