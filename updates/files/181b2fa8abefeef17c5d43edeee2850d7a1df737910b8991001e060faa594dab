 #shop-scene .prep-top h2{font-size:22px}
 #shop-scene .prep-top small{font-size:14px;line-height:1.4}
 #shop-scene .prep-content,#shop-scene .prep-content.with-roster{flex:0 0 auto;display:flex;flex-direction:column;min-height:0;overflow:visible;padding:12px;gap:14px}
 #shop-scene .prep-main,
 #shop-scene .prep-content[data-page="equipment"] .prep-main,
 #shop-scene .prep-content[data-page="deployment"] .prep-main{flex:0 0 auto;display:block;min-height:0;overflow:visible}
 #shop-scene .prep-roster{flex:none;min-height:0;overflow:visible;margin:0}
 #shop-scene .prep-roster h3{font-size:16px;margin:0 0 6px}
 #shop-scene .prep-roster-track{display:flex;flex-direction:row;gap:8px;overflow-x:auto;overflow-y:hidden;padding:4px 4px 8px;scroll-snap-type:x proximity}
 #shop-scene .prep-roster-track>.prep-roster-card{flex:0 0 202px;min-height:0;padding:8px}
 #shop-scene .prep-roster-track>.prep-roster-card>[data-prep-hero]{min-height:68px;gap:8px}
 #shop-scene .prep-roster-track .prep-avatar{width:38px;height:46px}
 #shop-scene .prep-roster-track small{font-size:14px;line-height:1.45}
 #shop-scene .prep-apply-bar{position:relative;bottom:auto;flex:0 0 auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;min-height:0;margin:12px 12px max(12px,env(safe-area-inset-bottom));padding:12px;gap:10px}
 #shop-scene .prep-apply-bar>div:first-child,#shop-scene .prep-apply-bar>p{grid-column:1/-1;min-width:0;margin:0}
 #shop-scene .prep-apply-bar p,#shop-scene .prep-apply-bar small{font-size:16px;line-height:1.5}
 #shop-scene .prep-apply-bar>.prep-upgrade-total{min-width:0;flex:none}
 #shop-scene .prep-apply-bar>button{width:100%;min-width:0;min-height:48px;padding:10px;font-size:16px}
 #shop-scene .prep-depart.prep-apply-bar>button{grid-column:1/-1}
 #shop-scene .prep-message{padding-inline:12px}
 #shop-scene .prep-sale-list{max-height:none;overflow:visible}
 #shop-scene .prep-stock-ledger{max-height:none}
 #shop-scene .prep-content[data-page="deployment"] .deployment-compact{flex:none;overflow:visible}
}

/* These controls move the visible list, leaving officer choice and plans intact. */
#shop-scene .prep-roster-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid var(--prep-line)}
#shop-scene .prep-roster-toolbar h3{display:block;margin:0;font-size:16px;line-height:1.4;min-width:0}
#shop-scene .prep-roster-toolbar h3 small{display:block;font-size:14px;line-height:1.4}
#shop-scene .prep-roster-controls{display:flex;flex:none;gap:4px}
#shop-scene .prep-roster-controls button{width:48px;min-width:48px;height:48px;min-height:48px;padding:0;font-size:24px;line-height:1}
#shop-scene .prep-roster-vertical{display:none}
@media(min-width:1200px){
 #shop-scene .prep-roster{max-height:calc(100svh - 160px);overflow:auto;scroll-padding-top:68px}
 #shop-scene .prep-roster-toolbar{position:sticky;top:0;z-index:2;padding-top:4px;background:var(--prep-bg)}
 #shop-scene .prep-roster-vertical{display:inline}
 #shop-scene .prep-roster-horizontal{display:none}
}
