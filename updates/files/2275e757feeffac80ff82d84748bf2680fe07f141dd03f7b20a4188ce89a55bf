export function equipmentIcon(id,{locked=false}={}){
 const known=typeof id==='string'&&Object.hasOwn(PARTS,id),advanced=known&&PARTS[id].grade==='advanced';
 const shape=locked?empty:known?glyphs[id]:vacant,kind=locked?'locked':known?id:'empty';
