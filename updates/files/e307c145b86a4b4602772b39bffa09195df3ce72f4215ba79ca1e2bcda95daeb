.campaign-notice{margin:0;width:100vw;height:100vh;max-width:none;max-height:none;border:0;box-sizing:border-box;position:fixed;inset:0;z-index:2200;display:grid;place-items:center;background:#06110dde;backdrop-filter:blur(3px);padding:24px;color:#f5e4bb;text-align:center}.campaign-notice-card{width:min(680px,100%);padding:34px 30px;border:1px solid #d7b574;border-radius:8px;background:linear-gradient(135deg,#192b22,#0a1510);box-shadow:0 0 55px #d7b57420;animation:campaign-notice-enter 180ms ease-out}.campaign-notice-kicker{font-size:12px;letter-spacing:.22em;color:#c7b983}.campaign-notice h2{font-family:'Noto Serif KR',serif;font-size:clamp(28px,4vw,48px);margin:12px 0 14px}.campaign-notice-text{font-size:clamp(16px,2.2vw,22px);line-height:1.6;margin:0 0 14px}.campaign-notice-detail{font-size:13px;color:#b8c1b5;line-height:1.7}.campaign-notice button{margin-top:16px;background:#d7b574;color:#192119;border:1px solid #f4d99d;min-width:160px;padding:12px 28px;border-radius:4px;font-weight:700;cursor:pointer}.campaign-notice.enemy-arrival .campaign-notice-card{border-color:#ed8a75;box-shadow:0 0 55px #ee785f22}.campaign-notice.enemy-arrival h2{color:#ff9279}.campaign-notice.ally-arrival h2{color:#9bddb1}.campaign-notice.act{background:radial-gradient(ellipse,#193a2bea,#020907f5)}.campaign-notice.act .campaign-notice-card{background:transparent;border-width:1px 0;border-radius:0;box-shadow:none}.campaign-notice.act h2{font-size:clamp(44px,8vw,80px);letter-spacing:.14em}.campaign-notice.act .campaign-notice-text{font-size:28px;letter-spacing:.1em}.campaign-notice.reduced-motion .campaign-notice-card{animation:none}@keyframes campaign-notice-enter{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}@media(prefers-reduced-motion:reduce){.campaign-notice-card{animation:none}}

.campaign-notice::backdrop{background:transparent}
