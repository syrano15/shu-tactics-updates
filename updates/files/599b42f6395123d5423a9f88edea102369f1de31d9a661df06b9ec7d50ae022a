 function tick(now){frame=0;if(!raining||disposed||doc.hidden||media.matches)return;if(now-lastDraw>=32){draw(now);lastDraw=now;}frame=win.requestAnimationFrame(tick);}
 function resume(){if(!raining||disposed)return;geometry();if(frame)win.cancelAnimationFrame(frame);frame=0;if(!media.matches&&!doc.hidden)frame=win.requestAnimationFrame(tick);}
 const resized=()=>{if(raining)geometry();},scrolled=()=>{if(raining)geometry();};
 const observer=win.ResizeObserver?new win.ResizeObserver(resized):null;observer?.observe(viewport);observer?.observe(board);
 viewport.addEventListener('scroll',scrolled,{passive:true});win.addEventListener('resize',resized);media.addEventListener('change',resume);doc.addEventListener('visibilitychange',resume);
 return {update({state:next,active=true}){
  if(disposed)return;state=next;const model=weatherVisualModel(next,active);if(!model.rain){clear();return;}
  if(!canvas){canvas=doc.createElement('canvas');canvas.className='weather-rain-layer';canvas.setAttribute('aria-hidden','true');canvas.dataset.weather='rain';viewport.append(canvas);ctx=canvas.getContext('2d');}
  raining=true;viewport.classList.add('weather-rain');resume();
 },clear,destroy(){clear();disposed=true;state=null;observer?.disconnect();viewport.removeEventListener('scroll',scrolled);win.removeEventListener('resize',resized);media.removeEventListener('change',resume);doc.removeEventListener('visibilitychange',resume);}};
}
