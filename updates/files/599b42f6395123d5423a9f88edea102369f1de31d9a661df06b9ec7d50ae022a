// Weather reads the battle state and draws a separate, non-interactive layer.
// No game clock, weather roll, HP, SP or battle random generator is touched.
const value=(n,k)=>{let x=Math.imul(n+19,374761393)^Math.imul(k+73,668265263);x=Math.imul(x^(x>>>13),1274126177);return ((x^(x>>>16))>>>0)/4294967296;};
export function weatherVisualModel(state,active=true){
 return {rain:active&&state?.weather?.kind==='rain',columns:state?.terrain?.[0]?.length??0,rows:state?.terrain?.length??0};
}
export function installWeatherPresentation(viewport,board=viewport?.querySelector('#board')){
 if(!viewport?.ownerDocument||!board)return {update(){},clear(){},destroy(){}};
