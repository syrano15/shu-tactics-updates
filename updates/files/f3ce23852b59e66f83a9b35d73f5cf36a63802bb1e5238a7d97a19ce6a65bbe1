const BASIC={name:'일반 책사',firePower:1,areaPower:1,controlChance:0,description:'지력에 비례하는 화공과 혼란·위보를 사용합니다.'};
export function casterProfile(actor,state=null){
 const identity=zhugeliangIdentity(actor)?'zhugeliang':guestHeroIdentity(actor)??actor?.id;
 const baseProfile=actor?.cls==='strategist'&&actor?.team==='ally'?(PROFILES[identity]??BASIC):BASIC;
 const profile=zhugeliangTacticProfile(actor,baseProfile);
 const specialization=actor?.cls==='strategist'?specializationFor(actor):null,role=specializationRole(actor);
 const support={supplySPCost:Math.max(12,Math.round((profile.supplySPCost??20)*role.supplySPMultiplier)),supplyMultiplier:(profile.supplyMultiplier??1)*role.healingPower,supplySP:profile.supplySP??15,supportCleanse:role.supportCleanse};
 const description=[profile.description,tacticFireMultiplier(actor,state)>1?'책사 화공 강화 · 단일 위력 ×1.35 · 범위·화공 필살기 위력 ×1.25 · 양군 공통.':''].filter(Boolean).join(' ');
 return {...profile,...support,description,specialization:specialization?.name??'',note:[description,specialization?.firePower?'공격 책사 · 화공 위력 +12%.':'',role.healingPower>1?'회복 책사 · 회복량 +'+Math.round((role.healingPower-1)*100)+'% · 실제 보급 SP'+support.supplySPCost+(role.supportCleanse?' · 회복 시 혼란·위보 정화':''):'',role.firePower>1?'정예 공격 책사 · 화공 추가 +10%.':''].filter(Boolean).join(' ')};
}
export const tacticIntFactor=actor=>Math.max(.5,(actor?.int??85)/85);
export const WATER_TACTIC=Object.freeze({id:'water',name:'수계',range:[2,4],power:.6,description:'첫 승급을 마친 아군 책사 · 비 오는 동안 사용 · 거리 2~4 적 1부대 · 기본 화공 피해의 60%에 지력 적용 · SP 소모 없음 · 반격 없음 · 행동 종료'});
// Water is a separate normal tactic, so fire terrain/profile bonuses do not apply.
export const waterTacticDamage=(baseDamage,actor,target)=>Math.max(1,Math.round(baseDamage*WATER_TACTIC.power*tacticIntFactor(actor)*spiritTacticPower(actor)*spiritDamageGuard(target,'tactic')));
export function tacticAccuracyBonus(actor,kind){
 const profile=casterProfile(actor),spec=specializationFor(actor);
 const control=kind!=='fire'?(profile.controlChance+(spec?.controlChance??0)):0;
 // Existing trait calculation already includes Wisdom. Chant and Wisdom never stack.
 return (profile.tacticChance??0)+control+Math.max(0,spiritTacticBonus(actor)-(actor?.spirits?.wisdom?20:0));
}
// The same unrounded final chance is used by preview and the single attack roll.
// Equipment and weapon-training bonuses share the captured tacticBonus field.
export function tacticChanceBreakdown(config,actor,target,{forestBonus=0,traitAndSpiritBonus=0,profileBonus=0,blocked=false,guaranteed=false}={}){
 const intellectBonus=(actor.int-target.int)*.5,equipmentAndTrainingBonus=actor.tacticBonus??0;
 const raw=config.baseChance+intellectBonus+forestBonus+traitAndSpiritBonus+equipmentAndTrainingBonus+profileBonus;
 const chance=blocked?0:guaranteed?1:Math.max(config.minChance,Math.min(config.maxChance,raw))/100;
 return {base:config.baseChance,intellectBonus,forestBonus,traitAndSpiritBonus,profileBonus,equipmentAndTrainingBonus,min:config.minChance,cap:config.maxChance,raw,chance,capped:!blocked&&!guaranteed&&raw>=config.maxChance,blocked,guaranteed};
}
export function tacticDamage(baseDamage,actor,target,power=1,area=false,state=null,fireArea=area){
 const profile=casterProfile(actor),spec=specializationFor(actor);
 const role=profile.firePower*(area?profile.areaPower:1);
 return Math.max(1,Math.round(baseDamage*tacticIntFactor(actor)*role*(spec?.firePower??1)*specializationRole(actor).firePower*power*spiritTacticPower(actor)*spiritDamageGuard(target,'tactic')*tacticFireMultiplier(actor,state,fireArea)));
}
