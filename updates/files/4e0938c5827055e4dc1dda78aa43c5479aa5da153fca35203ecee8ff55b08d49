      catalog[id]={...track,url:new URL(track.src,baseURL).href,gain:Number.isFinite(track.gain)?clamp(track.gain):1,loop:track.loop!==false};
    }
  }
  const slots=[],suspended=new Set(),failedTracks=new Set();
  let desired=null,current=null,unlocked=false,destroyed=false,generation=0,restartDesired=false,reloadDesired=false,gestureRetryUsed=false,failures=0;
  const duration=Number.isFinite(fadeMs)?Math.max(0,Math.min(1500,fadeMs)):300;
  const persist=()=>{try{storage?.setItem(BGM_SETTINGS_KEY,JSON.stringify(settings));}catch{}};
  const allowed=()=>!destroyed&&unlocked&&settings.enabled&&settings.volume>0&&!hidden()&&suspended.size===0;
  const setLevel=(slot,value)=>{try{slot.audio.volume=clamp(value);}catch{}};
  const clearFade=slot=>{if(slot.timer!==null)clearTimer(slot.timer);slot.timer=null;slot.fadeToken++;};
