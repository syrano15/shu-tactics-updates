  }
  function reconcile(){
    if(destroyed)return Promise.resolve(false);
    if(!desired){const previous=current;current=null;for(const slot of slots)if(slot===previous||slot.state==='playing'||slot.state==='pending')fadeOut(slot);return Promise.resolve(false);}
    if(!allowed()){pauseAll();return Promise.resolve(false);}
    if(failedTracks.has(desired))return Promise.resolve(false);
    if(current?.id===desired&&!restartDesired&&!reloadDesired){
      if(current.state==='pending')return current.pending??Promise.resolve(false);
      if(current.state==='ended')return Promise.resolve(false);
      if(current.state==='playing'&&current.audio.paused!==true)return Promise.resolve(true);
    }
    const previous=current;
    let next=slots.find(slot=>slot.id===desired)??slots.find(slot=>slot!==previous&&slot.state!=='playing')??(slots.length<2?makeSlot():slots.find(slot=>slot!==previous));
    if(!next){failedTracks.add(desired);return Promise.resolve(false);}
    if(previous&&previous!==next)fadeOut(previous);
    clearFade(next);current=next;
    try{
      const track=catalog[desired],changed=next.id!==desired;
      if(changed||reloadDesired){pause(next);next.id=desired;next.audio.loop=track.loop;next.audio.src=track.url;next.audio.load?.();reloadDesired=false;}
      if(restartDesired||next.ended){try{next.audio.currentTime=0;}catch{}next.ended=false;}
      restartDesired=false;return start(next);
    }catch(error){fail(next,next.token,error);return Promise.resolve(false);}
  }
  const setScene=scene=>{
    const next=Object.hasOwn(catalog,scene)?scene:null;
    if(destroyed||next===desired)return status();
    desired=next;restartDesired=!!next;reloadDesired=!!next&&failedTracks.has(next);if(next)failedTracks.delete(next);gestureRetryUsed=false;generation++;void reconcile();return status();
  };
  const unlock=()=>{if(destroyed)return Promise.resolve(false);unlocked=true;if(!desired)return Promise.resolve(false);
    // A transient load error gets one gesture retry per scene. Renders and
    // subsequent clicks cannot turn a missing file into a request storm.
    if(desired&&failedTracks.has(desired)&&!gestureRetryUsed){gestureRetryUsed=true;failedTracks.delete(desired);reloadDesired=true;restartDesired=true;generation++;}
    return reconcile();};
  const setEnabled=enabled=>{if(destroyed)return status();const next=!!enabled;if(next===settings.enabled)return status();settings.enabled=next;generation++;if(settings.enabled){reloadDesired=!!desired&&failedTracks.has(desired);if(reloadDesired)restartDesired=true;failedTracks.clear();gestureRetryUsed=false;}else pauseAll();persist();void reconcile();return status();};
  const setVolume=volume=>{if(destroyed)return status();if(Number.isFinite(volume))settings.volume=clamp(volume);if(settings.volume===0){generation++;pauseAll();}else if(current?.state==='playing')fade(current,catalog[current.id].gain*settings.volume);else void reconcile();persist();return status();};
  const setSuspended=(reason,value)=>{if(destroyed)return;const before=suspended.has(reason);if(value)suspended.add(reason);else suspended.delete(reason);if(before===!!value)return;generation++;if(value)pauseAll();else void reconcile();};
  function status(){return {...settings,unlocked,desired,current:current?.id??null,playing:slots.filter(slot=>slot.state==='playing'&&slot.audio.paused!==true).length,pending:slots.filter(slot=>slot.state==='pending').length,elements:slots.length,failures,suspended:suspended.size>0||hidden(),failedTracks:[...failedTracks]};}
  const destroy=()=>{if(destroyed)return;generation++;destroyed=true;pauseAll();desired=null;for(const slot of slots){slot.audio.removeEventListener?.('error',slot.error);slot.audio.removeEventListener?.('ended',slot.end);try{slot.audio.removeAttribute?.('src');slot.audio.load?.();}catch{}}};
  return Object.freeze({setScene,unlock,setEnabled,setVolume,setSuspended,status,destroy});
}

let storage=null;try{storage=globalThis.localStorage??null;}catch{}
const music=createBgmManager({storage});
export const setBgmScene=scene=>music.setScene(scene);
export const bgmStatus=()=>music.status();
export function installBgmControls({toggle,volume,value,doc=globalThis.document,win=globalThis.window,manager=music}={}){
  if(!doc)return ()=>{};
  const update=()=>{const settings=manager.status();if(toggle){toggle.textContent='배경음악 · '+(settings.enabled?'켬':'끔');toggle.setAttribute('aria-pressed',String(settings.enabled));}if(volume)volume.value=String(Math.round(settings.volume*100));if(value)value.textContent=Math.round(settings.volume*100)+'%';};
  const unlock=()=>{void manager.unlock();},keydown=event=>{if(!event.repeat)unlock();},visibility=()=>manager.setSuspended('visibility',doc.hidden===true),pagehide=()=>manager.setSuspended('page',true),pageshow=()=>{manager.setSuspended('page',false);visibility();};
  const click=()=>{manager.setEnabled(!manager.status().enabled);update();},input=()=>{manager.setVolume(Number(volume.value)/100);update();};
  doc.addEventListener?.('pointerdown',unlock,{capture:true});doc.addEventListener?.('keydown',keydown,{capture:true});doc.addEventListener?.('visibilitychange',visibility);win?.addEventListener?.('pagehide',pagehide);win?.addEventListener?.('pageshow',pageshow);toggle?.addEventListener?.('click',click);volume?.addEventListener?.('input',input);visibility();update();
  return ()=>{doc.removeEventListener?.('pointerdown',unlock,{capture:true});doc.removeEventListener?.('keydown',keydown,{capture:true});doc.removeEventListener?.('visibilitychange',visibility);win?.removeEventListener?.('pagehide',pagehide);win?.removeEventListener?.('pageshow',pageshow);toggle?.removeEventListener?.('click',click);volume?.removeEventListener?.('input',input);};
}
