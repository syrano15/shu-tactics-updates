// Background music is presentation only. It never reads a game save or changes
// battle state. Two reusable streaming media elements are the complete pool.
export const BGM_TRACKS=Object.freeze({
  battle:Object.freeze({src:'./audio/bgm-v0725/battle-chariots.mp3',duration:29.538,loop:true,gain:1}),
  defeat:Object.freeze({src:'./audio/bgm-v0725/defeat-hopeless.mp3',duration:16,loop:true,gain:1}),
});
export const BGM_SETTINGS_KEY='shu-bgm-v1';
const clamp=value=>Math.max(0,Math.min(1,value));
const object=value=>value!==null&&typeof value==='object'&&!Array.isArray(value);
export function bgmSettings(raw){
  let value=raw;try{if(typeof raw==='string')value=JSON.parse(raw);}catch{value=null;}
  return {enabled:object(value)&&typeof value.enabled==='boolean'?value.enabled:true,volume:object(value)&&Number.isFinite(value.volume)?clamp(value.volume):.35};
}

export function createBgmManager({tracks=BGM_TRACKS,createAudio=()=>new globalThis.Audio(),storage=null,hidden=()=>globalThis.document?.hidden===true,baseURL=import.meta.url,now=()=>globalThis.performance?.now?.()??Date.now(),setTimer=(fn,ms)=>setTimeout(fn,ms),clearTimer=id=>clearTimeout(id),fadeMs=300,onplay=()=>{}}={}){
