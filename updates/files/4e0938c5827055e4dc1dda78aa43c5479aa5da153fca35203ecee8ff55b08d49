  const pauseAll=()=>{for(const slot of slots)pause(slot);current=null;};
  function fade(slot,target,complete){
    clearFade(slot);const token=slot.fadeToken,start=Number.isFinite(slot.audio.volume)?slot.audio.volume:0,at=now();
    if(duration===0||Math.abs(start-target)<.001){setLevel(slot,target);complete?.();return;}
    const tick=()=>{slot.timer=null;if(destroyed||slot.fadeToken!==token)return;const progress=Math.max(0,Math.min(1,(now()-at)/duration));setLevel(slot,start+(target-start)*progress);if(progress>=1)complete?.();else slot.timer=setTimer(tick,32);};
    slot.timer=setTimer(tick,32);
  }
  function fadeOut(slot){
    if(slot.state!=='playing'){pause(slot);return;}
    slot.token++;slot.pending=null;fade(slot,0,()=>pause(slot));
  }
  function fail(slot,token,error){
    if(slot.token!==token)return false;
    failures++;if(error?.name==='NotAllowedError')unlocked=false;else if(slot.id)failedTracks.add(slot.id);
    pause(slot);if(current===slot)current=null;return false;
  }
  function makeSlot(){
