.class-change-panel{margin:16px 0;padding:18px;border:1px solid #8b784a;border-radius:10px;background:linear-gradient(135deg,#1a2529,#141e20);color:#f6f0dc}.class-change-heading{display:flex;justify-content:space-between;gap:12px;align-items:center}.class-change-heading h4,.class-preview h4{margin:5px 0 10px}.class-free{padding:5px 10px;border:1px solid #806f42;border-radius:20px;color:#ebd390;white-space:nowrap}.class-change-panel p{line-height:1.6}.class-choices{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin:14px 0}.class-choices button{display:flex;flex-direction:column;gap:5px;align-items:center;padding:11px 3px;min-width:0;background:#1d2a2d;border:1px solid #536367;color:#f6f0dc}.class-choices small{min-height:1.2em;font-size:11px;color:#cfc6a1}.class-choices button.class-preview-selected{border:2px solid #eac774;background:#334441;padding:10px 2px}.class-current b::after{content:' ●';color:#d7bc77}.aptitude{font-size:12px}.grade-S{color:#ffdd85}.grade-A{color:#c8df9c}.grade-C,.grade-D{color:#f0a389}.class-preview{padding:12px;border:1px solid #536367;border-radius:7px;background:#10191b}.class-preview dl{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:10px 0}.class-preview dl>div{padding:7px 8px;background:#1d2a2d;min-width:0}.class-preview dt{font-size:12px;color:#c8c5b8}.class-preview dd{margin:4px 0 0;font-size:14px;overflow-wrap:anywhere}.stat-up{color:#c5e49b}.stat-down{color:#f2a08b}.class-warning,.skill-restricted{color:#f2ab94}.class-skill-preview{margin:12px 0 2px;padding-top:10px;border-top:1px solid #526064}.class-skill-preview p{margin:5px 0;font-size:13px}.class-help{font-size:12px;color:#cbc6b7;margin-bottom:0}.class-change-panel>.primary{margin-top:12px}.class-choices button:disabled{opacity:.55}@media(max-width:620px){.class-change-panel{padding:12px}.class-choices{grid-template-columns:repeat(3,minmax(0,1fr))}.class-preview dl{grid-template-columns:repeat(2,minmax(0,1fr))}.class-change-heading{align-items:flex-start}.class-free{font-size:12px}.class-change-panel>.primary{width:100%}}

.specialization-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:14px 0}.specialization-choices button{min-width:0;padding:14px;text-align:left;display:flex;flex-direction:column;gap:7px;background:#1d2a2d;border:1px solid #536367;color:#f6f0dc}.specialization-choices small{line-height:1.6;color:#cfc6a1}.specialization-choices .class-preview-selected{border:2px solid #eac774;background:#334441;padding:13px}.caster-profile,.tactic-details{color:#d7c395;font-size:12px;line-height:1.6}.cell.tactic-splash{box-shadow:inset 0 0 0 3px #df945c!important;background-color:#ba582b55}.unit-ui.target-preview .skill-prediction{max-height:min(45vh,380px);overflow:auto}.specialization-panel .class-preview dd{overflow-wrap:anywhere}@media(max-width:620px){.specialization-choices{grid-template-columns:1fr}.specialization-panel>.primary{width:100%}}
